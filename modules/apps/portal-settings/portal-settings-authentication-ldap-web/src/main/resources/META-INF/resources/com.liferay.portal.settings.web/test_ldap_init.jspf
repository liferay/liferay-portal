--%>

<%
LDAPTestDisplayContext ldapTestDisplayContext = new LDAPTestDisplayContext(request);

if (!ldapTestDisplayContext.isValidBaseProviderURL()) {
%>

	<liferay-ui:message arguments='<%= new Object[] {HtmlUtil.escape(ldapTestDisplayContext.getBaseProviderURL()), "ldaps://"} %>' key="the-base-provider-url-x-must-use-the-x-scheme-in-fips-mode" translateArguments="<%= false %>" />

<%
	return;
}
%>