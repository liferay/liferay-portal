<liferay-ui:error exception="<%= LDAPConfigurationModelListenerException.class %>">

	<%
	LDAPConfigurationModelListenerException ldapConfigurationModelListenerException = (LDAPConfigurationModelListenerException)errorException;
	%>

	<liferay-ui:message arguments="<%= TransformUtil.transform(ldapConfigurationModelListenerException.getMessageArguments(), messageArgument -> HtmlUtil.escape(GetterUtil.getString(messageArgument)), String.class) %>" key="<%= ldapConfigurationModelListenerException.getMessageKey() %>" translateArguments="<%= false %>" />
</liferay-ui:error>