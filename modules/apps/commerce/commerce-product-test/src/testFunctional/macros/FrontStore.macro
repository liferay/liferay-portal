definition {

	@summary = "Default summary"
	macro addInitializerProductToCart(orderType = null, productQuantity = null, allowedQuantities = null, productName = null) {
		var newItemCount = FrontStore.getCurrentCartItemCount(productName = ${productName});

		Refresh();

		if (isSet(allowedQuantities)) {
			Select(
				key_productName = ${productName},
				locator1 = "CommerceAccelerators#PRODUCT_CARD_QUANTITY_SELECTOR_SELECT_FIELD",
				value1 = ${allowedQuantities});
		}
		else {
			Type(
				key_productName = ${productName},
				locator1 = "CommerceAccelerators#PRODUCT_CARD_QUANTITY_SELECTOR_INPUT_FIELD",
				value1 = ${productQuantity});
		}

		Click(
			key_productName = ${productName},
			locator1 = "CommerceAccelerators#ADD_TO_CART_BUTTON");

		if (isSet(orderType)) {
			Select(
				locator1 = "Select#TYPE",
				value1 = ${orderType});

			Button.click(button = "Add Order");
		}

		WaitForElementPresent(
			key_itemCount = ${newItemCount},
			locator1 = "CommerceAccelerators#MINI_CART_BUTTON_DATA_BADGE_COUNT");
	}

	@summary = "Default summary"
	macro addInitializerProductToCartFromProductDetails(productQuantity = null, uomName = null, productName = null) {
		var newItemCount = FrontStore.getCurrentCartItemCount(productName = ${productName});

		Refresh();

		if (isSet(uomName)) {
			Select(
				locator1 = "CommerceFrontStore#FS_PRODUCT_UOM_SELECT",
				value1 = ${uomName});
		}

		Type(
			locator1 = "CommerceAccelerators#PRODUCT_DETAILS_QUANTITY_SELECTOR_INPUT_FIELD",
			value1 = ${productQuantity});

		Click(locator1 = "CommerceAccelerators#ADD_TO_CART_BUTTON_PRODUCT_DETAILS_PAGE");

		WaitForElementPresent(
			key_itemCount = ${newItemCount},
			locator1 = "CommerceAccelerators#MINI_CART_BUTTON_DATA_BADGE_COUNT");
	}

	@summary = "Default summary"
	macro addToCartFromProductDetails(date = null, multipleSelectionValuesChecked = null, numeric = null, productName = null, productSku = null, boolean = null, optionNamesAndValues = null, multipleSelectionValuesNotChecked = null, text = null, singleSelectionValueChecked = null) {
		var newItemCount = FrontStore.getCurrentCartItemCount(productName = ${productName});

		Refresh();

		if (isSet(optionNamesAndValues)) {
			for (var optionNameAndValue : list ${optionNamesAndValues}) {
				var optionName = StringUtil.extractFirst(${optionNameAndValue}, ":");
				var optionValue = StringUtil.extractLast(${optionNameAndValue}, ":");

				FrontStore.selectAssociatedFSOptionsValue(
					fsOptionName = ${optionName},
					fsOptionValue = ${optionValue});
			}
		}

		WaitForElementPresent(
			key_productSku = ${productSku},
			locator1 = "CommerceFrontStore#FS_PRODUCT_SKU");

		FrontStore.setAssociatedFSOptionsValue(
			boolean = ${boolean},
			date = ${date},
			multipleSelectionValuesChecked = ${multipleSelectionValuesChecked},
			multipleSelectionValuesNotChecked = ${multipleSelectionValuesNotChecked},
			numeric = ${numeric},
			singleSelectionValueChecked = ${singleSelectionValueChecked},
			text = ${text});

		Click(locator1 = "CommerceAccelerators#ADD_TO_CART_BUTTON_PRODUCT_DETAILS_PAGE");

		WaitForElementPresent(
			key_itemCount = ${newItemCount},
			locator1 = "CommerceAccelerators#MINI_CART_BUTTON_DATA_BADGE_COUNT");
	}

	@summary = "Default summary"
	macro addToCartProductWithInvalidQuantityValue(productQuantity = null, productName = null) {
		var currentCartItemCount = FrontStore.getCurrentCartDataBadgeCount();

		Type(
			key_productName = ${productName},
			locator1 = "CommerceAccelerators#PRODUCT_CARD_QUANTITY_SELECTOR_INPUT_FIELD",
			value1 = ${productQuantity});

		Click(
			key_productName = ${productName},
			locator1 = "CommerceAccelerators#ADD_TO_CART_BUTTON");

		AssertElementPresent(
			key_productName = ${productName},
			locator1 = "CommerceAccelerators#ADD_TO_CART_BUTTON_INVALID");

		AssertElementPresent(
			key_itemCount = ${currentCartItemCount},
			locator1 = "CommerceAccelerators#MINI_CART_BUTTON_DATA_BADGE_COUNT");
	}

	@summary = "Default summary"
	macro applyCouponCode(errorMessage = null, discountCouponCode = null) {
		AssertElementPresent(locator1 = "TextInput#DISCOUNT");

		Type(
			locator1 = "TextInput#DISCOUNT",
			value1 = ${discountCouponCode});

		Click(
			key_tab = "Apply",
			locator1 = "Button#TAB_SUBMIT_BTN");

		if (isSet(errorMessage)) {
			Alert.viewErrorMessage(errorMessage = ${errorMessage});
		}
		else {
			AssertElementPresent(
				key_couponCode = ${discountCouponCode},
				locator1 = "CommerceFrontStore#COUPON_CODE_BODY");
		}
	}

	@summary = "Default summary"
	macro assertMiniCartItemAllowedQuantities(allowedQuantities = null, cartItemSku = null) {
		for (var number : list ${allowedQuantities}) {
			AssertElementPresent(
				key_cartItemSku = ${cartItemSku},
				key_optionValue = ${number},
				locator1 = "CommerceAccelerators#MINI_CART_ITEM_QUANTITY_SELECTOR_SELECT_FIELD_OPTION_VALUE");
		}
	}

	@summary = "Default summary"
	macro assertMiniCompareItems(products = null) {
		for (var product : list ${products}) {
			var productImageId = CommerceJSONProductsAPI._getCommerceProductImageIds(productName = ${product});

			AssertElementPresent(
				key_productMediaId = ${productImageId},
				locator1 = "CommerceFrontStore#MINI_COMPARE_ITEM_CUSTOM_IMAGE");
		}
	}

	@summary = "Default summary"
	macro assertProductComparisonTable(products = null) {
		AssertLocation.assertPartialLocation(value1 = "web/minium/compare");

		var columNumber = 1;

		for (var product : list ${products}) {
			var productSpecifications = CommerceJSONProductsAPI._getCommerceProductSpecifications(productName = ${product});
			var productOptions = CommerceJSONProductsAPI._getCommerceProductOptions(productName = ${product});
			var productName = StringUtil.lowerCase(${product});

			var productName = StringUtil.replace(${productName}, " ", "-");

			AssertElementPresent(
				key_productName = ${productName},
				locator1 = "CommerceFrontStore#PRODUCT_CARD_IMAGE");

			for (var productOption : list ${productOptions}) {
				if (${productOption} != "") {
					var productOptionId = CommerceJSONProductsAPI._getCommerceProductOptionId(
						productName = ${product},
						productOptionName = ${productOption});

					var productOptionValues = CommerceJSONProductsAPI._getCommerceProductOptionValues(productOptionId = ${productOptionId});

					var productOptionValues = StringUtil.replace(${productOptionValues}, ",", ", ");

					AssertElementPresent(
						key_columnNumber = ${columNumber},
						key_specification = ${productOption},
						key_value = ${productOptionValues},
						locator1 = "CommerceFrontStore#PRODUCT_COMPARISON_TABLE_SPECIFICATION");
				}
			}

			for (var productSpecification : list ${productSpecifications}) {
				var key_specification = StringUtil.extractFirst(${productSpecification}, ":");
				var key_value = StringUtil.extractLast(${productSpecification}, ":");

				var key_value = StringUtil.replace(${key_value}, "&comma;", ",");

				AssertElementPresent(
					key_columnNumber = ${columNumber},
					key_specification = ${key_specification},
					key_value = ${key_value},
					locator1 = "CommerceFrontStore#PRODUCT_COMPARISON_TABLE_SPECIFICATION");
			}

			var columNumber = ${columNumber} + 1;
		}
	}

	@summary = "Default summary"
	macro assertProductDetails(productAvailability = null, productMPN = null, sampleFileName = null, deliverySubscriptionPeriod = null, productName = null, productGTIN = null, discountPercentage = null, productSKU = null, minQuantity = null, productNetPrice = null, groupedProductEntryNames = null, productStockQuantity = null, paymentSubscriptionPeriod = null, productSpecifications = null, endOfLifeDate = null, productListPrice = null, productSalePriceInactive = null, productSalePrice = null, productImages = null, productShortDescription = null, productListPriceInactive = null, productFullDescription = null) {
		if (isSet(productName)) {
			AssertElementPresent(
				locator1 = "CommerceFrontStore#FS_PRODUCT_NAME",
				value1 = ${productName});
		}

		if (isSet(productStockQuantity)) {
			AssertElementPresent(
				locator1 = "CommerceFrontStore#FS_PRODUCT_STOCK_QUANTITY",
				value1 = ${productStockQuantity});
		}

		if (isSet(productAvailability)) {
			if (${productAvailability} == "Discontinued") {
				AssertElementPresent(locator1 = "CommerceFrontStore#FS_PRODUCT_AVAILABILITY_DISCONTINUED");
			}
			else {
				AssertElementPresent(
					key_availability = ${productAvailability},
					locator1 = "CommerceFrontStore#FS_PRODUCT_AVAILABILITY");
			}
		}

		if (isSet(endOfLifeDate)) {
			AssertElementPresent(
				key_detail = "End of Life",
				locator1 = "CommerceFrontStore#FS_PRODUCT_DETAIL",
				value1 = ${endOfLifeDate});
		}

		if (isSet(productSKU)) {
			AssertElementPresent(
				key_detail = "SKU:",
				locator1 = "CommerceFrontStore#FS_PRODUCT_DETAIL",
				value1 = ${productSKU});
		}

		if (isSet(productMPN)) {
			AssertElementPresent(
				key_detail = "MPN:",
				locator1 = "CommerceFrontStore#FS_PRODUCT_DETAIL",
				value1 = ${productMPN});
		}

		if (isSet(productGTIN)) {
			AssertElementPresent(
				key_detail = "GTIN:",
				locator1 = "CommerceFrontStore#FS_PRODUCT_DETAIL",
				value1 = ${productGTIN});
		}

		if (isSet(productShortDescription)) {
			AssertElementPresent(
				locator1 = "CommerceFrontStore#FS_PRODUCT_DESCRIPTION",
				value1 = ${productShortDescription});
		}

		if (isSet(paymentSubscriptionPeriod)) {
			AssertTextEquals.assertPartialText(
				key_subscriptionName = "Payment",
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_SUBSCRIPTION_INFO",
				value1 = ${paymentSubscriptionPeriod});
		}

		if (isSet(deliverySubscriptionPeriod)) {
			AssertTextEquals.assertPartialText(
				key_subscriptionName = "Delivery",
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_SUBSCRIPTION_INFO",
				value1 = ${deliverySubscriptionPeriod});
		}

		if (isSet(productListPrice)) {
			AssertElementPresent(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_LIST_PRICE",
				value1 = ${productListPrice});
		}
		else if (isSet(productListPriceInactive)) {
			AssertElementPresent(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_LIST_PRICE_INACTIVE",
				value1 = ${productListPriceInactive});
		}

		if (isSet(productSalePrice)) {
			AssertElementPresent(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_LIST_PRICE_PROMO",
				value1 = ${productSalePrice});
		}
		else if (isSet(productSalePriceInactive)) {
			AssertElementPresent(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_PROMO_PRICE_INACTIVE",
				value1 = ${productSalePriceInactive});
		}

		if (isSet(discountPercentage) && isSet(productNetPrice)) {
			AssertTextEquals.assertPartialText(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_DISCOUNT",
				value1 = ${discountPercentage});

			AssertTextEquals.assertPartialText(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_NET_PRICE",
				value1 = ${productNetPrice});
		}

		if (isSet(minQuantity)) {
			AssertElementPresent(
				key_minQuantity = ${minQuantity},
				locator1 = "CommerceFrontStore#PRODUCT_DETAILS_MIN_QUANTITY_PER_ORDER");
		}

		if (isSet(groupedProductEntryNames)) {
			FrontStore.viewGroupedProductEntries(productNames = ${groupedProductEntryNames});
		}

		if (isSet(sampleFileName)) {
			AssertElementPresent(
				key_sampleFileName = ${sampleFileName},
				locator1 = "CommerceFrontStore#PRODUCT_DETAILS_DOWNLOAD_SAMPLE_FILE_BUTTON");
		}

		if (isSet(productFullDescription)) {
			Click(
				key_text = "Full Description",
				locator1 = "Button#ANY");

			AssertTextEquals.assertPartialText(
				locator1 = "CommerceFrontStore#FS_PRODUCT_FULL_DESCRIPTION",
				value1 = ${productFullDescription});
		}

		if (isSet(productSpecifications)) {
			Click(
				key_text = "Specifications",
				locator1 = "Button#ANY");

			for (var productSpecification : list ${productSpecifications}) {
				var specificationKey = StringUtil.extractFirst(${productSpecification}, ":");
				var specificationValue = StringUtil.extractLast(${productSpecification}, ":");

				AssertTextEquals.assertPartialText(
					key_specification = ${specificationKey},
					locator1 = "CommerceFrontStore#FS_PRODUCT_SPECIFICATIONS",
					value1 = ${specificationValue});
			}
		}

		if (isSet(productImages)) {
			for (var productImage : list ${productImages}) {
				AssertElementPresent(
					key_fsProductImage = ${productImage},
					locator1 = "CommerceFrontStore#FS_PRODUCT_IMAGE");
			}
		}
	}

	@summary = "Default summary"
	macro assertPromoPrice(promoPrice = null, productName = null, basePrice = null) {
		AssertTextEquals.assertPartialText(
			key_productName = ${productName},
			locator1 = "CommerceFrontStore#FS_PRODUCT_VALUE_PROMO_PRICE",
			value1 = ${promoPrice});

		AssertTextEquals.assertPartialText(
			key_productName = ${productName},
			locator1 = "CommerceFrontStore#FS_PRODUCT_VALUE_INACTIVE_PRICE",
			value1 = ${basePrice});
	}

	@summary = "Default summary"
	macro changeQuantityByUsingKeyArrows(quantitySelectorType = null, productSKU = null, productName = null, arrowAction = null) {
		if (${quantitySelectorType} == "Product Card") {
			Click(
				key_productName = ${productName},
				locator1 = "CommerceAccelerators#PRODUCT_CARD_QUANTITY_SELECTOR_INPUT_FIELD");

			KeyPress(
				key_productName = ${productName},
				locator1 = "CommerceAccelerators#PRODUCT_CARD_QUANTITY_SELECTOR_INPUT_FIELD",
				value1 = "\${arrowAction}");

			KeyPress(
				key_productName = ${productName},
				locator1 = "CommerceAccelerators#PRODUCT_CARD_QUANTITY_SELECTOR_INPUT_FIELD",
				value1 = "\TAB");
		}
		else {
			if (${quantitySelectorType} == "Product Details") {
				Click(locator1 = "CommerceAccelerators#PRODUCT_DETAILS_QUANTITY_SELECTOR_INPUT_FIELD");

				KeyPress(
					locator1 = "CommerceAccelerators#PRODUCT_DETAILS_QUANTITY_SELECTOR_INPUT_FIELD",
					value1 = "\${arrowAction}");
			}
			else {
				if (${quantitySelectorType} == "Mini-cart") {
					Click(
						key_cartItemSku = ${productSKU},
						locator1 = "CommerceAccelerators#MINI_CART_ITEM_QUANTITY");

					KeyPress(
						key_cartItemSku = ${productSKU},
						locator1 = "CommerceAccelerators#MINI_CART_ITEM_QUANTITY",
						value1 = "\${arrowAction}");

					KeyPress(
						key_cartItemSku = ${productSKU},
						locator1 = "CommerceAccelerators#MINI_CART_ITEM_QUANTITY",
						value1 = "\TAB");
				}
			}
		}
	}

	@summary = "Default summary"
	macro clickEllipsisItemInMiniCart(uomKey = null, menuItem = null) {
		Click(
			locator1 = "CommerceEntry#BODY_VERTICAL_ELLIPSIS_WITH_UOM",
			uomKey = ${uomKey});

		DropdownMenuItem.click(menuItem = ${menuItem});
	}

	@summary = "Default summary"
	macro compareProducts(products = null, clickCompare = null) {
		var comparisonItems = 0;

		for (var product : list ${products}) {
			if (!(IsElementPresent(key_productName = ${product}, locator1 = "CommerceEntry#PRODUCT_CARD_COMPARE_CHECKBOX"))) {
				CommerceNavigator.searchEntry(entryName = ${product});
			}

			ScrollWebElementIntoView(
				key_productName = ${product},
				locator1 = "CommerceEntry#PRODUCT_CARD_COMPARE_CHECKBOX");

			Check.checkToggleSwitch(
				key_productName = ${product},
				locator1 = "CommerceEntry#PRODUCT_CARD_COMPARE_CHECKBOX");

			var comparisonItems = ${comparisonItems} + 1;

			AssertElementPresent(
				key_value = ${comparisonItems},
				locator1 = "CommerceFrontStore#MINI_COMPARE_ITEM_ACTIVE_N");

			FrontStore.assertMiniCompareItems(products = ${product});
		}

		if (${clickCompare} != "false") {
			Click(locator1 = "CommerceFrontStore#MINI_COMPARE_COMPARE_BUTTON");
		}
	}

	@summary = "This macro edits product options of an order item from the minicart"
	macro editMiniCartItemProductOption(date = null, boolean = null, multipleSelectionValuesChecked = null, cartItemOptionName = null, multipleSelectionValuesNotChecked = null, numeric = null, cartItemOptionValue = null, text = null, singleSelectionValueNotChecked = null, singleSelectionValueChecked = null) {
		Select(
			key_optionName = ${cartItemOptionName},
			locator1 = "CommerceAccelerators#MINI_CART_PRODUCT_OPTIONS_SELECT",
			value1 = ${cartItemOptionValue});

		FrontStore.setAssociatedFSOptionsValue(
			boolean = ${boolean},
			date = ${date},
			multipleSelectionValuesChecked = ${multipleSelectionValuesChecked},
			multipleSelectionValuesNotChecked = ${multipleSelectionValuesNotChecked},
			numeric = ${numeric},
			singleSelectionValueChecked = ${singleSelectionValueChecked},
			text = ${text});

		FrontStore.viewAssociatedFSOptionsValue(
			boolean = ${boolean},
			date = ${date},
			multipleSelectionValuesChecked = ${multipleSelectionValuesChecked},
			multipleSelectionValuesNotChecked = ${multipleSelectionValuesNotChecked},
			numeric = ${numeric},
			singleSelectionValueChecked = ${singleSelectionValueChecked},
			singleSelectionValueNotChecked = ${singleSelectionValueNotChecked},
			text = ${text});

		Button.clickSave();
	}

	@summary = "Default summary"
	macro editUOMAndQuantityInMiniCart(quantity = null, uomKey = null, uomName = null) {
		Click(
			locator1 = "CommerceEntry#BODY_VERTICAL_ELLIPSIS_WITH_UOM",
			uomKey = ${uomKey});

		DropdownMenuItem.click(menuItem = "Edit");

		Select(
			locator1 = "CommerceAccelerators#MINI_CART_EDIT_ITEM_UOM_SELECTOR",
			value1 = ${uomName});

		if (isSet(quantity)) {
			Type(
				locator1 = "CommerceAccelerators#MINI_CART_EDIT_ITEM_QUANTITY_SELECTOR_INPUT_FIELD",
				value1 = ${quantity});
		}

		Button.clickSave();
	}

	@summary = "Default summary"
	macro getCurrentCartDataBadgeCount() {
		var dataBadgeCount = selenium.getAttribute("//div[contains(@class,'mini-cart')]/button[contains(@class,'mini-cart-opener') and @data-badge-count]@data-badge-count");

		return ${dataBadgeCount};
	}

	@summary = "Default summary"
	macro getCurrentCartItemCount(productName = null) {
		CommerceNavigator.gotoMiniCart();

		var currentItemCount = FrontStore.getCurrentCartDataBadgeCount();

		if (IsElementPresent(key_cartItemName = ${productName}, locator1 = "CommerceAccelerators#MINI_CART_ITEM_NAME")) {
			var newItemCount = ${currentItemCount};
		}
		else {
			var newItemCount = ${currentItemCount} + 1;
		}

		return ${newItemCount};
	}

	@summary = "This macro goes to the edit section of an order item with options from the minicart"
	macro gotoEditMiniCartItemProductOption(cartItemSku = null) {
		if (!(isSet(index))) {
			var index = 1;
		}

		Click(
			key_cartItemSku = ${cartItemSku},
			key_index = ${index},
			locator1 = "CommerceAccelerators#MINI_CART_SPECIFIC_ITEM_BUNDLED_ITEM_BODY_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Edit");
	}

	@summary = "Default summary"
	macro quickAddToCartSearchAndSelectItem(orderItemSku = null) {
		Type(
			locator1 = "Publications#KEYWORD_TEXTFIELD",
			value1 = ${orderItemSku});

		Click(
			key_productSku = ${orderItemSku},
			locator1 = "CommerceAccelerators#QUICK_ADD_TO_CART_SEARCH_RESULT");
	}

	@summary = "Default summary"
	macro selectAssociatedFSOptionsValue(fsOptionValue = null, fsOptionName = null) {
		Select(
			key_optionName = ${fsOptionName},
			locator1 = "CommerceFrontStore#FS_PRODUCT_OPTIONS_SELECT",
			value1 = ${fsOptionValue});
	}

	@summary = "Default summary"
	macro setAssociatedFSOptionsValue(date = null, boolean = null, multipleSelectionValuesChecked = null, multipleSelectionValuesNotChecked = null, numeric = null, text = null, singleSelectionValueChecked = null) {
		if (isSet(boolean)) {
			var booleanStatus = StringUtil.extractFirst(${boolean}, ":");
			var booleanCheckboxName = StringUtil.extractLast(${boolean}, ":");

			if (${booleanStatus} == "enabled") {
				Check.checkNotVisible(
					checkboxName = ${booleanCheckboxName},
					locator1 = "CommerceFrontStore#BOOLEAN_CHECKBOX");
			}
			else if (${booleanStatus} == "disabled") {
				Uncheck.uncheckNotVisible(
					checkboxName = ${booleanCheckboxName},
					locator1 = "CommerceFrontStore#BOOLEAN_CHECKBOX");
			}
		}

		if (isSet(date)) {
			Type.sendKeys(
				key_text = "date",
				locator1 = "TextInput#ANY",
				value1 = ${date});
		}

		if (isSet(multipleSelectionValuesChecked)) {
			for (var multipleSelectionValueChecked : list ${multipleSelectionValuesChecked}) {
				Check.checkNotVisible(
					checkboxName = ${multipleSelectionValueChecked},
					locator1 = "Checkbox#ANY_CHECKBOX");
			}
		}
		else if (isSet(multipleSelectionValuesNotChecked)) {
			for (var multipleSelectionValueNotChecked : list ${multipleSelectionValuesNotChecked}) {
				Uncheck.uncheckNotVisible(
					checkboxName = ${multipleSelectionValueNotChecked},
					locator1 = "Checkbox#ANY_CHECKBOX");
			}
		}

		if (isSet(numeric)) {
			Type(
				key_text = "numeric",
				locator1 = "TextInput#ANY",
				value1 = ${numeric});
		}

		if (isSet(singleSelectionValueChecked)) {
			Click.clickAtNotVisible(
				key_fieldValue = ${singleSelectionValueChecked},
				locator1 = "CommerceEntry#RADIO_BUTTON_WITH_VALUE");
		}

		if (isSet(text)) {
			Type(
				key_text = "text",
				locator1 = "TextInput#ANY",
				value1 = ${text});
		}
	}

	@summary = "Default summary"
	macro setMaxComparisonItems(maxItems = null) {
		Portlet.gotoPortletOptions(
			portletName = "Product Comparison",
			portletOption = "Configuration");

		SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Type(
			key_fieldLabel = "Products Limit",
			locator1 = "TextInput#GENERIC_NUMBER_INPUT",
			value1 = ${maxItems});

		Button.clickSave();

		AssertElementPresent(locator1 = "Message#SUCCESS");

		Button.clickCancel();
	}

	@summary = "Default summary"
	macro setQuantitySelectorPopoverListItemText(quantityConfiguration = null) {
		if (${quantityConfiguration} == "min") {
			var quantityConfigurationText = "Min quantity per order is ";
		}
		else {
			if (${quantityConfiguration} == "max") {
				var quantityConfigurationText = "Maximum quantity per order is ";
			}
			else {
				if (${quantityConfiguration} == "multiple") {
					var quantityConfigurationText = "Quantity must be a multiple of ";
				}
				else {
					TestUtils.fail(message = "Selected quantity configuration is not valid.");
				}

				if (isSet(quantityConfigurationDecimalText)) {
					var quantityConfigurationDecimalText = "Quantity allows for ${quantityConfigurationDecimalText} decimal places ";
				}
			}
		}

		return ${quantityConfigurationText};
	}

	@summary = "Default summary"
	macro viewAssociatedFSOptionsValue(boolean = null, multipleSelectionValuesChecked = null, multipleSelectionValuesNotChecked = null, numeric = null, text = null, singleSelectionValueChecked = null) {
		if (${boolean} == "enabled") {
			AssertChecked.assertCheckedNotVisible(
				checkboxName = "",
				locator1 = "Checkbox#ANY_CHECKBOX");
		}
		else if (${boolean} == "disabled") {
			AssertNotChecked.assertNotCheckedNotVisible(
				checkboxName = "",
				locator1 = "Checkbox#ANY_CHECKBOX");
		}

		if (isSet(date)) {
			var date = DateUtil.format(${date}, "MM/dd/yyyy", "yyyy-MM-dd");

			AssertTextEquals(
				key_text = "date",
				locator1 = "TextInput#ANY",
				value1 = ${date});
		}

		if (isSet(multipleSelectionValuesChecked)) {
			for (var multipleSelectionValueChecked : list ${multipleSelectionValuesChecked}) {
				AssertChecked.assertCheckedNotVisible(
					checkboxName = ${multipleSelectionValueChecked},
					locator1 = "Checkbox#ANY_CHECKBOX");
			}
		}
		else if (isSet(multipleSelectionValuesNotChecked)) {
			for (var multipleSelectionValueNotChecked : list ${multipleSelectionValuesNotChecked}) {
				AssertNotChecked.assertNotCheckedNotVisible(
					checkboxName = ${multipleSelectionValueNotChecked},
					locator1 = "Checkbox#ANY_CHECKBOX");
			}
		}

		if (isSet(numeric)) {
			AssertTextEquals(
				key_text = "numeric",
				locator1 = "TextInput#ANY",
				value1 = ${numeric});
		}

		if (isSet(singleSelectionValueChecked)) {
			AssertChecked.assertCheckedNotVisible(
				key_fieldValue = ${singleSelectionValueChecked},
				locator1 = "CommerceEntry#RADIO_BUTTON_WITH_VALUE");
		}
		else if (isSet(singleSelectionValueNotChecked)) {
			for (var singleSelectionValueNotChecked : list ${singleSelectionValueNotChecked}) {
				AssertNotChecked.assertNotCheckedNotVisible(
					key_fieldValue = ${singleSelectionValueNotChecked},
					locator1 = "CommerceEntry#RADIO_BUTTON_WITH_VALUE");
			}
		}

		if (isSet(text)) {
			AssertTextEquals(
				key_text = "text",
				locator1 = "TextInput#ANY",
				value1 = ${text});
		}
	}

	@summary = "Default summary"
	macro viewGroupedProductEntries(productNames = null) {
		Variables.assertDefined(parameterList = ${productNames});

		for (var productName : list ${productNames}) {
			var productImage = CommerceJSONProductsAPI._getCommerceProductImageIds(productName = ${productName});

			AssertElementPresent(
				key_productName = ${productName},
				locator1 = "CommerceFrontStore#PRODUCT_DETAILS_GROUPED_PRODUCT_NAME");

			AssertElementPresent(
				key_productName = ${productName},
				key_productShortDescription = "${productName} Short Description",
				locator1 = "CommerceFrontStore#PRODUCT_DETAILS_GROUPED_PRODUCT_SHORT_DESCRIPTION");

			if (${productImage} == "") {
				var productImage = "default";
			}

			AssertElementPresent(
				key_productImage = ${productImage},
				key_productName = ${productName},
				locator1 = "CommerceFrontStore#PRODUCT_DETAILS_GROUPED_PRODUCT_IMAGE");
		}
	}

	@summary = "Default summary"
	macro viewMiniCart(cartItemNames = null, cartSummaryTotal = null, cartItemOptions = null, cartItemQuantities = null, cartItemSkUs = null, cartItemPriceValues = null, cartSummaryOrderDiscount = null, cartSummaryQuantity = null, cartSummarySubtotal = null) {
		FrontStore.viewMiniCartItems(
			cartItemNames = ${cartItemNames},
			cartItemOption = ${cartItemOptions},
			cartItemPriceValues = ${cartItemPriceValues},
			cartItemQuantities = ${cartItemQuantities},
			cartItemSkUs = ${cartItemSkUs});

		if (isSet(cartSummaryQuantity)) {
			AssertTextEquals(
				key_summaryTableItem = "Quantity",
				locator1 = "CommerceAccelerators#MINI_CART_SUMMARY_TABLE_ITEM",
				value1 = ${cartSummaryQuantity});
		}

		if (isSet(cartSummarySubtotal)) {
			AssertTextEquals.assertPartialText(
				key_summaryTableItem = "Subtotal",
				locator1 = "CommerceAccelerators#MINI_CART_SUMMARY_TABLE_ITEM",
				value1 = "$ ${cartSummarySubtotal}");
		}

		if (isSet(cartSummaryOrderDiscount)) {
			AssertTextEquals.assertPartialText(
				key_summaryTableItem = "Order Discount",
				locator1 = "CommerceAccelerators#MINI_CART_SUMMARY_TABLE_ITEM",
				value1 = "$ ${cartSummaryOrderDiscount}");
		}

		if (isSet(cartSummaryTotal)) {
			AssertTextEquals.assertPartialText(
				locator1 = "CommerceAccelerators#MINI_CART_SUMMARY_TABLE_TOTAL",
				value1 = "$ ${cartSummaryTotal}");
		}
	}

	@summary = "This macro views product options of an order item from the minicart"
	macro viewMiniCartEditProductOption(date = null, multipleSelectionValuesChecked = null, cartItemPromoPriceValue = null, cartItemPriceAsConfiguredValue = null, numeric = null, cartItemPriceValue = null, singleSelectionValueNotChecked = null, boolean = null, cartItemPriceInactiveValue = null, cartItemDiscountValue = null, cartItemOptionName = null, multipleSelectionValuesNotChecked = null, cartItemOptionValue = null, text = null, singleSelectionValueChecked = null) {
		AssertVisible(
			key_productName = "Bundled Product",
			locator1 = "CommerceAccelerators#MINI_CART_EDIT_ITEM_PANEL");

		AssertSelectedLabel(
			key_optionName = ${cartItemOptionName},
			locator1 = "CommerceAccelerators#MINI_CART_PRODUCT_OPTIONS_SELECT",
			value1 = ${cartItemOptionValue});

		if (isSet(cartItemDiscountValue)) {
			AssertTextEquals(
				key_priceField = "Discount",
				locator1 = "CommerceAccelerators#MINI_CART_EDIT_BUNDLED_PRODUCT_PRICE_VALUE",
				value1 = ${cartItemDiscountValue});
		}

		if (${cartItemPriceOnApplication} == "true") {
			AssertElementPresent(locator1 = "CommerceAccelerators#MINI_CART_EDIT_ITEM_PRICE_ON_APPLICATION");
		}

		if (isSet(cartItemPriceAsConfiguredValue)) {
			AssertTextEquals(
				key_priceField = "Price as Configured",
				locator1 = "CommerceAccelerators#MINI_CART_EDIT_BUNDLED_PRODUCT_PRICE_VALUE",
				value1 = ${cartItemPriceAsConfiguredValue});
		}

		if (isSet(cartItemPriceValue)) {
			AssertTextEquals(
				key_priceField = "List Price",
				locator1 = "CommerceAccelerators#MINI_CART_EDIT_BUNDLED_PRODUCT_PRICE_VALUE",
				value1 = ${cartItemPriceValue});
		}
		else if (isSet(cartItemPriceInactiveValue)) {
			AssertTextEquals(
				locator1 = "CommerceAccelerators#MINI_CART_EDIT_BUNDLED_PRODUCT_LIST_PRICE_INACTIVE",
				value1 = ${cartItemPriceInactiveValue});
		}

		if (isSet(cartItemPromoPriceValue)) {
			AssertTextEquals(
				key_priceField = "Promo Price",
				locator1 = "CommerceAccelerators#MINI_CART_EDIT_BUNDLED_PRODUCT_PRICE_VALUE",
				value1 = ${cartItemPromoPriceValue});
		}

		FrontStore.viewAssociatedFSOptionsValue(
			boolean = ${boolean},
			date = ${date},
			multipleSelectionValuesChecked = ${multipleSelectionValuesChecked},
			multipleSelectionValuesNotChecked = ${multipleSelectionValuesNotChecked},
			numeric = ${numeric},
			singleSelectionValueChecked = ${singleSelectionValueChecked},
			singleSelectionValueNotChecked = ${singleSelectionValueNotChecked},
			text = ${text});
	}

	@summary = "Default summary"
	macro viewMiniCartItem(cartItemPriceInactiveValue = null, cartItemName = null,
	cartItemPromoPriceValue = null, cartItemQuantity = null, bundledItems = null,
	cartItemSku = null, cartItemPriceValue = null, cartItemUOMKey = null, optionName = null) {
		if (!(isSet(cartItemPriceOnApplication))) {
			var cartItemPriceOnApplication = "false";
		}

		if (!(isSet(index))) {
			var index = 1;
		}

		AssertTextEquals(
			key_cartItemSku = ${cartItemSku},
			locator1 = "CommerceAccelerators#MINI_CART_ITEM_NAME_USING_SKU",
			value1 = ${cartItemName});

		AssertTextEquals(
			key_cartItemSku = ${cartItemSku},
			locator1 = "CommerceAccelerators#MINI_CART_ITEM_SKU",
			value1 = ${cartItemSku});

		if (isSet(cartItemQuantity)) {
			AssertTextEquals(
				key_cartItemSku = ${cartItemSku},
				key_index = ${index},
				locator1 = "CommerceAccelerators#MINI_CART_ITEM_QUANTITY_N",
				value1 = ${cartItemQuantity});
		}

		if (isSet(bundledItems)) {
			var key_cartItemSku = ${cartItemSku};
			var key_index = ${index};

			if ((IsElementPresent(locator1 = "CommerceAccelerators#MINI_CART_SPECIFIC_ITEM_BUNDLED_ITEM_SHOW_OPTIONS_PANEL_COLLAPSED")) && (IsVisible(locator1 = "CommerceAccelerators#MINI_CART_SPECIFIC_ITEM_BUNDLED_ITEM_SHOW_OPTIONS_PANEL_COLLAPSED"))) {
				Click(
					key_cartItemSku = ${cartItemSku},
					key_index = ${index},
					locator1 = "CommerceAccelerators#MINI_CART_SPECIFIC_ITEM_BUNDLED_ITEM_SHOW_OPTIONS_PANEL_COLLAPSED");

				for (var bundledItem : list ${bundledItems}) {
					if (isSet(optionName)) {
						AssertElementPresent(
							key_cartItemName = ${optionName},
							locator1 = "CommerceAccelerators#MINI_CART_ITEM_NAME_H6");
					}

					AssertElementPresent(
						key_cartItemSku = ${bundledItem},
						locator1 = "CommerceAccelerators#MINI_CART_ITEM_SKU");
				}
			}
			else {
				for (var bundledItem : list ${bundledItems}) {
					AssertTextEquals.assertPartialText(
						key_cartItemSku = ${cartItemSku},
						key_index = ${index},
						locator1 = "CommerceAccelerators#MINI_CART_SPECIFIC_ITEM_BUNDLED_ITEMS_N",
						value1 = ${bundledItem});
				}
			}
		}

		if (${cartItemPriceOnApplication} == "true") {
			AssertTextEquals(
				key_cartItemSku = ${cartItemSku},
				key_index = ${index},
				locator1 = "CommerceAccelerators#MINI_CART_ITEM_PRICE_ON_APPLICATION_N",
				value1 = "Price on Application");
		}

		if (isSet(cartItemPriceValue)) {
			AssertTextEquals.assertPartialText(
				key_cartItemSku = ${cartItemSku},
				locator1 = "CommerceAccelerators#MINI_CART_ITEM_PRICE_VALUE",
				value1 = "$ ${cartItemPriceValue}");
		}
		else if (isSet(cartItemPriceInactiveValue)) {
			AssertTextEquals(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_LIST_PRICE_INACTIVE",
				value1 = "$ ${cartItemPriceInactiveValue}");
		}

		if (isSet(cartItemPromoPriceValue)) {
			AssertTextEquals(
				locator1 = "CommerceAccelerators#PRODUCT_DETAILS_LIST_PRICE_PROMO",
				value1 = "$ ${cartItemPromoPriceValue}");
		}

		if (isSet(cartItemUOMKey)) {
			AssertTextEquals.assertPartialText(
				key_uom = ${cartItemUOMKey},
				locator1 = "CommerceAccelerators#MINI_CART_ITEM_UOM_NAME",
				value1 = ${cartItemUOMKey});
		}

		AssertElementPresent(
			key_cartItemSku = ${cartItemSku},
			locator1 = "CommerceAccelerators#MINI_CART_ITEM_THUMBNAIL");

		if (isSet(cartItemOption) && isSet(optionName)) {
			for (var cartItemOption : list ${cartItemOption}) {
				var optionName = StringUtil.extractFirst(${cartItemOption}, ":");
				var optionValue = StringUtil.extractLast(${cartItemOption}, ":");

				AssertElementPresent(
					key_cartItemName = ${optionName},
					key_cartItemSku = ${optionValue},
					key_index = ${index},
					locator1 = "CommerceAccelerators#MINI_CART_ITEM_NAME_SKU_INDEX");

				echo("The option [${optionName}] with the value [${optionValue}] is present");
			}
		}
		else if (isSet(cartItemOption) && !(isSet(optionName))) {
			for (var cartItemOption : list ${cartItemOption}) {
				AssertTextEquals.assertPartialText(
					key_cartItemSku = ${cartItemSku},
					key_index = ${index},
					locator1 = "CommerceAccelerators#MINI_CART_ITEM_INFO_EXTRA_N",
					value1 = ${cartItemOption});
			}
		}
	}

	@summary = "Default summary"
	macro viewMiniCartItems() {
		var count = StringUtil.count(${cartItemSkUs}, ",");

		while (${count} != 0) {
			var cartItemName = StringUtil.extractFirst(${cartItemNames}, ",");
			var cartItemPriceValue = StringUtil.extractFirst(${cartItemPriceValues}, ",");
			var cartItemQuantity = StringUtil.extractFirst(${cartItemQuantities}, ",");
			var cartItemSku = StringUtil.extractFirst(${cartItemSkUs}, ",");

			FrontStore.viewMiniCartItem(
				cartItemName = ${cartItemName},
				cartItemPriceValue = ${cartItemPriceValue},
				cartItemQuantity = ${cartItemQuantity},
				cartItemSku = ${cartItemSku});

			var count = ${count} - 1;
			var cartItemNames = StringUtil.replaceFirst(${cartItemNames}, "${cartItemName},", "");
			var cartItemPriceValues = StringUtil.replaceFirst(${cartItemPriceValues}, "${cartItemPriceValue},", "");
			var cartItemQuantities = StringUtil.replaceFirst(${cartItemQuantities}, "${cartItemQuantity},", "");
			var cartItemSkUs = StringUtil.replaceFirst(${cartItemSkUs}, "${cartItemSku},", "");
		}
	}

	@summary = "Default summary"
	macro viewProductAttachment(attachmentName = null) {
		Variables.assertDefined(parameterList = ${attachmentName});

		Click(
			key_text = "Attachments",
			locator1 = "Button#ANY");

		AssertElementPresent(
			key_entryName = ${attachmentName},
			locator1 = "CommerceFrontStore#PRODUCT_DETAILS_ATTACHMENTS_NAME");

		AssertElementPresent(
			key_entryName = ${attachmentName},
			locator1 = "CommerceFrontStore#PRODUCT_DETAILS_ATTACHMENTS_ICON_DEFAULT");

		AssertElementPresent(
			key_button = "Download",
			key_entryName = ${attachmentName},
			locator1 = "CommerceFrontStore#PRODUCT_DETAILS_ATTACHMENTS_BUTTON");
	}

	@summary = "Default summary"
	macro viewQuantitySelectorPopoverListItem(quantityConfiguration = null, quantity = null) {
		Variables.assertDefined(parameterList = "${quantityConfiguration},${quantity}");

		if (!(isSet(conditionNotSatisfied))) {
			var conditionNotSatisfied = "false";
		}

		var quantityConfigurationText = FrontStore.setQuantitySelectorPopoverListItemText(quantityConfiguration = ${quantityConfiguration});

		if (${conditionNotSatisfied} == "true") {
			AssertElementPresent(
				key_quantity = ${quantity},
				key_quantityConfigurationText = ${quantityConfigurationText},
				locator1 = "CommerceFrontStore#QUANTITY_SELECTOR_POPOVER_LIST_ITEM_ERROR");
		}
		else {
			AssertElementPresent(
				key_quantity = ${quantity},
				key_quantityConfigurationText = ${quantityConfigurationText},
				locator1 = "CommerceFrontStore#QUANTITY_SELECTOR_POPOVER_LIST_ITEM");
		}
	}

}