<html>
<head>
<title>CommerceFrontStore</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CommerceFrontStore</td></tr>
</thead>

<tbody>
<tr>
	<td>ACCOUNT_SELECTOR_SELECTED_ACCOUNT</td>
	<td>//div[contains(@class,'account-name')]/span/span</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_PAGES_NOTES_BUTTON</td>
	<td>//span[@title='Notes']//a</td>
	<td></td>
</tr>
<tr>
	<td>COUPON_CODE_BODY</td>
	<td>//div[@class='coupon-code-body']/h3[text()='${key_couponCode}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_COMPARISON_TABLE_SPECIFICATION</td>
	<td>//td[contains(.,'${key_specification}')]/following-sibling::td[${key_columnNumber}][contains(.,'${key_value}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PRICE_TABLE_HEADER</td>
	<td>//th//span[text()='${key_columnName}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PRICE_TABLE_FIELD_ENTRY</td>
	<td>//tbody//tr[@class][${key_index}]//td[text()='${key_fieldValue}']</td>
	<td></td>
</tr>
<tr>
	<td>FS_IMAGE_GALLERY_ARROW_NEXT</td>
	<td>//div[@class='arrow next']</td>
	<td></td>
</tr>
<tr>
	<td>FS_IMAGE_GALLERY_ARROW_PREV</td>
	<td>//div[@class='arrow prev']</td>
	<td></td>
</tr>
<tr>
	<td>FS_IMAGE_GALLERY_OVERLAY</td>
	<td>//div[@class='gallery-overlay']//source[contains(@srcset,'${key_fsProductImage}')]/..//img</td>
	<td></td>
</tr>
<tr>
	<td>FS_IMAGE_GALLERY_THUMBNAIL</td>
	<td>//div[@class= 'gallery-thumbnails']//source[contains(@srcset,'${key_fsProductImage}')]/..//img</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_COUNT</td>
	<td>//div[contains(@class,'pull-right')]/p[contains(text(),'${key_productCount} Products Available')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_SKU</td>
	<td>//p/span[normalize-space(text())='SKU:']/following::span[normalize-space(text())='${key_productSku}']</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_DETAIL</td>
	<td>//span[(normalize-space(text())='${key_detail}')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_STOCK_QUANTITY</td>
	<td>//div[contains(concat(' ',normalize-space(@class),' '),' stock-quantity ')]/span</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_AVAILABILITY</td>
	<td>//div/div/span[contains(@class,'availability-label')]/span[contains(text(),'${key_availability}')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_AVAILABILITY_DISCONTINUED</td>
	<td>//div[contains(@class,'availability')]//span[@class='text-danger'][contains(text(),'Discontinued')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_DESCRIPTION</td>
	<td>//p[contains(concat(' ',normalize-space(@class),' '),'product-description')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_FULL_DESCRIPTION</td>
	<td>//div[contains(@id,'navDescription')]/div</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_SPECIFICATIONS</td>
	<td>//tr/td[contains(@class, 'specification-term')][contains(text(),'${key_specification}')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_NAME</td>
	<td>//h2[@class='product-header-title']</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_OPTIONS_SELECT</td>
	<td>//div/label[text()='${key_optionName}']/..//select | //div/label[text()='${key_optionName}']/..//button</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_UOM_SELECT</td>
	<td>//select[contains(@class,'unit-of-measure-selector')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_UOM_SELECT_DISABLED</td>
	<td>//select[(@disabled)][contains(@class,'unit-of-measure-selector')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_UOM_SELECTOR_VALUE</td>
	<td>//select[contains(@class,'unit-of-measure-selector')]//option[contains(@value,'${uomName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_UOM_SELECTOR_VALUE_BY_INDEX</td>
	<td>//select[contains(@class,'unit-of-measure-selector')]//option[${index}][contains(@value,'${uomName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_BOOLEAN_OPTION</td>
	<td>//div/label[text()='${key_optionName}']/..//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_DETAIL_INCOMING_DATE_QUANTITY</td>
	<td>//p[contains(.,"Incoming Date/Quantity: ${key_incomingDate} - ${key_incomingQuantity} Items")]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_OPTION</td>
	<td>//div[contains(@class,'dropdown-menu')]/ul//li/button[(normalize-space(text())='${key_optionValue}')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_IMAGE</td>
	<td>//div[@class='product-gallery']//source[contains(@srcset,'${key_fsProductImage}')]/..//img</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_MAIN_IMAGE</td>
	<td>//div[@class='card main-image']//source[contains(@srcset,'${key_fsProductImage}')]/..//img</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_THUMBNAIL_IMAGE</td>
	<td>//div[@class='gallery-thumbnails']//source[contains(@srcset,'${key_fsProductImage}')]/..//img</td>
	<td></td>
</tr>
<tr>
	<td>MAX_QUANTITY_SELECTOR_PRODUCT_DETAILS</td>
	<td>//div[contains(@class,"product-detail")]//div[contains(@class,"add-to-cart")]//input[contains(@max, '${key_value}')]</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_TITLE</td>
	<td>//*[@class='modal-title' and normalize-space(text())='${key_title}']</td>
	<td></td>
</tr>
<tr>
	<td>TEXTAREA_FIELD</td>
	<td>//input[contains(@class,'form-control')and contains(@value,'${key_value}')]/..//textarea</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ATTACHMENTS_BUTTON</td>
	<td>//li[contains(@class,'list-group-item')]//div[contains(@class,'h5') and text()='${key_entryName}']/ancestor::li//a[contains(text(),'${key_button}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_IMAGE_MINI_CART_WITH_ALT_ATTRIBUTE</td>
	<td>//div[@class= 'mini-cart-item-thumbnail']//img[contains(@alt,'thumbnail')]/../../../div[@class='mini-cart-item-info ml-3']//p[contains(text(),'${key_productSku}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_IMAGE_CHECKOUT_WITH_ALT_ATTRIBUTE</td>
	<td>//div[@class='table-responsive']//img[contains(@alt,'thumbnail')]/../../../../..//div[@class='list-group-title' and contains(text(),'${key_productName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ATTACHMENTS_ICON_DEFAULT</td>
	<td>//div[contains(@class,'h5') and text()='${key_entryName}']/../..//*[name()='svg'][contains(@class,'icon-document-default')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ATTACHMENTS_NAME</td>
	<td>//li[contains(@class,'list-group-item')]//div[contains(@class,'h5') and text()='${key_entryName}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_DOWNLOAD_SAMPLE_FILE_BUTTON</td>
	<td>//a[normalize-space(text())='Download Sample File'][contains(@href,'${key_sampleFileName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_GROUPED_PRODUCT_NAME</td>
	<td>//div[contains(@class,'grouped-products-container')]//div[contains(@class,'h5') and normalize-space(text())='${key_productName}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_GROUPED_PRODUCT_IMAGE</td>
	<td>//div[contains(@class,'grouped-products-container')]//div[contains(@class,'h5') and normalize-space(text())='${key_productName}']/../..//img[contains(@src,'${key_productImage}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_GROUPED_PRODUCT_SHORT_DESCRIPTION</td>
	<td>//div[contains(@class,'grouped-products-container')]//div[contains(@class,'h5') and normalize-space(text())='${key_productName}']/following::p[normalize-space(text())='${key_productShortDescription}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_MIN_QUANTITY_PER_ORDER</td>
	<td>//span[(@class='min-quantity-per-order') and contains(.,'Minimum Quantity per Order: ${key_minQuantity}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_OPTION_POSITION</td>
	<td>//div[@class='product-detail-options']/form/div[${key_position}]//label[text()='${key_optionName}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_OPTION_VALUE</td>
	<td>//div/label[text()='${key_optionName}']/..//select/option[@value][text()='${key_optionValue}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_OPTION_VALUE_POSITION</td>
	<td>//div/label[text()='${key_optionName}']/..//select/option[@value][${key_index}][text()='${key_optionValue}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_QUANTITY_SELECTOR</td>
	<td>//h2[text()='${key_productName}']/../..//input[contains(@class,'quantity-selector')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_QUANTITY_SELECTOR_HAS_ERROR</td>
	<td>//h2[text()='${key_productName}']/../..//div[contains(@class,'has-error')]/input[contains(@class,'quantity-selector')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PRICE_VALUE_INACTIVE</td>
	<td>//p[@title='${key_productName}']/following-sibling::p//span[contains(@class, 'price-value price-value-inactive')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_QUANTITY_OPTION</td>
	<td>//header//h2[text()='${key_productName}']//..//following-sibling::div[6]//option[@value='${key_optionValue}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PRICE_VALUE_FINAL</td>
	<td>//p[@title='${key_productName}']/following-sibling::p//span[contains(@class, 'price-value price-value-final')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PACKAGE_QUANTITY</td>
	<td>//label[text()='Package Quantity']//..//div[contains(@class,'form-control')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_REPLACEMENTS_SKU</td>
	<td>//div[contains(@class,'h4') and contains(text(),'Replacements')]/..//div[contains(@class,'content-wrapper')]//a[text()='${key_productSku}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_IN_STOCK_QUANTITY</td>
	<td>//span[(@data-qa-id='inStockQuantity') and (contains(text(),'${key_inStockQuantity}'))]</td>
	<td></td>
</tr>
<tr>
	<td>MINI_COMPARE_COMPARE_BUTTON</td>
	<td>//div[@class='mini-compare active']/a[@class='btn btn-primary']</td>
	<td></td>
</tr>
<tr>
	<td>MINI_COMPARE_ITEM_ACTIVE_N</td>
	<td>//div[@class='mini-compare-item active'][${key_value}]//div[@class='mini-compare-thumbnail']</td>
	<td></td>
</tr>
<tr>
	<td>MINI_COMPARE_ITEM_N</td>
	<td>//div[contains(@class,'mini-compare-item')][${key_value}]//div[@class='mini-compare-thumbnail']</td>
	<td></td>
</tr>
<tr>
	<td>MINI_COMPARE_ITEM_CUSTOM_IMAGE</td>
	<td>//div[contains(@class,'mini-compare active')]//div[contains(@style,'${key_productMediaId}')]</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_VALUE_PROMO_PRICE</td>
	<td>//p[@title='${key_productName}']//following-sibling::p[@class='card-text']//span[@class='price-value price-value-promo']</td>
	<td></td>
</tr>
<tr>
	<td>FS_PRODUCT_VALUE_INACTIVE_PRICE</td>
	<td>//p[@title='${key_productName}']//following-sibling::p[@class='card-text']//span[@class='price-value price-value-inactive']</td>
	<td></td>
</tr>
<tr>
	<td>MINI_COMPARE_ITEM_REMOVE_BUTTON</td>
	<td>//div[contains(@class,'mini-compare active')]//div[contains(@style,'${key_productMediaId}')]/../../..//button[contains(@class,'mini-compare-delete')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_CARD_CATALOG_IMAGE</td>
	<td>//a[contains(@href,'${key_productName}')]//img[contains(@class,'card-picture')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_CARD_IMAGE</td>
	<td>//a[contains(@href,'${key_productName}')]//*[(contains(@style,'image')) or (contains(@class,'img'))]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_CARD_IMAGE_SPECIFIC</td>
	<td>//a[contains(@href,'${key_productName}')]//img[contains(@src,'${key_image}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_CARD_IMAGE_SPECIFIC_IN_MINI_CART</td>
	<td>//a[contains(@href,'${key_productName}')]//..//div//img[contains(@src,'${key_image}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_CARD_BODY</td>
	<td>//p[@class='card-title' and contains(@title,'${key_productName}')]/../../../div[contains(@class,'card-body')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_CARD_STATUS_LABEL</td>
	<td>//a[contains(@href,'${key_productName}')]//span[contains(@class,'m-0')]//*[text()='${key_status}']</td>
	<td></td>
</tr>
<tr>
	<td>QUANTITY_SELECTOR_POPOVER_LIST_ITEM</td>
	<td>//div[contains(@class,'quantity-selector-popover')]//small[text()='${key_quantityConfigurationText}']/b[text()='${key_quantity}']</td>
	<td></td>
</tr>
<tr>
	<td>QUANTITY_SELECTOR_POPOVER_LIST_ITEM_ERROR</td>
	<td>//div[contains(@class,'quantity-selector-popover')]//small[(@class='text-danger') and (text()='${key_quantityConfigurationText}')]/b[text()='${key_quantity}']</td>
	<td></td>
</tr>
<tr>
	<td>COLLECTION_DISPLAY_PRODUCT_SPECIFICATION_ENTRY</td>
	<td>//li[contains(@class,'list-group-item')]//dt[contains(.,'${key_specification}')]/..//dd[contains(.,'${key_value}')]</td>
	<td></td>
</tr>
<tr>
	<td>BOOLEAN_CHECKBOX</td>
	<td>//label[contains(.,'${checkboxName}')]/..//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SF_ORDER_BODY_VERTICAL_ELLIPSIS</td>
	<td>//div[contains(@class,'portlet') and contains(@class,'container')]//a[span/*[name()='svg'][contains(@class,'icon-ellipsis')]] | //*[contains(@class,'sheet-title')]//*[contains(@class,'dropdown-toggle')][.//*[name()='svg'][contains(@class,'icon-ellipsis')]]</td>
	<td></td>
</tr>

<!--FRAGMENTS-->

<tr>
	<td>FS_DYNAMIC_FIELD</td>
	<td>xpath=(//div[@class='dynamic-field'])[${key_index}]//${key_element}[@class='node-${key_node}']</td>
	<td></td>
</tr>
<tr>
	<td>COLLECTION_DISPLAY_PRODUCT_CARD_N</td>
	<td>//div[contains(@class,'lfr-layout-structure-item-collection')]//following::div[contains(@class,'cp-renderer')][${key_index}]//p[@class='card-title' and @title='${key_productName}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>