	@description = "Test for COMMERCE-9405. User with Discount Manager role can add price list entries"
	@priority = 3
	test CanDiscountManagerViewPriceLists {
		property portal.acceptance = "false";

		task ("Given a Minium site") {
			CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");
		}

		task ("And Discount Manager role has VIEW Commerce Catalog permission") {
			Role.openRolesAdmin();

			LexiconEntry.gotoEntry(rowEntry = "Discount Manager");

			Navigator.gotoNavItem(navItem = "Define Permissions");

			Role.viewPermissionCP(
				permissionDefinitionValue = "View",
				permissionNavigationValue = "Catalogs > Catalog");
		}

		task ("And a user with Discount Manager role is created") {
			JSONUser.addUserWithRole(
				roleTitle = "Discount Manager",
				userEmailAddress = "discount.manager@liferay.com",
				userFirstName = "Discount",
				userLastName = "Manager",
				userScreenName = "discount.manager");
		}

		task ("When the Discount Manager logs in") {
			User.logoutAndLoginPG(
				userLoginEmailAddress = "discount.manager@liferay.com",
				userLoginFullName = "Discount Manager");
		}

		task ("Then on the Applications Menu -> Commerce, the Discount Manager can see only Price Lists and Promotions") {
			ApplicationsMenuHelper.openApplicationsMenu();

			ApplicationsMenu.gotoPanel(panel = "Commerce");

			for (var portlet : list "Catalogs,Channels,Inventory,Orders,Products,Shipments") {
				AssertElementNotPresent(
					key_category = "",
					key_portlet = ${portlet},
					locator1 = "ApplicationsMenu#PORTLET");
			}

			for (var portlet : list "Price Lists,Promotions") {
				AssertElementPresent(
					key_category = "Pricing",
					key_portlet = ${portlet},
					locator1 = "ApplicationsMenu#PORTLET");
			}
		}

		task ("When the Discount Manager navigates to Price Lists page") {
			CommerceNavigator.goToPriceListAdmin();
		}

		task ("Then the user is able to create a new price list") {
			for (var entry : list "Master Base Price List,Minium Base Price List") {
				AssertElementPresent(
					key_entryName = ${entry},
					locator1 = "CommerceNavigation#ENTRY_NAME");
			}
		}
	}

	@description = "COMMERCE-12301 | Verify that is possible to see the created UOMs in the item finder for Price List"
	@priority = 4
	test CanItemFinderShowsUOMPriceList {
		property portal.acceptance = "false";

		task ("Given a Minium site with 2 UOMs is created") {
			CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");

			CommerceJSONSKUsAPI._addCommerceUOM(
				basePrice = 10,
				productSKU = "MIN93015",
				uomKey = "Liter",
				uomName = "Liter");

			CommerceJSONSKUsAPI._addCommerceUOM(
				basePrice = 20,
				productSKU = "MIN93015",
				uomKey = "Gallon",
				uomName = "Gallon");
		}

		task ("And the admin uses the item search for the Price List") {
			CommercePriceLists.openPriceListsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Base Price List");

			CommerceEntry.gotoMenuTab(menuTab = "Entries");

			Type(
				key_title = "Add SKUs",
				locator1 = "CommerceEntry#ADD_RELATION_FIELD",
				value1 = "MIN93015");

			while ((IsElementNotPresent(key_entryName = "MIN93015", key_title = "Add SKUs", locator1 = "CommerceEntry#ADD_RELATION_FIELD_SELECT")) && (maxIterations = "5")) {
				echo("The element is not present, retrying...");

				Click(locator1 = "WorkflowMetricsProcessListView#METRICS_WORKFLOW_SEARCH_BAR_BUTTON");

				Type(
					key_title = "Add SKUs",
					locator1 = "CommerceEntry#ADD_RELATION_FIELD",
					value1 = "MIN93015");
			}
		}

		task ("Then is possible to see all the created UOMs for a particular SKU") {
			for (var rowList : list "Liter:1,Gallon:2") {
				var entry = StringUtil.extractFirst(${rowList}, ":");
				var row = StringUtil.extractLast(${rowList}, ":");

				AssertElementPresent(
					key_entry = ${entry},
					key_rowNumber = ${row},
					locator1 = "CommerceEntry#ENTRY_CONTENT_ROW_NUMBER_DATASET");

				echo("The UOM ${entry} at the ${row} is present");
			}
		}
	}

	@description = "This is a test for COMMERCE-9767. Verify that a Tier Price entry cannot be saved with 0 quantity and an alert is shown"
	@priority = 3
	test CannotCreateTierPriceWithZeroQuantity {
		property portal.acceptance = "false";

		task ("Given a Minium site") {
			CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");
		}

		task ("When admin goes to the Price Lists navigating in Entries tab") {
			CommercePriceLists.openPriceListsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Base Price List");

			CommerceEntry.gotoMenuTab(menuTab = "Entries");
		}

		task ("And clicks on a SKU to add a Tier Price giving Quantity as 0") {
			CommerceNavigator.gotoEntry(entryName = "MIN93015");

			SelectFrame.selectFrameNoLoading(locator1 = "CommerceEntry#IFRAME_SIDE_PANEL");

			Click(locator1 = "Button#PLUS");

			SelectFrameTop();

			SelectFrame.selectFrameNoLoading(locator1 = "IFrame#MODAL_BODY");

			Type(
				key_text = "Quantity",
				locator1 = "TextInput#ANY",
				value1 = 0);

			Type(
				key_text = "Tier Price",
				locator1 = "TextInput#ANY",
				value1 = 0);

			Click(locator1 = "Button#SUBMIT");
		}

		task ("Then an alert message is shown on the modal") {
			Alert.viewErrorMessage(errorMessage = "Error:The specified quantity is not allowed.");
		}

		task ("And the Tier Price is not saved") {
			Click(locator1 = "Icon#CLOSE");

			SelectFrameTop();

			AssertElementNotPresent(
				key_field = "Tier Price",
				locator1 = "FrontendDataSet#TABLE_ITEM_COLUMN");
		}
	}

	@description = "This is a test for COMMERCE-7597. We cannot delete base price lists and base promotions."
	@priority = 3
	test CanNotDeleteBasePriceListsAndPromotions {
		property portal.acceptance = "false";

		task ("Given a Minium site") {
			CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");
		}

		task ("When admin goes to the Price Lists section") {
			CommerceNavigator.goToPriceListAdmin();
		}

		task ("Then verifies that there is no Delete button for Master and Minium Base Price Lists") {
			for (var basePriceListName : list "Master Base Price List,Minium Base Price List") {
				CommercePriceLists.assertDeleteButtonNotPresent(baseEntryName = ${basePriceListName});
			}
		}

		task ("When admin adds a new Price List") {
			CommerceJSONPriceListsAndPromotionsAPI._addPriceList(
				catalogName = "Minium",
				currencyCode = "USD",
				priceListName = "Test Price List");

			Refresh();
		}

		task ("Then verifies that there is a Delete button for the new price list") {
			Click(
				key_value = "Test Price List",
				locator1 = "CommerceEntry#BODY_VERTICAL_ELLIPSIS");

			AssertElementPresent(
				key_menuItem = "Delete",
				locator1 = "MenuItem#ANY_MENU_ITEM");
		}

		task ("When admin goes to the Promotions section") {
			CommerceNavigator.gotoPortlet(
				category = "Pricing",
				panel = "Commerce",
				portlet = "Promotions");
		}

		task ("Then verifies that there is no Delete button for Master and Minium Base Promotions") {
			for (var basePromotionName : list "Master Base Promotion,Minium Base Promotion") {
				CommercePriceLists.assertDeleteButtonNotPresent(baseEntryName = ${basePromotionName});
			}
		}

		task ("When admin adds a new Promotion") {
			CommerceJSONPriceListsAndPromotionsAPI._addPromotion(
				catalogName = "Minium",
				currencyCode = "USD",
				promotionName = "Test Promotion");

			Refresh();
		}

		task ("Then verifies that there is a Delete button for the new promotion") {
			Click(
				key_value = "Test Promotion",
				locator1 = "CommerceEntry#BODY_VERTICAL_ELLIPSIS");

			AssertElementPresent(
				key_menuItem = "Delete",
				locator1 = "MenuItem#ANY_MENU_ITEM");
		}
	}

	@description = "This is a test for COMMERCE-10053. An error message shows up when the eligibility element is already linked"
	@priority = 3
	test CannotSelectPriceListEligibilitiesTwice {
		property portal.acceptance = "false";

		task ("Given a Minium site is created") {
			CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");
		}

		task ("And a business account is created") {
			JSONAccountEntry.addAccountEntry(
				accountEntryName = "Commerce Account",
				accountEntryType = "Business");
		}

		task ("And an order type is created") {
			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeName = "Order Type Test");
		}

		task ("And a price list is created") {
			CommerceJSONPriceListsAndPromotionsAPI._addPriceList(
				catalogName = "Minium",
				currencyCode = "USD",
				priceListName = "Test Price List");
		}

		task ("When the admin navigates to the price list entry") {
			CommercePriceLists.openPriceListsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Test Price List");
		}

		task ("And sets the eligibilities for the promotion") {
			CommerceEntry.gotoMenuTab(menuTab = "Eligibility");

			CommerceEntry.setEntryEligibility(
				accountsEligibility = "Commerce Account",
				channelsEligibility = "Minium Portal",
				orderTypesEligibility = "Order Type Test");
		}

		task ("And sets again the same eligibility for channel") {
			CommerceEntry.setEntryEligibility(
				channelsEligibility = "Minium Portal",
				unpublish = "true");
		}

		task ("Then an error message shows up") {
			Alert.viewErrorMessage(errorMessage = "The channel relation already exists.");
		}

		task ("When the admin sets again the same eligibility for account") {
			CommerceEntry.setEntryEligibility(
				accountsEligibility = "Commerce Account",
				unpublish = "true");
		}

		task ("Then an error message shows up") {
			Alert.viewErrorMessage(errorMessage = "The account relation already exists.");
		}

		task ("When the admin sets again the same eligibility for order type") {
			CommerceEntry.setEntryEligibility(
				orderTypesEligibility = "Order Type Test",
				unpublish = "true");
		}

		task ("Then an error message shows up") {
			Alert.viewErrorMessage(errorMessage = "The order type relation already exists.");
		}
	}

	@description = "This is a test for COMMERCE-12371. Can view Sort By Price is working properly "
	@priority = 5
	test CanViewSortByPrice {
		property portal.acceptance = "true";

		task ("Given a minium site is created") {
			CommerceAccelerators.initializeNewSiteViaAccelerator(siteName = "Minium");
		}

		task ("And a new price list is created") {
			CommerceNavigator.goToPriceListAdmin();

			Click(locator1 = "Button#PLUS");

			CommerceEntry.addNewPriceListsEntry(
				priceListCatalog = "Minium",
				priceListCurrency = "USD",
				priceListName = "pricelist1");

			AssertClickNoError(
				locator1 = "Button#SUBMIT",
				value1 = "Submit");
		}

		task ("When a new entry is added to the new price list") {
			SelectFrameTop();

			CommerceNavigator.gotoEntry(entryName = "pricelist1");

			CommerceEntry.gotoMenuTab(menuTab = "Entries");

			CommerceRelations.assignSingleRelationToProductsEntry(
				entryName = "MIN00674",
				title = "Add SKUs");

			SelectFrameTop();

			CommerceEntry.gotoMenuTab(menuTab = "Entries");

			CommerceNavigator.gotoEntry(entryName = "MIN00674");

			CommercePriceLists.editPriceListEntryPrice(priceListEntryPrice = "150.00");

			SelectFrameTop();
		}

		task ("Then the Sorty By is going to show the products in order based on the Base Price") {
			ApplicationsMenu.gotoSite(site = "Minium");

			CommerceAcceleratorsInitializer.changeProductsSorting(sortingType = "Price High to Low");

			AssertTextEquals(
				key_index = 1,
				locator1 = "CommerceAccelerators#PRODUCT_CARD_NAME_BY_INDEX",
				value1 = "Cams");

			AssertTextEquals.assertPartialText(
				key_productName = "Cams",
