<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="false" dependency-injector="ds" mvcc-enabled="true" package-path="com.liferay.commerce.payment">
	<author>Luca Pellizzon</author>
	<namespace>Commerce</namespace>
	<entity external-reference-code="company" local-service="true" name="CommercePaymentEntry" remote-service="true">

		<!-- PK fields -->

		<column name="commercePaymentEntryId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="classNameId" type="long" />
		<column name="classPK" type="long" />
		<column name="commerceChannelId" type="long" />
		<column name="amount" type="BigDecimal" />
		<column name="callbackURL" type="String" />
		<column name="cancelURL" type="String" />
		<column name="currencyCode" type="String" />
		<column name="errorMessages" type="String" />
		<column name="languageId" type="String" />
		<column name="note" type="String" />
		<column name="payload" type="String" />
		<column name="paymentIntegrationKey" type="String" />
		<column name="paymentIntegrationType" type="int" />
		<column name="paymentStatus" type="int" />
		<column name="reasonKey" type="String" />
		<column localized="true" name="reasonName" type="String" />
		<column name="redirectURL" type="String" />
		<column name="transactionCode" type="String" />
		<column name="type" type="int" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="CompanyId" return-type="Collection">
			<finder-column name="companyId" />
		</finder>
		<finder name="C_C_C" return-type="Collection">
			<finder-column name="companyId" />
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
		</finder>
		<finder name="C_C_C_T" return-type="Collection">
			<finder-column name="companyId" />
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
			<finder-column name="type" />
		</finder>
		<finder name="C_C_C_P_T" return-type="Collection">
			<finder-column name="companyId" />
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
			<finder-column name="paymentStatus" />
			<finder-column name="type" />
		</finder>
	</entity>
	<entity local-service="true" name="CommercePaymentEntryAudit" remote-service="true">

		<!-- PK fields -->

		<column name="commercePaymentEntryAuditId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="commercePaymentEntryId" type="long" />
		<column name="amount" type="BigDecimal" />
		<column name="currencyCode" type="String" />
		<column name="logType" type="String" />
		<column name="logTypeSettings" type="String" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="CommercePaymentEntryId" return-type="Collection">
			<finder-column name="commercePaymentEntryId" />
		</finder>
	</entity>
	<entity local-service="true" name="CommercePaymentMethodGroupRel" remote-service="true">

		<!-- PK fields -->

		<column db-name="CPaymentMethodGroupRelId" name="commercePaymentMethodGroupRelId" primary="true" type="long" />

		<!-- Group instance -->

		<column name="groupId" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column localized="true" name="name" type="String" />
		<column localized="true" name="description" type="String" />
		<column name="active" type="boolean" />
		<column name="imageId" type="long" />
		<column name="paymentIntegrationKey" type="String" />
		<column name="priority" type="double" />
		<column name="typeSettings" type="String" />

		<!-- Order -->

		<order by="asc">
			<order-column name="priority" />
		</order>

		<!-- Finder methods -->

		<finder name="GroupId" return-type="Collection">
			<finder-column name="groupId" />
		</finder>
		<finder name="G_A" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="active" />
		</finder>
		<finder name="G_P" return-type="CommercePaymentMethodGroupRel" unique="true">
			<finder-column name="groupId" />
			<finder-column name="paymentIntegrationKey" />
		</finder>
	</entity>
	<entity local-service="true" name="CommercePaymentMethodGroupRelQualifier" remote-service="true" table="CPMethodGroupRelQualifier">

		<!-- PK fields -->

		<column db-name="CPMethodGroupRelQualifierId" name="commercePaymentMethodGroupRelQualifierId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="classNameId" type="long" />
		<column name="classPK" type="long" />
		<column db-name="CPaymentMethodGroupRelId" name="commercePaymentMethodGroupRelId" type="long" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="CommercePaymentMethodGroupRelId" return-type="Collection">
			<finder-column name="commercePaymentMethodGroupRelId" />
		</finder>
		<finder name="C_C" return-type="Collection">
			<finder-column name="classNameId" />
			<finder-column name="commercePaymentMethodGroupRelId" />
		</finder>
		<finder name="C_C_C" return-type="CommercePaymentMethodGroupRelQualifier" unique="true">
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
			<finder-column name="commercePaymentMethodGroupRelId" />
		</finder>
	</entity>
	<exceptions>
		<exception>CommercePaymentEntryAmount</exception>
		<exception>CommercePaymentEntryClassNameId</exception>
		<exception>CommercePaymentEntryClassPK</exception>
		<exception>CommercePaymentEntryCommerceChannelId</exception>
		<exception>CommercePaymentEntryPaymentIntegrationType</exception>
		<exception>CommercePaymentEntryPaymentStatus</exception>
		<exception>CommercePaymentEntryReasonKey</exception>
		<exception>CommercePaymentMethodGroupRelEngineKey</exception>
		<exception>CommercePaymentMethodGroupRelName</exception>
		<exception>DuplicateCommercePaymentMethodGroupRelQualifier</exception>
	</exceptions>
</service-builder>