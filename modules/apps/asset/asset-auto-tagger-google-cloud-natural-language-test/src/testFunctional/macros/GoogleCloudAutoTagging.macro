definition {

	@summary = "Default summary"
	macro enableImageAutoTagging() {
		var googleApiKey = PropsUtil.get("google.cloud.autotagging.service.key");

		Type(
			key_text = "apiKey",
			locator1 = "TextInput#ANY_PASSWORD",
			value1 = ${googleApiKey});

		FormFields.enableCheckbox(fieldName = "enabled");

		if (IsElementPresent(locator1 = "Button#UPDATE")) {
			PortletEntry.update();
		}
		else if (IsElementPresent(locator1 = "Button#SAVE")) {
			PortletEntry.save();
		}
	}

	@summary = "Default summary"
	macro enableTextAutoTagging(salience = null, confidence = null, assetType = null) {
		var googleApiKey = PropsUtil.get("google.cloud.autotagging.service.key");

		Type(
			key_text = "apiKey",
			locator1 = "TextInput#ANY_PASSWORD",
			value1 = ${googleApiKey});

		if (isSet(enableClassificationEndpoint)) {
			FormFields.enableCheckbox(fieldName = "Classification Endpoint Enabled");
		}

		if (isSet(confidence)) {
			SystemSettings.editTextSetting(
				settingName = "Confidence",
				settingValue = ${confidence});
		}

		if (isSet(enableEntityEndpoint)) {
			FormFields.enableCheckbox(fieldName = "Entity Endpoint Enabled");
		}

		if (isSet(salience)) {
			SystemSettings.editTextSetting(
				settingName = "Salience",
				settingValue = ${salience});
		}

		Click(locator1 = "Dropdown#TRIGGER");

		Click.javaScriptClick(
			key_menuItem = ${assetType},
			locator1 = "MenuItem#DROPDOWN_MENU_ITEM");

		if (IsElementPresent(locator1 = "Button#UPDATE")) {
			PortletEntry.update();
		}
		else if (IsElementPresent(locator1 = "Button#SAVE")) {
			PortletEntry.save();
		}
	}

	@summary = "Default summary"
	macro openToImageConfiguration(configurationScope = null) {
		var baseURL = PropsUtil.get("portal.url");

		if (${configurationScope} == "Instance Settings") {
			var portlet = "InstanceSettingsPortlet";
		}
		else {
			var portlet = "SystemSettingsPortlet";
		}

		Open(value1 = "${baseURL}/group/control_panel/manage?p_p_id=com_liferay_configuration_admin_web_portlet_${portlet}&_com_liferay_configuration_admin_web_portlet_${portlet}_factoryPid=com.liferay.document.library.asset.auto.tagger.google.cloud.vision.internal.configuration.GCloudVisionAssetAutoTagProviderCompanyConfiguration&_com_liferay_configuration_admin_web_portlet_${portlet}_mvcRenderCommandName=%2Fconfiguration_admin%2Fedit_configuration&_com_liferay_configuration_admin_web_portlet_${portlet}_pid=com.liferay.document.library.asset.auto.tagger.google.cloud.vision.internal.configuration.GCloudVisionAssetAutoTagProviderCompanyConfiguration");
	}

	@summary = "Default summary"
	macro openToTextConfiguration(configurationScope = null) {
		var baseURL = PropsUtil.get("portal.url");

		if (${configurationScope} == "Instance Settings") {
			var portlet = "InstanceSettingsPortlet";
		}
		else {
			var portlet = "SystemSettingsPortlet";
		}

		Open(value1 = "${baseURL}/group/control_panel/manage?p_p_id=com_liferay_configuration_admin_web_portlet_${portlet}&_com_liferay_configuration_admin_web_portlet_${portlet}_factoryPid=com.liferay.asset.auto.tagger.google.cloud.natural.language.internal.configuration.GCloudNaturalLanguageAssetAutoTaggerCompanyConfiguration&_com_liferay_configuration_admin_web_portlet_${portlet}_mvcRenderCommandName=%2Fconfiguration_admin%2Fedit_configuration&_com_liferay_configuration_admin_web_portlet_${portlet}_pid=com.liferay.asset.auto.tagger.google.cloud.natural.language.internal.configuration.GCloudNaturalLanguageAssetAutoTaggerCompanyConfiguration");
	}

}