<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="true" dependency-injector="ds" package-path="com.liferay.portal.security.audit.storage">
	<namespace>Audit</namespace>
	<entity cache-enabled="false" local-service="true" name="AuditEvent" remote-service="true">

		<!-- PK fields -->

		<column name="auditEventId" primary="true" type="long" />

		<!-- Group instance -->

		<column name="groupId" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />

		<!-- Other fields -->

		<column name="accountEntryId" type="long" />
		<column name="additionalInfo" type="String" />
		<column name="className" type="String" />
		<column name="classPK" type="String" />
		<column name="clientHost" type="String" />
		<column name="clientIP" type="String" />
		<column name="contextName" type="String" />
		<column name="correlationId" type="String" />
		<column name="eventType" type="String" />
		<column name="httpMethod" type="String" />
		<column name="impersonated" type="boolean" />
		<column name="impersonatedUserEmailAddress" type="String" />
		<column name="impersonatedUserId" type="long" />
		<column name="impersonatedUserName" type="String" />
		<column name="message" type="String" />
		<column name="objectName" type="String" />
		<column name="requestId" type="String" />
		<column name="requestIdGenerated" type="boolean" />
		<column name="resourceAction" type="String" />
		<column name="resourceType" type="String" />
		<column name="roles" type="String" />
		<column name="serverName" type="String" />
		<column name="serverPort" type="int" />
		<column name="sessionID" type="String" />
		<column name="userAgent" type="String" />
		<column name="userEmailAddress" type="String" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="CompanyId" return-type="Collection">
			<finder-column name="companyId" />
		</finder>
	</entity>
</service-builder>