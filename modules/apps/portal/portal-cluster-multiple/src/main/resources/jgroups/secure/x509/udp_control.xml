<config
	xmlns="urn:org:jgroups"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups-5.5.xsd"
>
	<UDP
		bind_addr="${cluster.link.bind.addr[&quot;cluster-link-control&quot;]}"
		mcast_addr="${multicast.group.address[&quot;cluster-link-control&quot;]}"
		mcast_port="${multicast.group.port[&quot;cluster-link-control&quot;]}"
	/>
	<!--ip_ttl="4"
			tos="8"
			ucast_recv_buf_size="5M"
			ucast_send_buf_size="5M"
			mcast_recv_buf_size="5M"
			mcast_send_buf_size="5M"
			max_bundle_size="64K"
			enable_diagnostics="true"
			thread_naming_pattern="cl"

			thread_pool.min_threads="0"
			thread_pool.max_threads="20"
			thread_pool.keep_alive_time="30000"/>-->
	<PING />
	<MERGE3
		max_interval="30000"
		min_interval="10000"
	/>
	<FD_SOCK />
	<FD_ALL />
	<VERIFY_SUSPECT timeout="1500" />
	<!--<BARRIER />-->
	<ASYM_ENCRYPT
		asym_algorithm="RSA"
		asym_keylength="512"
		change_key_on_coord_leave="false"
		change_key_on_leave="false"
		sym_algorithm="AES/CBC/PKCS5Padding"
		sym_iv_length="16"
		sym_keylength="128"
	/>
	<pbcast.NAKACK2 xmit_interval="500"
					xmit_table_num_rows="100"
					xmit_table_msgs_per_row="2000"
					xmit_table_max_compaction_time="30000"
					use_mcast_xmit="false"
					discard_delivered_msgs="true" />
	<UNICAST3
		conn_expiry_timeout="0"
		xmit_interval="500"
		xmit_table_max_compaction_time="60000"
		xmit_table_msgs_per_row="2000"
		xmit_table_num_rows="100"
	/>
	<pbcast.STABLE desired_avg_gossip="50000"
				   max_bytes="4M" />
	<AUTH
		auth_class="org.jgroups.auth.X509Token"
		auth_value="${cluster.link.auth.value}"
		cert_alias="${cluster.link.auth.cert.alias}"
		cert_password="${cluster.link.auth.cert.password}"
		cipher_type="${cluster.link.auth.cipher.type}"
		keystore_password="${cluster.link.auth.keystore.password}"
		keystore_path="${cluster.link.auth.keystore.path}"
		keystore_type="${cluster.link.auth.keystore.type}"
	/>
	<pbcast.GMS join_timeout="2000" print_local_addr="true" />
	<UFC
		max_credits="2M"
		min_threshold="0.4"
	/>
	<MFC
		max_credits="2M"
		min_threshold="0.4"
	/>
	<FRAG2 frag_size="60K" />
	<RSVP resend_interval="2000" timeout="10000" />
	<!--<pbcast.STATE_TRANSFER />-->
</config>