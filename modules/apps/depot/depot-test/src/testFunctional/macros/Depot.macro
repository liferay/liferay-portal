		if (isSet(viewOnly)) {
			AssertElementNotPresent(
				key_card = ${userScreenName},
				locator1 = "Card#CARD_ELLIPSIS");
		}
		else {
			AssertVisible(
				key_card = "${userFirstName} ${userLastName}",
				locator1 = "Card#CARD_ELLIPSIS");
		}
	}

