<html>
<head>
<title>ObjectPortlet</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ObjectPortlet</td></tr>
</thead>

<tbody>
	<tr>
		<td>ANY_PAGE</td>
		<td>//ul[contains(@class,'pagination')]//li[contains(@class,'page-item')]//*[contains(@class,'page-link')][normalize-space(text())='${key_pageNumber}']</td>
		<td></td>
	</tr>
	<tr>
		<td>ARROW_DOWN_ICON</td>
		<td>//th//div[contains(@class,'dropdown')]//button[contains(@class,'dropdown-toggle')]</td>
		<td></td>
	</tr>
	<tr>
		<td>CHECK_UNCHECK_DROPDOWN_ITEM</td>
		<td>//button[contains(@class,'dropdown-item') and contains(text(),'${key_dropdownItem}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>COLUMN_CHECK_UNCHECK_DROPDOWN_ITEM</td>
		<td>//button[contains(@class,'dropdown-item')]//*//div[contains(text(),'${key_dropdownItem}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>COLUMN_ICON_SEARCH</td>
		<td>//div[contains(@class,'dropdown-menu')]//span[contains(@class, 'input-group-inset-item')]</td>
		<td></td>
	</tr>
	<tr>
		<td>COLUMN_SEARCH_FIELD</td>
		<td>//div[contains(@class,'dropdown-menu')]//input[contains(@class,'form-control input-group-inset input-group-inset-after')]</td>
		<td></td>
	</tr>
	<tr>
		<td>CUSTOM_OBJECT_ON_CONTROL_PANEL</td>
		<td>//span[contains(@class,'c-inner') and contains(text(),'Custom Objects')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_COLUMN</td>
		<td>//th[contains(.,'${key_column}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_ID</td>
		<td>//tbody//div[contains(@class,'table-list-title')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_RICH_TEXT_EDITABLE</td>
		<td>//label[contains(.,'${key_fieldLabel}')]//following-sibling::div//div[contains(@class,'ck-editor__editable_inline') and @contenteditable = 'true' and contains(.,'${key_value}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_STATUS</td>
		<td>//*[text()='${key_entry}']/../following-sibling::td//*[text()='${key_status}']</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_VALUE</td>
		<td>//tbody//*[contains(text(),'${key_entry}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_VALUE_BY_POSITION</td>
		<td>//tbody//tr[${key_order}]//*[contains(text(),'${key_entry}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_VALUE_WITH_ELLIPSIS</td>
		<td>//tbody//span[contains(@class,'text-truncate') and contains(text(),'${key_entry}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_VALUE_SPECIFIC_ORDER</td>
		<td>//div[${resultOrder}]//tbody//*[contains(text(),'${key_entry}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_KEBAB_MENU</td>
		<td>//tbody//*[contains(text(),'${key_entry}')]/parent::td/following-sibling::td//button | //td[contains(., '${key_entry}')]/following-sibling::td//button</td>
		<td></td>
	</tr>
	<tr>
		<td>FIELD_ENTRY_COLUMN</td>
		<td>//th[contains(.,'${key_fieldLabelName}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>FIELD_LABEL_NAME</td>
		<td>//label[contains(text(),'${key_fieldLabelName}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>GENERIC_ENTRY_COLUMN</td>
		<td>//th[contains(.,'${key_fieldLabelName}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>INPUT_NAME</td>
		<td>//input[contains(@id,'_com_liferay_document_library_web_portlet_DLAdminPortlet_name')]</td>
		<td></td>
	</tr>
	<tr>
		<td>OBJECT_PORTLET_HEADER</td>
		<td>//h1[@data-qa-id='headerTitle' and contains (text(),'${key_objectLabel}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>DELETE_ENTRY_BUTTON</td>
		<td>//div[contains(@class,'show')]//button[contains(.,'Delete')]</td>
		<td></td>
	</tr>
	<tr>
		<td>NO_FIELDS_WERE_FOUND_MESSAGE</td>
		<td>//div[contains(@class,'dropdown-section text-muted') and contains (.,'No fields were found.')]</td>
		<td></td>
	</tr>
	<tr>
		<td>PAGINATION_ITEMS_PER_PAGE_SELECT</td>
		<td>//div[contains(@class,'pagination-items-per-page')]/button[contains(@class,'dropdown-toggle')]</td>
		<td></td>
	</tr>
	<tr>
		<td>SEARCH_FIELD</td>
		<td>//input[contains(@aria-label,'Search')][not(@data-qa-id='sideNavigationSearchInput')]</td>
		<td></td>
	</tr>
	<tr>
		<td>SEARCH_RELATIONSHIP_ENTRY</td>
		<td>//input[contains(@placeholder,'Search')][not(@data-qa-id='sideNavigationSearchInput')]</td>
		<td></td>
	</tr>
	<tr>
		<td>SEARCH_ENTRY_ON_RELATIONSHIP_FIELD_LABEL_SPECIFIC</td>
		<td>//label[contains(text(),'${key_relationshipFieldLabel}')]/..//input[contains(@placeholder,'Search')]</td>
		<td></td>
	</tr>
	<tr>
		<td>SELECT_CUSTOM_OBJECT</td>
		<td>//div[(@class='table-list-title')]//a[text()='${key_label}']</td>
		<td></td>
	</tr>
	<tr>
		<td>SELECT_OBJECT_FOLDER</td>
		<td>//li[contains(@class,'object-folder-list-item') and (.='${key_label}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>SELECT_OBJECT</td>
		<td>//div[(@class='table-list-title')]//a[text()= '${label}']</td>
		<td></td>
	</tr>
	<tr>
		<td>SELECT_FRAME_OBJECT</td>
		<td>//div[(@class='data-set-content-wrapper') and contains (.,'${key_frame}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>SELECT_SYSTEM_OBJECT</td>
		<td>//div[(@class='table-list-title')]//a[text()='${key_label}']</td>
		<td></td>
	</tr>
	<tr>
		<td>SORT_FIELD</td>
		<td>//th//span[contains(text(), '${key_sortFieldName}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_ENTRY_BUTTON</td>
		<td>//div[contains(@class,'show')]//a[contains(.,'View')]</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_ENTRY_DETAILS_LABEL</td>
		<td>//span[(@class='custom-control-label-text') and contains(.,'${key_entryLabel}')] |//label[contains(@class,'ddm-label') and contains(text(),'${key_entryLabel}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_ENTRY_DETAILS_VALUE</td>
		<td>//input[contains(@value, '${key_entryValue}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_ENTRY_EYE_BUTTON</td>
		<td>//a[contains(@class,'btn btn-secondary btn-sm link-monospaced')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ADD_OBJECT_ENTRY</td>
		<td>//input[@type = 'text']</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_FIELD_ON_MENU</td>
		<td>//span[text()='${key_itemMenu}']</td>
		<td></td>
	</tr>
	<tr>
		<td>OBJECT_FIELD_SELECTED</td>
		<td>//div[@class='form-control results-chosen select-field-trigger']//div[contains(text(),'${key_entrySelected}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_CLOB_KEBAB_MENU</td>
		<td>//tbody//td[contains(.,'${key_entry}')]/following-sibling::td//button</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_WIDGET_IN_PAGE_BUILDER_TOGGLE</td>
		<td>//span[text()='Show Widget in Page Builder']/preceding-sibling::span/input</td>
		<td></td>
	</tr>
	<tr>
		<td>ENABLE_CATEGORIZATION_BUTTON</td>
		<td>//span[text()='Enable Categorization of Object entries']/preceding-sibling::span/input</td>
		<td></td>
	</tr>
	<tr>
		<td>ENABLE_ENTRY_HISTORY_IN_AUDIT_FRAMEWORK_BUTTON</td>
		<td>//span[text()='Enable Entry History in Audit Framework']/preceding-sibling::span/input</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_EMPTY_LABEL_IN_DATE_ENTRY</td>
		<td>//input[(@placeholder='__/__/____')]</td>
		<td></td>
	</tr>
	<tr>
		<td>VIEW_EMPTY_LABEL_IN_DATE_TIME_ENTRY</td>
		<td>//input[(@placeholder='__/__/____ __:__ _')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_FIELD_GENERIC</td>
		<td>//div[contains(@data-field-name,'ObjectDefinitionsPortlet') and contains(label,'${key_customField}')]//input[1]</td>
		<td></td>
	</tr>
	<tr>
		<td>FILE_ENTRY_OBJECT</td>
		<td>//div[contains(@class, 'dropzone-wrapper')]//div//..//div[contains(text(), '${key_infoText}')]</td>
		<td></td>
	</tr>
	<tr>
		<td>DELETE_RELATIONSHIP_ENTRY</td>
		<td>//td[contains(text(),'${key_entryName}')]/..//a[@title = 'Delete']</td>
		<td></td>
	</tr>
	<tr>
		<td>ARROW_ORDER_COLUMN</td>
		<td>//th[contains(.,'${key_orderColumn}')]//button[contains(@class,'component-action')]//*[contains(@class,'lexicon-icon-order')]</td>
		<td></td>
	</tr>
	<tr>
		<td>ENTRY_READ_ONLY</td>
		<td>//div[contains(@class,'ddm-field')]//input[contains(@value, '${key_entry}') and @readonly]</td>
		<td></td>
	</tr>
</tbody>
</table>
</body>
</html>