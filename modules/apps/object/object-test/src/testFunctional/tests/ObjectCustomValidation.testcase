				fieldType = "Date",
				isRequired = "false",
				objectName = "CustomObject156702");

			ObjectAdmin.publishObjectViaAPI(objectName = "CustomObject156702");
		}

		task ("Add a Custom Validation using an expression 'Range' (via API)") {
			JSONObject.addObjectValidation(
				labelName = "Custom validation",
				objectName = "CustomObject156702",
				script = "futureDates(customDate, '2022-06-01') AND pastDates(customDate, '2022-06-30')",
				validationType = "ddm");
		}

		task ("Assert that Custom Validation with 'Range' is working") {
