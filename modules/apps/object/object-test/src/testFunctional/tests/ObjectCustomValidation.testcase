	@description = "LPS-144474 - Verify that, when updating an existing validation, this validation must only affect the entries added after the validation update"
	@priority = 4
	test CanUpdateValidation {
		property test.liferay.virtual.instance = "false";
		property test.run.type = "single";

		task ("Given a custom object definition with a text field") {
			ObjectAdmin.addObjectViaAPI(
				labelName = "Custom Object 192647",
				objectName = "CustomObject192647",
				pluralLabelName = "Custom Objects 192647");

			ObjectAdmin.addObjectFieldViaAPI(
				fieldBusinessType = "Text",
				fieldLabelName = "Text",
				fieldName = "text",
				fieldType = "String",
				isRequired = "false",
				objectName = "CustomObject192647");

			ObjectAdmin.publishObjectViaAPI(objectName = "CustomObject192647");
		}

		task ("and Given a expression builder validation set to full validation (via API)") {
			JSONObject.addObjectValidation(
				labelName = "Custom validation",
				objectName = "CustomObject192647",
				script = "NOT(contains(text, 'lazy'))",
				validationType = "ddm");
		}

		task ("and Given a valid object entry") {
			ObjectAdmin.addObjectSingleFieldEntryViaAPI(
				fieldName = "text",
				objectName = "CustomObject192647",
				value = "Quick brown fox");
		}

		task ("Go to Custom Objects and Validations tab") {
			ObjectAdmin.openObjectAdmin();

			ObjectPortlet.selectCustomObject(label = "Custom Object 192647");

			ObjectAdmin.goToValidationsTab();
		}

		task ("When editing the custom validation") {
			ObjectCustomValidation.gotoCustomValidation(validationName = "Custom validation");

			ObjectCustomValidation.editLabelOnCustomValidation(editValidationName = "Custom validation updated");

			ObjectCustomValidation.gotoTab(tabName = "Conditions");

			ObjectCustomValidation.insertScriptOnValidation(scriptValidation = "NOT(contains(text, 'dog'))");

			ObjectCustomValidation.addErrorMessage(errorMessage = "This entry is not valid for text entry, the field contains the word: dog.");

			PortletEntry.save();
		}

		task ("When the user changes the validation logic and attempts to create an invalid object entry") {
			ObjectAdmin.goToCustomObject(objectName = "CustomObject192647");

			ObjectPortlet.addSingleFieldEntryViaUI(
				entry = "Lazy dog",
				invalidEntry = "true");
		}

		task ("Then the invalid object entry isn't added and the existing object entry isn't affected") {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#ERROR",
				value1 = "This entry is not valid for text entry, the field contains the word: dog.");

			ObjectAdmin.goToCustomObject(objectName = "CustomObject192647");

			ObjectPortlet.assertEntryNotPresent(entry = "Lazy dog");

			ObjectPortlet.viewEntry(entry = "Quick brown fox");
		}
	}

	@description = "LPS-144474 - Verify that, when editing an entry in an Object, the user only is able to update the entry successfully if it passes for all validations from that Object"
	@priority = 4
	test CanUpdateWhenPassesForAllValidations {
		property test.liferay.virtual.instance = "false";
		property test.run.type = "single";

		ObjectAdmin.addObjectViaAPI(
			labelName = "Custom Object 153558",
			objectName = "CustomObject153558",
			pluralLabelName = "Custom Objects 153558");

		ObjectAdmin.addObjectFieldViaAPI(
			fieldBusinessType = "Text",
			fieldLabelName = "Custom Field",
			fieldName = "customField",
			fieldType = "String",
			isRequired = "false",
			objectName = "CustomObject153558");

		JSONObject.addObjectValidation(
			labelName = "Custom validation",
			objectName = "CustomObject153558",
			script = "invalidFields = (customField == 'Decline Entry')",
			validationType = "groovy");

		ObjectAdmin.publishObjectViaAPI(objectName = "CustomObject153558");

		ObjectAdmin.addObjectSingleFieldEntryViaAPI(
			fieldName = "customField",
			objectName = "CustomObject153558",
			value = "Entry Test");

		ObjectAdmin.goToCustomObject(objectName = "CustomObject153558");

		ObjectPortlet.viewEntryDetails(entry = "Entry Test");

		ObjectAdmin.editEntryName(newEntryValue = "Decline Entry");

		ObjectAdmin.goToCustomObject(objectName = "CustomObject153558");

		ObjectPortlet.assertEntryNotPresent(entry = "Decline Entry");

		ObjectPortlet.viewEntryDetails(entry = "Entry Test");

		ObjectAdmin.editEntryName(newEntryValue = "Update Entry");

		ObjectAdmin.goToCustomObject(objectName = "CustomObject153558");

		ObjectPortlet.viewEntry(entry = "Update Entry");
	}

