{
	"fieldSets": [
		{
			"fields": [
				{
					"defaultValue": {
						"categoryTreeNodeType": "Category",
						"externalReferenceCode": "category-erc"
					},
					"name": "categoryByExternalReferenceCode",
					"type": "categoryTreeNodeSelector",
					"typeOptions": {
						"dependency": {
							"checkboxTrue": {
								"type": "equal",
								"value": "true"
							}
						}
					}
				},
				{
					"defaultValue": {
						"categoryTreeNodeType": "Category",
						"externalReferenceCode": "category-erc-and-scope-erc",
						"scopeExternalReferenceCode": "category-scope-erc"
					},
					"name": "categoryByExternalReferenceCodeAndScope",
					"type": "categoryTreeNodeSelector"
				},
				{
					"defaultValue": {
						"categoryTreeNodeId": "${CATEGORY_ID}",
						"categoryTreeNodeType": "Category",
						"externalReferenceCode": "${CATEGORY_ERC}",
						"title": "${CATEGORY_NAME}"
					},
					"name": "categoryByResolvableExternalReferenceCode",
					"type": "categoryTreeNodeSelector"
				},
				{
					"defaultValue": {
						"categoryTreeNodeId": "${CATEGORY_ID}",
						"categoryTreeNodeType": "Category",
						"externalReferenceCode": "${CATEGORY_ERC}",
						"title": "${CATEGORY_NAME}"
					},
					"name": "categoryByResolvableExternalReferenceCodeAndCurrentSiteScope",
					"type": "categoryTreeNodeSelector"
				},
				{
					"defaultValue": false,
					"name": "checkboxFalse",
					"type": "checkbox",
					"typeOptions": {
						"dependency": {
							"checkboxTrue": {
								"type": "not-equal",
								"value": "false"
							}
						},
						"displayType": "checkbox"
					}
				},
				{
					"defaultValue": true,
					"name": "checkboxTrue",
					"type": "checkbox",
					"typeOptions": {
						"displayType": "toggle"
					}
				},
				{
					"defaultValue": {
						"className": "com.liferay.journal.model.JournalArticle",
						"classNameId": "${JOURNAL_ARTICLE_CLASS_NAME_ID}",
						"externalReferenceCode": "item-erc"
					},
					"name": "itemByExternalReferenceCode",
					"type": "itemSelector",
					"typeOptions": {
						"className": "com.liferay.journal.model.JournalArticle",
						"dependency": {
							"checkboxTrue": {
								"type": "equal",
								"value": "true"
							}
						},
						"enableSelectTemplate": true,
						"itemSubtype": "BASIC-WEB-CONTENT",
						"itemType": "com.liferay.journal.model.JournalArticle",
						"mimeTypes": [
							"image/jpeg",
							"image/png"
						]
					}
				},
				{
					"defaultValue": {
						"className": "com.liferay.journal.model.JournalArticle",
						"classNameId": "${JOURNAL_ARTICLE_CLASS_NAME_ID}",
						"externalReferenceCode": "item-erc-and-scope-erc",
						"scopeExternalReferenceCode": "item-scope-erc"
					},
					"name": "itemByExternalReferenceCodeAndScope",
					"type": "itemSelector"
				},
				{
					"defaultValue": {
						"className": "com.liferay.journal.model.JournalArticle",
						"classNameId": "${JOURNAL_ARTICLE_CLASS_NAME_ID}",
						"classPK": "${JOURNAL_ARTICLE_RESOURCE_PRIM_KEY}",
						"externalReferenceCode": "${JOURNAL_ARTICLE_EXTERNAL_REFERENCE_CODE}"
					},
					"name": "itemByResolvableExternalReferenceCode",
					"type": "itemSelector"
				},
				{
					"defaultValue": {
						"className": "com.liferay.journal.model.JournalArticle",
						"classNameId": "${JOURNAL_ARTICLE_CLASS_NAME_ID}",
						"classPK": "${JOURNAL_ARTICLE_RESOURCE_PRIM_KEY}",
						"externalReferenceCode": "${JOURNAL_ARTICLE_EXTERNAL_REFERENCE_CODE}"
					},
					"name": "itemByResolvableExternalReferenceCodeAndCurrentSiteScope",
					"type": "itemSelector"
				},
				{
					"defaultValue": "detailed",
					"name": "selectWithLabels",
					"type": "select",
					"typeOptions": {
						"dependency": {
							"checkboxTrue": {
								"type": "equal",
								"value": "true"
							}
						},
						"validValues": [
							{
								"label": "Compact",
								"value": "compact"
							},
							{
								"label": "Detailed",
								"value": "detailed"
							}
						]
					}
				},
				{
					"defaultValue": "lg",
					"name": "selectWithoutLabels",
					"type": "select",
					"typeOptions": {
						"dependency": {
							"selectWithLabels": {
								"type": "not-equal",
								"value": "compact"
							}
						},
						"validValues": [
							{
								"value": "sm"
							},
							{
								"value": "lg"
							}
						]
					}
				},
				{
					"defaultValue": "Default text",
					"name": "text",
					"type": "text"
				},
				{
					"defaultValue": "submit",
					"localizable": true,
					"name": "textLocalizable",
					"type": "text"
				},
				{
					"defaultValue": "Visible text",
					"name": "textVisibleWhenText",
					"type": "text",
					"typeOptions": {
						"dependency": {
							"text": {
								"type": "equal",
								"value": "Default text"
							}
						}
					}
				},
				{
					"defaultValue": "test@liferay.com",
					"name": "textWithEmailValidation",
					"type": "text",
					"typeOptions": {
						"validation": {
							"type": "email"
						}
					}
				},
				{
					"defaultValue": "5",
					"name": "textWithNumberValidation",
					"type": "text",
					"typeOptions": {
						"validation": {
							"max": 10,
							"min": 1,
							"type": "number"
						}
					}
				},
				{
					"defaultValue": "abc",
					"name": "textWithPatternValidation",
					"type": "text",
					"typeOptions": {
						"validation": {
							"regexp": "^[a-z]+$",
							"type": "pattern"
						}
					}
				},
				{
					"defaultValue": "Valid",
					"name": "textWithTextValidation",
					"type": "text",
					"typeOptions": {
						"placeholder": "Type a text",
						"validation": {
							"errorMessage": "The text must have between 3 and 20 characters.",
							"maxLength": 20,
							"minLength": 3,
							"required": true,
							"type": "text"
						}
					}
				},
				{
					"defaultValue": {
						"categoryTreeNodeType": "Vocabulary",
						"externalReferenceCode": "vocabulary-erc"
					},
					"name": "vocabularyByExternalReferenceCode",
					"type": "categoryTreeNodeSelector"
				},
				{
					"defaultValue": {
						"categoryTreeNodeType": "Vocabulary",
						"externalReferenceCode": "vocabulary-erc-and-scope-erc",
						"scopeExternalReferenceCode": "vocabulary-scope-erc"
					},
					"name": "vocabularyByExternalReferenceCodeAndScope",
					"type": "categoryTreeNodeSelector"
				},
				{
					"defaultValue": {
						"categoryTreeNodeId": "${VOCABULARY_ID}",
						"categoryTreeNodeType": "Vocabulary",
						"externalReferenceCode": "${VOCABULARY_ERC}",
						"title": "${VOCABULARY_TITLE}"
					},
					"name": "vocabularyByResolvableExternalReferenceCode",
					"type": "categoryTreeNodeSelector"
				},
				{
					"defaultValue": {
						"categoryTreeNodeId": "${VOCABULARY_ID}",
						"categoryTreeNodeType": "Vocabulary",
						"externalReferenceCode": "${VOCABULARY_ERC}",
						"title": "${VOCABULARY_TITLE}"
					},
					"name": "vocabularyByResolvableExternalReferenceCodeAndCurrentSiteScope",
					"type": "categoryTreeNodeSelector"
				}
			]
		}
	]
}