<html>
<head>
<title>DigitalSignatureListView</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">DigitalSignatureListView</td></tr>
</thead>

<tbody>
<tr>
	<td>DIGITAL_SIGNATURE_ENVELOPE_STATUS</td>
	<td>//tr[.//a[normalize-space(.) = '${envelopeName}']]//span[contains(@class, 'label-item') and contains(., '${dsStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ENVELOPE_RECIPIENTS_BADGE</td>
	<td>//tr[contains(., '${envelopeName}')]//span[contains(@class, 'badge-item')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ITEMS_PER_PAGE</td>
	<td>//button[@aria-label = 'Items Per Page']</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ITEMS_PER_PAGE_OPTION</td>
	<td>//div[contains(@class, 'dropdown-menu-select')]//button[@role = 'option' and normalize-space(.) = '${key_itemsPerPage} items']</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_NAVIGATE_NEXT</td>
	<td>//*[contains(@aria-label, 'Go to the next page')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ENVELOPE_ID</td>
	<td>//div[contains(@class, 'envelope-view__details') and contains(., 'Envelope ID')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ENVELOPE_DELETE_URL</td>
	<td>//div[contains(@class, 'envelope-view')]//input[@type = 'hidden']</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ADD_RECIPIENT</td>
	<td>//button[contains(@class, 'mb-4 btn btn-unstyled')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_EXTRA_RECIPIENT_NAME</td>
	<td>//input[contains(@id,'recipients[1].fullName')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_EXTRA_RECIPIENT_EMAIL</td>
	<td>//input[contains(@id,'recipients[1].email')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ENVELOPE_NAME</td>
	<td>//a[normalize-space(.) = '${envelopeName}']</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_DOWNLOAD_BUTTON</td>
	<td>//button[contains(@type, 'button') and contains(., 'Download')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ELLIPSIS_BUTTON</td>
	<td>//tr[.//a[normalize-space(.) = '${envelopeName}']]//button[contains(@class, 'dropdown')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_DOWNLOAD_BY_LIST</td>
	<td>//div[contains(@class, 'dropdown-menu')]//button[contains(., 'Download')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_ENVELOPE_CREATE_DATE</td>
	<td>//tr[contains(., '${envelopeName}')]//td[contains(., 'ago')]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_SIGNATURE_LOADING_INDICATOR</td>
	<td>//div[contains(@class, 'envelope-list')]//span[contains(@class, 'loading-animation')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>