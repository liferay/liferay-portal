package com.liferay.source.formatter.dependencies;

/**
 * @author Shuyang Zhou
 */
public class GetFetchLocalServiceImpl {

	public Entity fetchEntity(long entityId) {
		return entityPersistence.fetchByPrimaryKey(entityId);
	}

	public Entity getDirectFetch(long entityId) {
		return entityPersistence.fetchByPrimaryKey(entityId);
	}

	public int getEntityCount() {
		return entityPersistence.countAll();
	}

	public Entity getFind(long entityId) throws PortalException {
		return entityPersistence.findByPrimaryKey(entityId);
	}

	public Entity getGuarded(long entityId) {
		if (entityId <= 0) {
			return null;
		}

		return entityPersistence.fetchByPrimaryKey(entityId);
	}

}
