package com.liferay.source.formatter.dependencies;

import com.liferay.petra.sql.dsl.ast.ASTNodeListener;
import com.liferay.petra.sql.dsl.query.DSLQuery;

import java.util.List;

/**
 * @author Shuyang Zhou
 */
public class ToSQLCall {

	public void method1(ASTNodeListener astNodeListener, DSLQuery dslQuery) {
		dslQuery.toSQL(astNodeListener);
	}

	public void method2(ASTNodeListener astNodeListener, DSLQuery dslQuery) {
		dslQuery.toSQL(
			string -> {
			},
			astNodeListener);
	}

	public String method3(ASTNodeListener astNodeListener, DSLQuery dslQuery) {
		return dslQuery.toSQL(astNodeListener);
	}

	public int method4(ASTNodeListener astNodeListener, DSLQuery dslQuery) {
		String sql = dslQuery.toSQL(astNodeListener);

		return sql.length();
	}

	public void method5(
		ASTNodeListener astNodeListener, DSLQuery dslQuery, List<String> sqls) {

		sqls.add(dslQuery.toSQL(astNodeListener));
	}

	public String method6(
		ASTNodeListener astNodeListener, DSLQuery dslQuery, String prefix) {

		return prefix + dslQuery.toSQL(astNodeListener);
	}

}