package com.liferay.source.formatter.dependencies.upgrade;

import com.liferay.mail.kernel.model.MailMessage;

import java.io.File;

import org.apache.commons.io.FileUtils;

/**
 * @author Jessyca Ferreira
 */
public class LPD_61575 {

	public void method(File file, String nameFile) {
		MailMessage mailMessage = null;

		mailMessage.addFileAttachment(file, nameFile);
		mailMessage.addFileAttachment(null, nameFile);
		mailMessage.addFileAttachment(
			"test.txt", FileUtils.openInputStream(file));
	}

}