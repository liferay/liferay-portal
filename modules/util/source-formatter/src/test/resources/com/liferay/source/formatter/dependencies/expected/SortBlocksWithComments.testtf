# Bucket for assets
# Shared with the CDN

resource "aws_s3_bucket" "assets" {
	bucket="assets"
}

# Bucket for backups

resource "aws_s3_bucket" "backups" {
	bucket="backups"
}

/*
 * Bucket for config
 */

resource "aws_s3_bucket" "config" {
	bucket="config"
}

# Bucket for logs

resource "aws_s3_bucket" "logs" {
	bucket="logs"
}

// Bucket for media

resource "aws_s3_bucket" "media" {
	bucket="media"
}