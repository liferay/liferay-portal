package com.liferay.source.formatter.dependencies;

import com.liferay.petra.function.UnsafeRunnable;
import com.liferay.petra.lang.SafeCloseable;

import java.util.function.Supplier;

/**
 * @author Shuyang Zhou
 */
public class EmptySafeCloseable {

	public SafeCloseable method1() {
		return () -> {
		};
	}

	public SafeCloseable method2(boolean value) {
		return value ? _EMPTY_SAFE_CLOSEABLE :
			() -> {
			};
	}

	public void method3(boolean value) {
		SafeCloseable safeCloseable1 = () -> {
		};

		safeCloseable1.close();

		SafeCloseable safeCloseable2 = value ? _EMPTY_SAFE_CLOSEABLE :
			() -> {
			};

		safeCloseable2.close();
	}

	public void method4() {
		_safeCloseable = () -> {

			// There is nothing to close.

		};
	}

	public Runnable method5() {
		return () -> {
		};
	}

	public void method6() throws Exception {
		Runnable runnable = () -> {
		};

		runnable.run();

		UnsafeRunnable<Exception> unsafeRunnable = () -> {
		};

		unsafeRunnable.run();
	}

	public SafeCloseable method7() {
		return () -> {
			if (_safeCloseable != null) {
				_safeCloseable.close();
			}
		};
	}

	public Supplier<SafeCloseable> method8() {
		return () -> {
			_safeCloseable.close();

			return () -> {
			};
		};
	}

	public void method9() {
		_close(
			() -> {
			});
	}

	public NestedSafeCloseable method10() {
		return () -> {
		};
	}

	public void method11() {
		this._safeCloseable = () -> {
		};
	}

	private void _close(SafeCloseable safeCloseable) {
		safeCloseable.close();
	}

	private static final SafeCloseable _EMPTY_SAFE_CLOSEABLE = () -> {
	};

	private SafeCloseable _safeCloseable;

	private interface NestedSafeCloseable extends SafeCloseable {
	}

}