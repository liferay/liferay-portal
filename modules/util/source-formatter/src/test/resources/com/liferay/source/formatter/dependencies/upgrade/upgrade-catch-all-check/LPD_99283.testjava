package com.liferay.source.formatter.dependencies.upgrade;

import org.osgi.service.component.annotations.Reference;

/**
 * @author Liferay
 */
public class LPD_99283 {

	public void method(
		long cpDefinitionSpecificationOptionValueId, long cpOptionCategoryId,
		Map<Locale, String> valueMap, double priority,
		ServiceContext serviceContext) {

		CPDefinitionSpecificationOptionValueLocalServiceUtil.
			updateCPDefinitionSpecificationOptionValue(
				123, cpOptionCategoryId, valueMap, priority, serviceContext);
		CPDefinitionSpecificationOptionValueLocalServiceUtil.
			updateCPDefinitionSpecificationOptionValue(
				cpDefinitionSpecificationOptionValueId, cpOptionCategoryId,
				valueMap, priority, serviceContext);
		CPDefinitionSpecificationOptionValueServiceUtil.
			updateCPDefinitionSpecificationOptionValue(
				cpDefinitionSpecificationOptionValueId, cpOptionCategoryId,
				valueMap, priority, serviceContext);
		_cpDefinitionSpecificationOptionValueLocalService.
			updateCPDefinitionSpecificationOptionValue(
				cpDefinitionSpecificationOptionValueId, cpOptionCategoryId,
				valueMap, priority, serviceContext);
		_cpDefinitionSpecificationOptionValueService.
			updateCPDefinitionSpecificationOptionValue(
				cpDefinitionSpecificationOptionValueId, cpOptionCategoryId,
				valueMap, priority, serviceContext);
	}

	@Reference
	private CPDefinitionSpecificationOptionValueLocalService
		_cpDefinitionSpecificationOptionValueLocalService;

	@Reference
	private CPDefinitionSpecificationOptionValueService
		_cpDefinitionSpecificationOptionValueService;

}