package com.liferay.source.formatter.dependencies;

import java.io.InputStream;

import java.security.KeyStore;

/**
 * @author Pedro Victor Silvestre
 */
public class CredentialBuffer {

	public KeyStore.Entry method1(
			KeyStore keyStore, String alias, String credential)
		throws Exception {

		return keyStore.getEntry(
			alias, new KeyStore.PasswordProtection(credential.toCharArray()));
	}

	public void method2(Mac mac, String credential) throws Exception {
		mac.init(new SecretKeySpec(credential.getBytes(), "HmacSHA512"));
	}

	public void method3(
			KeyStore keyStore, InputStream inputStream, String credential)
		throws Exception {

		keyStore.load(inputStream, credential.toCharArray());
	}

	public void method4(String credential) {
		System.out.println(credential.getBytes());
	}

	public void method5(
			KeyStore keyStore, InputStream inputStream, String credential)
		throws Exception {

		char[] credentialChars = credential.toCharArray();

		keyStore.load(inputStream, credentialChars);
	}

}