run "verify" {
	command=plan
}

run "setup" {
	command=apply
}
resource "terraform_data" "setup" {
	provisioner "remote-exec" {
		inline=["echo b"]
	}

	provisioner "file" {
		destination="/tmp/a"
		source="a"
	}
	input="setup"
}
build {
	post-processors {
		post-processor "shell-local" {
			inline=["echo b"]
		}

		post-processor "manifest" {
			output="manifest.json"
		}
	}
}