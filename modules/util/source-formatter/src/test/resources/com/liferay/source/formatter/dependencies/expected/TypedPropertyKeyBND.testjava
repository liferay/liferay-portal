package com.liferay.source.formatter.dependencies;

import aQute.bnd.header.Attrs;

/**
 * @author Shuyang Zhou
 */
public class TypedPropertyKeyBND {

	public Attrs parse() {
		Attrs attrs = new Attrs();

		attrs.put("resource.bundle.aggregate:String", "a");

		return attrs;
	}

}