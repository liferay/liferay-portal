package com.liferay.source.formatter.dependencies;

import java.net.Socket;

import java.security.KeyStore;
import java.security.cert.X509Certificate;

import javax.net.ssl.HostnameVerifier;
import javax.net.ssl.HttpsURLConnection;
import javax.net.ssl.SSLEngine;
import javax.net.ssl.SSLParameters;
import javax.net.ssl.SSLSession;
import javax.net.ssl.X509ExtendedTrustManager;
import javax.net.ssl.X509TrustManager;

import org.apache.http.conn.ssl.AllowAllHostnameVerifier;
import org.apache.http.conn.ssl.NoopHostnameVerifier;
import org.apache.http.conn.ssl.SSLConnectionSocketFactory;
import org.apache.http.conn.ssl.TrustAllStrategy;
import org.apache.http.conn.ssl.TrustSelfSignedStrategy;
import org.apache.http.impl.client.HttpClientBuilder;
import org.apache.http.ssl.SSLContextBuilder;

/**
 * @author Caio Farias
 */
public class FIPSTLSVerification1 {

	public FIPSTLSVerification1(HttpClientBuilder httpClientBuilder) {
		httpClientBuilder.setSSLHostnameVerifier(NoopHostnameVerifier.INSTANCE);
	}

	public void allowAllHostnameVerifierConstant(
		HttpClientBuilder httpClientBuilder) {

		httpClientBuilder.setSSLHostnameVerifier(
			SSLConnectionSocketFactory.ALLOW_ALL_HOSTNAME_VERIFIER);
	}

	public void allowAllHostnameVerifierInstance(
		HttpClientBuilder httpClientBuilder) {

		httpClientBuilder.setSSLHostnameVerifier(
			new AllowAllHostnameVerifier());
	}

	public void anonymousHostnameVerifier(HttpClientBuilder httpClientBuilder) {
		httpClientBuilder.setSSLHostnameVerifier(
			new HostnameVerifier() {

				@Override
				public boolean verify(String hostName, SSLSession sslSession) {
					return true;
				}

			});
	}

	public void blankEndpointIdentificationAlgorithm(
		SSLParameters sslParameters) {

		sslParameters.setEndpointIdentificationAlgorithm("");
	}

	public void commentedBypass(HttpClientBuilder httpClientBuilder) {

		// httpClientBuilder.setSSLHostnameVerifier(
		// 	NoopHostnameVerifier.INSTANCE);

	}

	public void commentedGuard(HttpClientBuilder httpClientBuilder) {

		// if (PropsValues.FIPS_ENABLED) {

		httpClientBuilder.setSSLHostnameVerifier(NoopHostnameVerifier.INSTANCE);
	}

	public void documented(
		HttpClientBuilder httpClientBuilder,
		HostnameVerifier hostnameVerifier) {

		// Do not use NoopHostnameVerifier here

		httpClientBuilder.setSSLHostnameVerifier(hostnameVerifier);
	}

	public void endpointIdentificationAlgorithm(SSLParameters sslParameters) {
		sslParameters.setEndpointIdentificationAlgorithm(null);
	}

	public String getBypassName() {
		return "NoopHostnameVerifier";
	}

	public HostnameVerifier getHostnameVerifier() {
		return _hostnameVerifier;
	}

	public X509ExtendedTrustManager getX509ExtendedTrustManager() {
		return new X509ExtendedTrustManager() {

			@Override
			public void checkClientTrusted(
				X509Certificate[] x509Certificates, String authType) {
			}

			@Override
			public void checkClientTrusted(
				X509Certificate[] x509Certificates, String authType,
				Socket socket) {
			}

			@Override
			public void checkClientTrusted(
				X509Certificate[] x509Certificates, String authType,
				SSLEngine sslEngine) {
			}

			@Override
			public void checkServerTrusted(
				X509Certificate[] x509Certificates, String authType) {
			}

			@Override
			public void checkServerTrusted(
				X509Certificate[] x509Certificates, String authType,
				Socket socket) {
			}

			@Override
			public void checkServerTrusted(
				X509Certificate[] x509Certificates, String authType,
				SSLEngine sslEngine) {
			}

			@Override
			public X509Certificate[] getAcceptedIssuers() {
				return null;
			}

		};
	}

	public X509TrustManager getX509TrustManager() {
		return new X509TrustManager() {

			@Override
			public void checkClientTrusted(
				X509Certificate[] x509Certificates, String authType) {
			}

			@Override
			public void checkServerTrusted(
				X509Certificate[] x509Certificates, String authType) {
			}

			@Override
			public X509Certificate[] getAcceptedIssuers() {
				return null;
			}

		};
	}

	public void lambdaHostnameVerifier(HttpClientBuilder httpClientBuilder) {
		httpClientBuilder.setSSLHostnameVerifier(
			(hostName, sslSession) -> true);
	}

	public void noopHostnameVerifier(HttpClientBuilder httpClientBuilder) {
		httpClientBuilder.setSSLHostnameVerifier(NoopHostnameVerifier.INSTANCE);
	}

	public void pinnedTrustAnchor(
			SSLContextBuilder sslContextBuilder, KeyStore keyStore)
		throws Exception {

		sslContextBuilder.loadTrustMaterial(keyStore, null);
	}

	public void quotedBlockComment(HttpClientBuilder httpClientBuilder) {
		httpClientBuilder.setSSLHostnameVerifier(NoopHostnameVerifier.INSTANCE);

		httpClientBuilder.setUserAgent("*/*");
	}

	public void quotedSlashes(HttpClientBuilder httpClientBuilder) {
		httpClientBuilder.setSSLHostnameVerifier(
			"https://example.com", NoopHostnameVerifier.INSTANCE);
	}

	public void selfSignedTrustStrategy(SSLContextBuilder sslContextBuilder)
		throws Exception {

		sslContextBuilder.loadTrustMaterial(new TrustSelfSignedStrategy());
	}

	public void strictHostnameVerifier(
		HttpClientBuilder httpClientBuilder,
		HostnameVerifier hostnameVerifier) {

		httpClientBuilder.setSSLHostnameVerifier(hostnameVerifier);
	}

	public void trustAllStrategy(SSLContextBuilder sslContextBuilder)
		throws Exception {

		sslContextBuilder.loadTrustMaterial(new TrustAllStrategy());
	}

	private static final HostnameVerifier _hostnameVerifier =
		NoopHostnameVerifier.INSTANCE;

	static {
		HttpsURLConnection.setDefaultHostnameVerifier(
			NoopHostnameVerifier.INSTANCE);
	}

}