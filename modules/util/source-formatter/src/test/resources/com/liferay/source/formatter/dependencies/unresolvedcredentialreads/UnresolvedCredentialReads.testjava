package com.liferay.source.formatter.dependencies.unresolvedcredentialreads;

import com.liferay.portal.configuration.SecretResolverConfiguration;
import com.liferay.portal.kernel.util.Validator;
import com.liferay.portal.security.key.secret.SecretResolver;
import com.liferay.portal.security.key.secret.SecretResolverUtil;

/**
 * @author Alan Huang
 */
public class UnresolvedCredentialReads {

	public UnresolvedCredentialReads(
		SecretResolver secretResolver,
		SecretResolverConfiguration secretResolverConfiguration) {

		_secretResolver = secretResolver;
		_secretResolverConfiguration = secretResolverConfiguration;
	}

	public String getAssignedPassword() {
		String password = _secretResolverConfiguration.password();

		return "Basic " + password;
	}

	public String getAssignedResolvedPassword(long companyId) {
		String password = _secretResolverConfiguration.password();

		return SecretResolverUtil.resolve(companyId, password);
	}

	public String getFieldResolvedPassword(long companyId) {
		_password = _secretResolverConfiguration.password();

		_password = SecretResolverUtil.resolve(companyId, _password);

		return _password;
	}

	public String getHolderResolvedPassword(
		long companyId, PasswordHolder passwordHolder) {

		String password = _secretResolverConfiguration.password();

		passwordHolder.password = SecretResolverUtil.resolve(
			companyId, passwordHolder.password);

		return password;
	}

	public String getIdentifiedResolvedPassword(long companyId) {
		return SecretResolverUtil.resolve(
			companyId, "password", _secretResolverConfiguration.password());
	}

	public String getParameterPassword(
		SecretResolverConfiguration secretResolverConfiguration) {

		return secretResolverConfiguration.password();
	}

	public String getPassword() {
		return _secretResolverConfiguration.password();
	}

	public String getResolvedPassword(long companyId) {
		return SecretResolverUtil.resolve(
			companyId, _secretResolverConfiguration.password());
	}

	public String getSecretResolverResolvedPassword(long companyId) {
		return _secretResolver.resolve(
			companyId, _secretResolverConfiguration.password());
	}

	public String getUserName() {
		return _secretResolverConfiguration.userName();
	}

	public String getWrongResolverResolvedPassword(
		long companyId, Resolver resolver) {

		return resolver.resolve(
			companyId, _secretResolverConfiguration.password());
	}

	public boolean hasBlankPassword() {
		return Validator.isBlank(_secretResolverConfiguration.password());
	}

	public boolean hasNullPassword() {
		if (_secretResolverConfiguration.password() == null) {
			return true;
		}

		return false;
	}

	public boolean hasPassword() {
		return Validator.isNotNull(_secretResolverConfiguration.password());
	}

	public boolean isNullPassword() {
		return Validator.isNull(_secretResolverConfiguration.password());
	}

	public static class PasswordHolder {

		public String password;

	}

	public static class Resolver {

		public String resolve(long companyId, String value) {
			return value;
		}

	}

	private String _password;
	private final SecretResolver _secretResolver;
	private final SecretResolverConfiguration
		_secretResolverConfiguration;

}