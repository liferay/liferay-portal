locals {
	a=2
	b=1
}
resource "aws_s3_bucket" "backups" {
	bucket="backups"
	/*
	tags={
		b="1"
		a="2"
	}
	*/
}
resource "aws_s3_bucket" "logs" {
	acl="private"
	bucket="logs" # main bucket
	# Required by the CDN.
	# Do not remove.
	cors_rule={
		allowed_origins="*"
	}
	force_destroy=true
	# Keep logs for one year
	lifecycle_rule={
		expiration=365
	}
	# Tags
	tags={
		Name="logs"
	}
	# TODO: add encryption
}