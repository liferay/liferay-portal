locals {
	a=2
	b=1
}
resource "aws_s3_bucket" "backups" {
	bucket="backups"

	/*
	tags={
		b="1"
		a="2"
	}
	*/

}
resource "aws_s3_bucket" "logs" {

	# Keep logs for one year

	lifecycle_rule={
		expiration=365
	}

	# Required by the CDN.
	# Do not remove.

	acl="private"
	bucket="logs" # main bucket
	cors_rule={
		allowed_origins="*"
	}

	# Tags

	force_destroy=true
	tags={
		Name="logs"
	}

	# TODO: add encryption

}