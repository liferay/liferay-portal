package com.liferay.source.formatter.dependencies.upgrade;

/**
 * @author Paulo Pereira
 */
public class LPD_102414 {

	public void method(
		CommerceOrder commerceOrder,
		CommerceOrderHttpHelper commerceOrderHttpHelper, long groupId,
		HttpServletRequest httpServletRequest) {

		commerceOrderHttpHelper.getCommerceCartPortletURL(
			123, httpServletRequest, commerceOrder);
		commerceOrderHttpHelper.getCommerceCartPortletURL(
			groupId, httpServletRequest, commerceOrder);

		commerceOrderHttpHelper.getCommerceCartPortletURL(httpServletRequest);
		commerceOrderHttpHelper.getCommerceCartPortletURL(null);

		commerceOrderHttpHelper.getCommerceCartPortletURL(
			httpServletRequest, commerceOrder);
		commerceOrderHttpHelper.getCommerceCartPortletURL(null, commerceOrder);
	}

}