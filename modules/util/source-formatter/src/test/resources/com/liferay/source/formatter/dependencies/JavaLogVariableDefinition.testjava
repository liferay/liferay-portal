package com.liferay.source.formatter.dependencies;

import com.liferay.portal.kernel.log.Log;
import com.liferay.portal.kernel.log.LogFactoryUtil;

import java.util.List;

/**
 * @author Alan Huang
 */
public class JavaLogVariableDefinition {

	public List<String> getClusteringFields() {
		if (_log.isDebugEnabled()) {
			_log.debug("Get clustering fields");
		}

		return _clusteringFields;
	}

	private static final List<String> _clusteringFields = List.of(
		"channelId", "dataSourceId", "individualId", "identityId");
	private static final Log _log = LogFactoryUtil.getLog(
		JavaLogVariableDefinition.class);

}