package com.liferay.source.formatter.dependencies.upgrade;

import org.osgi.service.component.annotations.Reference;

/**
 * @author Micaelle Silva
 */
public class LPD_99286 {

	public void method(
		long commerceOrderItemId,
		CPDefinitionVirtualSetting cpDefinitionVirtualSetting,
		int activationStatus, long duration, int usages, int maxUsages,
		ServiceContext serviceContext) {

		CommerceVirtualOrderItemLocalServiceUtil.addCommerceVirtualOrderItem(
			commerceOrderItemId, cpDefinitionVirtualSetting.getFileEntryId(),
			cpDefinitionVirtualSetting.getUrl(), activationStatus, duration,
			usages, maxUsages, serviceContext);

		_commerceVirtualOrderItemLocalService.addCommerceVirtualOrderItem(
			commerceOrderItemId, cpDefinitionVirtualSetting.getFileEntryId(),
			cpDefinitionVirtualSetting.getUrl(), activationStatus, duration,
			usages, maxUsages, serviceContext);

		_commerceVirtualOrderItemLocalService.addCommerceVirtualOrderItem(
			commerceOrderItemId, cpDefinitionVirtualSetting.getFileEntryId(),
			cpDefinitionVirtualSetting.getUrl(),
			CommerceOrderConstants.ORDER_STATUS_COMPLETED,
			cpDefinitionVirtualSetting.getDuration(), 0,
			cpDefinitionVirtualSetting.getMaxUsages(), serviceContext);
	}

	@Reference
	private CommerceVirtualOrderItemLocalService
		_commerceVirtualOrderItemLocalService;

}