package com.liferay.source.formatter.dependencies;

import java.security.MessageDigest;

import java.util.Objects;

/**
 * @author Lucas Miranda
 */
public class SecretComparison {

	public boolean method1(String accessToken1, String accessToken2) {
		return accessToken1.equals(accessToken2);
	}

	public boolean method2(byte[] hmac, byte[] expectedHmac) {
		return MessageDigest.isEqual(hmac, expectedHmac);
	}

	public boolean method3(String nonce1, String nonce2) {
		return Objects.equals(nonce1, nonce2);
	}

	public boolean method4(
		String[] authorizationParts, String webhookPassword) {

		return authorizationParts[1].equals(webhookPassword);
	}

}