package com.liferay.source.formatter.dependencies;

import java.security.MessageDigest;

import java.util.Objects;

/**
 * @author Lucas Miranda
 */
public class SecretComparison {

	public static final String TEMP_OBFUSCATION_VALUE = "*";

	public boolean isCustomTokenValue(
		String[] tokenValueParts, String tokenName) {

		return tokenValueParts[0].equals(tokenName);
	}

	public boolean isObfuscatedAccessToken(String accessToken) {
		return accessToken.equals("*");
	}

	public boolean isObfuscatedClientSecret(String clientSecret) {
		return clientSecret.equals(TEMP_OBFUSCATION_VALUE);
	}

	public boolean isSameUser(Long otpValidatedUserId, Long userId) {
		return Objects.equals(otpValidatedUserId, userId);
	}

	public boolean isTokenPrefixed(String token, String prefix) {
		return token.startsWith(prefix);
	}

	public boolean isValidAccessToken(String accessToken) {
		return accessToken.equals(_accessToken);
	}

	public boolean isValidHmac(byte[] hmac, byte[] expectedHmac) {
		return MessageDigest.isEqual(hmac, expectedHmac);
	}

	public boolean isValidNonce(String nonce) {
		return Objects.equals(nonce, _nonce);
	}

	public boolean isValidPassword(String password) {
		return password.equals(_encryptedPassword);
	}

	public boolean isValidWebhookPassword(
		String[] authorizationParts, String webhookPassword) {

		return authorizationParts[1].equals(webhookPassword);
	}

	private String _accessToken;
	private String _encryptedPassword;
	private String _nonce;

}