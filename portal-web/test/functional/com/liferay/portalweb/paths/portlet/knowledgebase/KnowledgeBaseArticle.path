<html>
<head>
<title>KnowledgeBaseArticle</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">KnowledgeBaseArticle</td></tr>
</thead>

<tbody>
<tr>
	<td>TITLE</td>
	<td>//div[contains(@class,'kb-article-title')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT</td>
	<td>//div[contains(@class,'kb-entity-body')]//p</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_IMAGE</td>
	<td>//p/img</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_ON_GITHUB</td>
	<td>//span[contains(.,'Edit on GitHub')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS</td>
	<td>//div[@class='kb-article-container']//div/span[@class='kb-article-previous']/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NEXT</td>
	<td>//div[@class='kb-article-container']//div/span[@class='kb-article-next']/a/span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ADMIN_VIEW-->

<tr>
	<td>ADMIN_VIEW_CHILD_ARTICLE_TITLE</td>
	<td>//div[@class='kb-elements']//a</td>
	<td></td>
</tr>
<tr>
	<td>ADMIN_VIEW_CHILD_ARTICLE_CONTENT</td>
	<td>//div[@class='kb-element-body']//p</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ATTACHMENTS-->

<tr>
	<td>ATTACHMENTS_HEADER_COLLAPSED</td>
	<td>//a[contains(@class,'collapse-icon') and contains(@aria-expanded,'false') and contains(.,'Attachments')]</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_HEADER_EXPANDED</td>
	<td>//a[contains(@class,'collapse-icon') and contains(@aria-expanded,'true') and contains(.,'Attachments')]</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_SAVED_ATTACHMENTS_CONTAINER</td>
	<td>//div[contains(@id,'AttachmentsContainer')]//span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--CUSTOM_FIELD-->

<tr>
	<td>CUSTOM_FIELD_NAME</td>
	<td>//div[contains(@class,'ddm-field-group')]//span[contains(.,'${customFieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_FIELD_VALUE</td>
	<td>//div[contains(@class,'ddm-field-group')]//span[contains(.,'${customFieldValue}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--EDIT-->

<tr>
	<td>EDIT_FRIENDLY_URL_FIELD</td>
	<td>//input[contains(@id,'knowledge_base_web') and contains(@id,'urlTitle')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_SELECT_RELATED_ASSETS</td>
	<td>//a[@role='menuitem' and contains(.,'${key_kbArticleRelatedAssetType}')]</td>
	<td></td>
</tr>
<tr>
	<td>WORKFLOW_PUBLISH_BUTTON</td>
	<td>//*[@id='_com_liferay_knowledge_base_web_portlet_AdminPortlet_publishItem']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--INFO_PANEL-->

<tr>
	<td>INFO_TITLE_VISIBLE</td>
	<td>//div[@class='sidebar-header']//div[contains(@class,'component-title') and contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>INFO_VERSION_SUBTITLE</td>
	<td>//li[contains(.,'${key_entryVersion}')]//div[@class='list-group-subtitle']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--HISTORY-->

<tr>
	<td>HISTORY_CONTENT_ADDED_DIFF</td>
	<td>//div[@class='card-body']//p//span[contains(@id,'added-diff')]</td>
	<td></td>
</tr>
<tr>
	<td>HISTORY_CONTENT_REMOVED_DIFF</td>
	<td>//div[@class='panel-body']//p[contains(.,'${key_kbArticleContentRemovedDiff}')]</td>
	<td></td>
</tr>
<tr>
	<td>HISTORY_SELECT_VERSION_CHECKBOX</td>
	<td>//input[(@type='checkbox' and @value='${key_versionNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SECTIONS-->

<tr>
	<td>SECTIONS_SELECT</td>
	<td>//select[contains(@id, 'knowledge_base_web') and contains(@id, 'sections')]//option[contains(.,'${key_kbArticleSection}')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_WIDGET_SELECT</td>
	<td>//select[contains(@id,'kbArticlesSections')]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_HEADER</td>
	<td>//span[@class='taglib-asset-categories-summary']</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_LINKS</td>
	<td>//div[@class='kb-article-assets']/span/a[contains(.,'${key_categoryName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>