<html>
<head>
<title>KnowledgeBase</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">KnowledgeBase</td></tr>
</thead>

<tbody>
<tr>
	<td>ARTICLE_DESCRIPTION</td>
	<td>//div[contains(@id,'knowledge_base')]//div[contains(@class,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_DESCRIPTION_HEADER</td>
	<td>//div[contains(@class,'subtitle') and contains(.,'Description')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_VERSION_NUMBER</td>
	<td>//span[contains(@class,'label-info')]/span</td>
	<td></td>
</tr>
<tr>
	<td>KB_TOOLS</td>
	<td>//div[@class='kb-tools']//span[.='${key_kbTool}']</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_IMAGE_NAME</td>
	<td>//img[contains(@src,'${key_contentImageName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_INFO</td>
	<td>//dt[contains(@class,'sidebar-dt') and contains (.,'${key_sectionTitle}')]/following-sibling::dd[contains(.,'${key_sectionContent}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ADMIN_TABS-->

<tr>
	<td>ADMIN_TABS_SUGGESTIONS</td>
	<td>//ul[contains(@class,'navbar')]/li/a[contains(.,'Suggestions')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ARTICLE_DESCRIPTIVE-->

<tr>
	<td>ARTICLE_DESCRIPTIVE_ARTICLE_TITLE</td>
	<td>//*[contains(@class,'list-group-item')]/div[contains(@class,'autofit-col')]/h2/a[contains(.,'${key_kbArticleTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_DESCRIPTIVE_ARTICLE_CHECKBOX</td>
	<td>//dd[contains(.,'${key_kbArticleTitle}')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_DESCRIPTIVE_ARTICLE_TITLE_GENERIC</td>
	<td>//ul[contains(@class,'descriptive')]//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ARTICLE_TABLE-->

<tr>
	<td>ARTICLE_TABLE_EXPIRATION_STATUS</td>
	<td>//a[contains(.,'${key_kbArticleTitle}')]/parent::h2/following-sibling::span[@class='text-default']//span[contains(@class,'label-warning')]/span</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_TABLE_EXPIRATION_TIME</td>
	<td>//*[name()='svg'][contains(@class,'lexicon-icon-question-circle-full')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_TABLE_KB_GENERIC</td>
	<td>//tr[1]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_TABLE_SELECT_ALL_CHECKBOX</td>
	<td>//input[contains(@name, 'knowledge_base_web') and contains(@name, 'allRowIds')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--DESCRIPTIVE_VIEW-->

<tr>
	<td>DESCRIPTIVE_VIEW_ARTICLE_PRIORITY</td>
	<td>//dd[contains(.,'${key_kbArticleTitle}')]//span[@class='kb-descriptive-details' and contains(.,'Priority')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTIVE_VIEW_ARTICLE_TITLE</td>
	<td>//h2/a[contains(.,'${key_kbArticleTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTIVE_VIEW_ARTICLE_TITLE_SPECIFIC</td>
	<td>xpath=(//*[@data-qa-id='rowItemContent']//h2/a)[${indexNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTIVE_VIEW_CHILD_ARTICLE_LINK</td>
	<td>//dd[contains(.,'${key_kbArticleTitle}')]//a[contains(.,'Child Article')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTIVE_VIEW_ENTRY_INFO</td>
	<td>//*[@data-qa-id='row'][contains(.,'${key_entryTitle}')]//span[contains(@class,'text-default')][contains(normalize-space(),'${key_infoText}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--CHILD_ARTICLES-->

<tr>
	<td>CHILD_PAGE_CONTENT</td>
	<td>//p[@class='list-group-subtext']//span[contains(.,'${key_kbChildArticleContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>CHILD_PAGE_HEADER</td>
	<td>//div[contains(@class,'container-fluid')]//span[contains(.,'Child Articles')]</td>
	<td></td>
</tr>
<tr>
	<td>CHILD_PAGE_TITLE</td>
	<td>//li[@class='list-group-item']//a[contains(.,'${key_kbChildArticleTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--DISPLAY-->

<tr>
	<td>DISPLAY_CONTENT</td>
	<td>//div[contains(@class,'kb-entity-body')]//p</td>
	<td></td>
</tr>
<tr>
	<td>DISPLAY_TITLE</td>
	<td>//div[contains(@class,'kb-article-container')]//h1</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--FOLDER-->

<tr>
	<td>FOLDER_NAVIGATION_MENULIST</td>
	<td>//div[contains(@class,'form-group')]/select</td>
	<td></td>
</tr>
<tr>
	<td>FOLDER_SELECT_DROPDOWN</td>
	<td>//select[contains(@id,'rootKBFolderId')]</td>
	<td></td>
</tr>
<tr>
	<td>FOLDER_SELECT_OPTION</td>
	<td>//select[contains(@id,'rootKBFolderId')]/option[contains(.,'${key_kbFolderName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--FOLDER_DESCRIPTIVE-->

<tr>
	<td>FOLDER_DESCRIPTIVE_FOLDER_NAME</td>
	<td>//*[contains(@class,'list-group-item')]/div[contains(@class,'autofit-col')]/h2/a[contains(.,'${key_kbFolderName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--FOLDER_TABLE-->

<tr>
	<td>FOLDER_TABLE_HEADER</td>
	<td>//th[contains(.,'Folder')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--HIERARCHY_NAVIGATION-->

<tr>
	<td>HIERARCHY_NAVIGATION_PARENT</td>
	<td>//div[@class='kbarticle-navigation']/ul/li/a[contains(.,'${key_kbArticleTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>HIERARCHY_NAVIGATION_GENERIC</td>
	<td>//div[@class='kbarticle-navigation']/ul/li</td>
	<td></td>
</tr>
<tr>
	<td>HIERARCHY_NAVIGATION_CHILD</td>
	<td>//div[@class='kbarticle-navigation']/ul/li[contains(.,'${key_kbArticleTitle}')]/ul/li/a[contains(.,'${key_kbChildArticleTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>HIERARCHY_NAVIGATION_CHILD_GENERIC</td>
	<td>//div[@class='kbarticle-navigation']/ul/li/ul/li</td>
	<td></td>
</tr>
<tr>
	<td>HIERARCHY_NAVIGATION_GRANDCHILD</td>
	<td>//div[@class='kbarticle-navigation']//a[contains(.,'${key_kbGrandchildArticleTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--LINK-->

<tr>
	<td>LINK_THERE_ARE_SUGGESTIONS</td>
	<td>//div[contains(@class,'sidenav-content')]//div[contains(.,'suggestion')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--MOVE-->

<tr>
	<td>MOVE_CURRENT_PARENT_TITLE_LABEL</td>
	<td>//span[contains(@class,'control-label') and contains(.,'Current Parent')]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_CURRENT_PARENT_TITLE_FIELD</td>
	<td>//div[contains(.,'Current Parent')]/div/input</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_CURRENT_PARENT_PRIORITY_LABEL</td>
	<td>//label[contains(@for,'knowledge_base_web') and contains(@for,'currentPriority')][normalize-space()='Priority']</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_NEW_PARENT_TITLE_LABEL</td>
	<td>//span[contains(@class,'control-label') and contains(.,'New Parent')]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_NEW_PARENT_TITLE_FIELD</td>
	<td>//div[contains(@id,'knowledge_base_web') and contains(@id,'newParent')]/input</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_NEW_PARENT_PRIORITY_LABEL</td>
	<td>//div[contains(@id,'knowledge_base_web') and contains(@id,'newParent')]//label[contains(@class,'control-label') and contains(.,'Priority')]</td>
	<td></td>
</tr>

<!--PAGE_TREE-->

<tr>
	<td>PAGE_TREE_CHEVRON_ICON_RIGHT</td>
	<td>//button[contains(@aria-expanded,'false')]//*[contains(@class,'lexicon-icon-angle-right')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_FOLDERS_AND_ARTICLES</td>
	<td>//button[*[name()='svg'][contains(@class,'lexicon-icon-pages-tree')]]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_ITEM_ELLIPSIS</td>
	<td>//li[contains(@class,'treeview')]//div[@role='treeitem' and contains(.,'${key_itemName}')]//button[*[name()='svg'][contains(@class,'lexicon-icon-ellipsis')]]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_ITEM_HIGHLIGHT</td>
	<td>//li[contains(@class,'treeview-item')]//div[contains(@class,'knowledge-base-navigation-item-active')]//span[normalize-space(text())='${key_itemName}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_ITEM_HIGHLIGHT_1</td>
	<td>//a[contains(@class,'link-secondary')]//span/b[text()='${key_itemName}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_ITEM_HIGHLIGHT_2</td>
	<td>xpath=(//a[contains(@class,'link-secondary')]//span/b[text()='${key_itemName}'])[2]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_ITEM_LINK</td>
	<td>//li[contains(@class,'treeview-item')]//a[contains(@class,'link-secondary')]//span[normalize-space(text())='${key_itemLinkName}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_ITEM_NAME</td>
	<td>//li[contains(@class,'treeview-item')]//span[contains(@class,'component-text')][normalize-space(text())='${key_itemName}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_PANEL_COLLAPSED</td>
	<td>//div[contains(@class,'knowledge-base-vertical-bar') and not(contains(@class,'expanded'))]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_PANEL_HEADER</td>
	<td>//div[contains(@class,'knowledge-base-vertical-bar') and contains(@class,'expanded')]//div[contains(@class,'sidebar-header') and contains(.,'${key_header}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_PANEL_OPENED</td>
	<td>//div[contains(@class,'knowledge-base-vertical-bar') and contains(@class,'expanded')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_SUGGESTIONS</td>
	<td>//button[*[name()='svg'][contains(@class,'lexicon-icon-message')]]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TREE_TEMPLATES</td>
	<td>//button[*[name()='svg'][contains(@class,'lexicon-icon-page-template')]]</td>
	<td></td>
</tr>

<!--SEARCH-->

<tr>
	<td>SEARCH_WIDGET_BAR</td>
	<td>//input[contains(@data-qa-id,'searchInput') and contains(@name,'knowledge_base')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_WIDGET_ARTICLE_TITLE</td>
	<td>//tbody/tr/td[contains(@class,'lfr-title-column')]/a[contains(.,'${key_kbArticleTitle}')]</td>
	<td></td>
</tr>

<!--SIDE_BAR-->

<tr>
	<td>HOME_FOLDER</td>
	<td>//div[contains(@class,'autofit-col-expand')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//div[contains(@class,'sidebar')]//input[@placeholder='Search for']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>