<html>
<head>
<title>WikiTable</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WikiTable</td></tr>
</thead>

<tbody>

<!--ALL_PAGES-->

<tr>
	<td>ALL_PAGES_PAGE_2</td>
	<td>xpath=(//tr/td[1]//a)[2]</td>
	<td></td>
</tr>
<tr>
	<td>ALL_PAGES_WIKI_PAGE_TITLE</td>
	<td>//a[normalize-space(.//text())='${key_wikiPageTitle}']</td>
	<td></td>
</tr>
<tr>
	<td>ALL_PAGES_STATUS</td>
	<td>//tr[contains(.,'${key_wikiPageTitle}')]/td[2]//span | //tr[contains(.,'${key_wikiPageTitle}')]/td[3]//span</td>
	<td></td>
</tr>
<tr>
	<td>ALL_PAGES_REVISION</td>
	<td>//tr[contains(.,'${key_wikiPageTitle}')]/td[3]//a</td>
	<td></td>
</tr>
<tr>
	<td>ALL_PAGES_USER</td>
	<td>//tr[contains(.,'${key_wikiPageTitle}')]/td[contains(.,'${key_wikiPageUsername}')]</td>
	<td></td>
</tr>
<tr>
	<td>ALL_PAGES_DATE</td>
	<td>//tr[contains(.,'${key_wikiPageTitle}')]/td[5]//a</td>
	<td></td>
</tr>
<tr>
	<td>ALL_PAGES_VERTICAL_ELLIPSIS</td>
	<td>//tr[contains(.,'${key_wikiPageTitle}')]/.//td//div[contains(@class,'dropdown-action')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--DRAFT_PAGES-->

<tr>
	<td>DRAFT_PAGES_PENDING_HEADER</td>
	<td>//h2[contains(text(),'Pending Approval')]</td>
	<td></td>
</tr>

<!--DRAFT_PAGES_TABLE-->

<tr>
	<td>DRAFT_PAGES_WIKI_PAGE_NAME</td>
	<td>//div[@class='searchcontainer-content']//tr[contains(.,'${key_wikiPageTitle}')]/td[1]//a</td>
	<td></td>
</tr>
<tr>
	<td>DRAFT_PAGES_STATUS</td>
	<td>//div[@class='searchcontainer-content']//tr[contains(.,'${key_wikiPageTitle}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>DRAFT_PAGES_REVISION</td>
	<td>//div[@class='searchcontainer-content']//tr[contains(.,'${key_wikiPageTitle}')]/td[3]//a</td>
	<td></td>
</tr>
<tr>
	<td>DRAFT_PAGES_USER</td>
	<td>//div[@class='searchcontainer-content']//tr[contains(.,'${key_wikiPageTitle}')]/td[4]//a</td>
	<td></td>
</tr>
<tr>
	<td>DRAFT_PAGES_DATE</td>
	<td>//div[@class='searchcontainer-content']//tr[contains(.,'${key_wikiPageTitle}')]/td[5]//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--NAVIGATION-->

<tr>
	<td>NAVIGATION_ACTIVE_TAB</td>
	<td>//a[contains(@class,'active') and contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_FRONTPAGE</td>
	<td>//div[@class='navbar ' or contains(@class,'navbar-collapse')]//li/a[contains(.,'FrontPage')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_RECENT_CHANGES</td>
	<td>//div[@class='navbar ' or contains(@class,'navbar-collapse')]//li/a[contains(.,'Recent Changes')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_ALL_PAGES</td>
	<td>//div[@class='navbar ' or contains(@class,'navbar-collapse')]//li/a[contains(.,'All Pages')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_ORPHAN_PAGES</td>
	<td>//div[@class='navbar ' or contains(@class,'navbar-collapse')]//li/a[contains(.,'Orphan Pages')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_DRAFT_PAGES</td>
	<td>//div[@class='navbar ' or contains(@class,'navbar-collapse')]//li/a[contains(.,'Draft Pages')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SELECT_VERSION-->

</tbody>
</table>
</body>
</html>