<html>
<head>
<title>APConfigurationManual</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">APConfigurationManual</td></tr>
</thead>

<tbody>
<tr>
	<td>ASSET_SELECTION_MANUAL_NONE</td>
	<td>//div[contains(@id,'assetEntriesSearchContainerEmptyResultsMessage')]/p</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_SELECT_ASSET_ENTRIES_DIALOG</td>
	<td>//*[contains(@id,'selectAsset')]//*[contains(@class,'modal-dialog')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_MODAL</td>
	<td>//div[contains(@class,'modal-content')][.//button[contains(@class,'selector-button')]]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_ROW_CHECKBOX</td>
	<td>//div[contains(@class,'modal-content')]//tr[.//td[contains(normalize-space(),'${key_assetTitle}')]]//td[contains(@class,'cell-select-item')]//label</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_ADD_BUTTON</td>
	<td>//div[contains(@class,'modal-footer')]//button[contains(@class,'selector-button')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_CANCEL_BUTTON</td>
	<td>//div[contains(@class,'modal-footer')]//button[contains(@class,'btn-cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_SEARCH_FIELD</td>
	<td>//div[contains(@class,'modal-content')]//input[@type='search']</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_RESULTS_INFO</td>
	<td>//div[contains(@class,'modal-content')]//span[contains(text(),'Found for')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_SELECTION_MANUAL_ITEM_SELECTOR_SELECT_ALL_CHECKBOX</td>
	<td>//div[contains(@class,'modal-content')]//label[.//input[@name='items-selector']]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>