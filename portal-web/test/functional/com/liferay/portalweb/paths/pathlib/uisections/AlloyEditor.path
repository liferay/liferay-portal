<html>
<head>
<title>AlloyEditor</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">AlloyEditor</td></tr>
</thead>

<tbody>
<tr>
	<td>EDITOR</td>
	<td>//div[contains(@class,'cke_editable_inline') and contains(@id,'_${key_editor}')] | //div[contains(@class,'ck-editor__editable') and contains(@id,'_${key_editor}')] | //div[contains(@class,'form-group')]//textarea[contains(@id,'_${key_editor}')] | //div[contains(@id,'FragmentEntryLinkEditable')]//div[contains(@class,'ck-editor__editable_inline')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_FIELD_BOLD</td>
	<td>//div[contains(@class,'alloy-editor-placeholder') and contains(@data-placeholder,'Write your content here...')]/p/strong[contains(.,'${key_boldContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_ADD_BUTTON</td>
	<td>//button[contains(@class,'ae-button') and contains(@class,'add')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_FIELD_ITALIC</td>
	<td>//div[contains(@class,'alloy-editor-container')]//div[(contains(@data-placeholder,'Write your content here...') or contains(@data-placeholder,'Content')) and contains(@title,'Rich Text Editor')]//em[contains(.,'${key_italicContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_FIELD_UNDERLINE</td>
	<td>//div[contains(@class,'alloy-editor-container')]//div[(contains(@data-placeholder,'Write your content here...') or contains(@data-placeholder,'Content')) and contains(@title,'Rich Text Editor')]//u[contains(.,'${key_underlineContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>IMAGE_TOOLBAR</td>
	<td>//div[contains(@class,'ae-toolbar') and contains(@class,'alloy-editor')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--CONTENT_ADD_MENUBAR-->

<tr>
	<td>CONTENT_ADD_MENUBAR_IMAGE</td>
	<td>//button[contains(@data-type,'image')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_ADD_MENUBAR_VIDEO</td>
	<td>//button[contains(@data-type,'video')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--TEXT_FORMATTING-->

<tr>
	<td>TEXT_FORMATTING_STYLE</td>
	<td>//button[contains(@class,'ae-toolbar-element')]//span[contains(@class,'selected-item')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_STYLE_DROPDOWN</td>
	<td>//button[contains(@class,'ae-toolbar-element') and contains(.,'${key_styleFormat}')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_BOLD</td>
	<td>//button[contains(@class,'ck-button') and contains(@data-cke-tooltip-text,'Bold')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_ITALIC</td>
	<td>//button[contains(@class,'ck-button') and contains(@data-cke-tooltip-text,'Italic')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_REMOVE_LINK_BUTTON</td>
	<td>//button[contains(@aria-label,'Remove link')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_UNDERLINE</td>
	<td>//button[contains(@class,'ck-button') and contains(@data-cke-tooltip-text,'Underline')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_LINK</td>
	<td>//button[contains(@class,'ck-button') and contains(@data-cke-tooltip-text,'Link')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_LINK_BROWSE_BUTTON</td>
	<td>//button[contains(@aria-label,'Browse')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_LINK_INPUT</td>
	<td>//form[contains(@class,'ck-link-form')]//div[contains(@class,'ck-labeled-field-view')][.//label[contains(text(),'Link URL')]]//input[contains(@class,'ck-input')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_LINK_INPUT_CONFIRM</td>
	<td>//form[contains(@class,'ck-link-form')]//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_FORMATTING_LINK_FORM</td>
	<td>//form[contains(@class,'ck-link-form')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>