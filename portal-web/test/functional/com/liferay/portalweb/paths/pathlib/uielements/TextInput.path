</tr>
<tr>
	<td>SAML_NAME_FIELD</td>
	<td>//input[contains(@id,'SamlAdminPortlet_name')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECTOR_INPUT</td>
	<td>//label[not(contains(@class,'sr-only'))][normalize-space(text())='${key_fieldFieldLabel}']/following-sibling::div//div[contains(@class,'input-group')]//input[not(contains(@type,'hidden'))]</td>
	<td></td>
</tr>
<tr>
	<td>STRUCTURE_KEY_FIELD</td>
	<td>//input[contains(@id,'structureKey')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUIRED_ALERT</td>
	<td>//div[contains(@class,'has-error')]</td>
	<td></td>
</tr>
<tr>
	<td>SPECIFIC_REQUIRED_ALERT</td>
	<td>//div[contains(@class,'has-error')][contains(.,'${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SPECIFIC_LABEL_TEXT_INPUT</td>
	<td>//label[contains(text(),'${key_labelName}')]//following::input[contains(@type,'text')]</td>
	<td></td>
</tr>
<tr>
	<td>SCREEN_NAME</td>
	<td>//div[label[contains(.,'Screen Name')]]/input[@type='text']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH</td>
	<td>//input[contains(@title,'S') or contains(@title,'s')][contains(@title,'earch')][not(@data-qa-id='sideNavigationSearchInput')] | //input[contains(@aria-label,'S') or contains(@aria-label,'s') or contains(@title,'s')][contains(@aria-label,'earch')][not(@data-qa-id='sideNavigationSearchInput')] | //input[contains(@name,'keywords')] | //input[(ancestor::header[@id='banner'])][contains(@data-qa-id,'searchInput')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_DISABLED</td>
	<td>//input[@disabled and contains(@name,'keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>SEO_MAPPED_FIELD</td>
	<td>//div[contains(@class,'form-group')]//*[contains(@id,'${key_mappedField}')]</td>
	<td></td>
</tr>
<tr>
	<td>SETUP_XML_URL</td>
	<td>//input[contains(@id,'xmlUrl')]</td>
	<td></td>
</tr>
<tr>
	<td>SETUP_XSL_URL</td>
	<td>//input[contains(@id,'xslUrl')]</td>
	<td></td>
</tr>
<tr>
	<td>SITE_SEARCH_KEYWORDS</td>
	<td>//input[contains(@name,'keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>FRAGMENTS_SEARCH</td>
	<td>//div[contains(@class,'modal-content')]//input[contains(@placeholder,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>SKYPE</td>
	<td>//div[label[contains(.,'Skype')]]/input</td>
	<td></td>
</tr>
<tr>
	<td>SOURCE_URL</td>
	<td>//input[contains(@id,'_src')]</td>
	<td></td>
</tr>
<tr>
	<td>STREET_1</td>
	<td>//div[label[contains(.,'Street 1')]]//input[@type='text']</td>
	<td></td>
</tr>
<tr>
	<td>STREET_N</td>
	<td>//div[label[contains(.,'Street ${key_streetNumber}')]]//input[@type='text']</td>
	<td></td>
</tr>
<tr>
	<td>SUBJECT</td>
	<td>//input[contains(@id,'subject')] | //input[contains(@id,'Subject')]</td>
	<td></td>
</tr>
<tr>
	<td>TARGET_PAGE_FRIENDLY_URL</td>
	<td>//input[contains(@id,'targetLayoutFriendlyUrl')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT</td>
	<td>//input[@type='text']</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_SPECIFIC</td>
	<td>//label[contains(.,'Text')]/following-sibling::input[1] | //label[contains(.,'Text')]//..//input[1]</td>
	<td></td>
</tr>
<tr>
	<td>TITLE</td>
	<td>//input[contains(@id,'title')]</td>
	<td></td>
</tr>
<tr>
	<td>TRACKBACKS</td>
	<td>//input[contains(@id,'trackbacks')]</td>
	<td></td>
</tr>
<tr>
	<td>TRANSLATIONS_TARGET_FIELD</td>
	<td>//div[contains(@class,'form-group')]//label[text()='${key_fieldName}']/following::input[not(@readonly)]</td>
	<td></td>
</tr>
<tr>
	<td>TWITTER</td>
	<td>//div[label[contains(.,'Twitter')]]//input[@type='text']</td>
	<td></td>
</tr>
<tr>
	<td>TYPE</td>
	<td>//div[label[contains(.,'Type')]]//input[@value='${key_typeName}']</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE</td>
	<td>//input[contains(@class,'field') and (@type='file')]</td>
	<td></td>
</tr>
<tr>
	<td>URL</td>
	<td>//input[contains(@id,'url') or contains(@id,'Url')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_REQUIRED</td>
	<td>//div[contains(@id,'urlHelper')]/div[contains(@role,'alert')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_URL</td>
	<td>//input[contains(@id,'VideoExternalShortcutURL')]</td>
	<td></td>
</tr>
<tr>
	<td>VIRTUAL_HOST</td>
	<td>//input[contains(@id,'virtualHostname') and contains(@class,'input-text')]</td>
	<td></td>
</tr>
<tr>
	<td>WEB_ID</td>
	<td>//input[contains(@id,'webId') and contains(@class,'input-text')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>