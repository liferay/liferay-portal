<html>
<head>
<title>Treeview</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Treeview</td></tr>
</thead>

<tbody>
<tr>
	<td>NODE_CHECKBOX</td>
	<td>//*[contains(@class,'component-text') or contains(@class,'flex-grow')][normalize-space(text())='${key_nodeName}']/ancestor::div[contains(@class,'treeview')]//input[@type='checkbox'] | //*[contains(@class,'treeview-item')][.//text()[normalize-space()='${key_nodeName}']]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_CHECKBOX_2</td>
	<td>//*[contains(@class,'component-text') or contains(@class,'flex-grow')][contains(text(),'${key_nodeName}')]/ancestor::div[contains(@class,'treeview')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_COLLAPSED</td>
	<td>//div[contains(@class,'treeview-node-list')]/button[contains(@class,'treeview-node-list') and @aria-expanded='false'] | //div[contains(@class,'tree-collapsed')]//span[not(contains(@class,'hidden'))]//*[name()='svg'][contains(@class,'icon-plus')] | //div[contains(@class,'navigation-menu-items-tree-node')]//button[@aria-expanded='false'] | //ul[contains(@class,'treeview')]//button[contains(@class,'component-expander')][@aria-expanded='false']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_DRAGGABLE_ELEMENT</td>
	<td>xpath=(//div[contains(@class,'list-item__node')][contains(.,'${key_elementName}')])[${index}]//div[@role='button'][@draggable='true']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_DRAGGABLE_TARGET_ELEMENT</td>
	<td>//div[contains(@class,'list-item__node')][contains(.,'${key_targetElementName}')]//div[@role='button'][@draggable='true']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ITEM</td>
	<td>//ul[contains(@class,'treeview')]//button[contains(@class,'search-result-button')]//*[normalize-space(text())='${key_nodeName}']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_ITEM</td>
	<td>//div[contains(@class,'card-horizontal')]//div[contains(@class,'card-body')][contains(.,'${key_nodeName}')] | //li[contains(@class,'treeview-item')]//*[contains(@class,'component-text') or contains(@class,'flex-grow')][normalize-space(text())='${key_nodeName}'] | //*[contains(@class,'treeview-item')][.//text()[normalize-space()='${key_nodeName}']]</td>
	<td></td>
</tr>
<tr>
	<td>NODE_ITEM_2</td>
	<td>//li[contains(@class,'treeview-item')]//*[contains(@class,'component-text') or contains(@class,'flex-grow')][contains(text(),'${key_nodeName}')]</td>
	<td></td>
</tr>
<tr>
	<td>NODE_ITEM_BY_DATA_QA_ID</td>
	<td>//div[contains(@data-qa-id,'${data_qa_id}')][@aria-expanded]</td>
	<td></td>
</tr>
<tr>
	<td>NODE_ITEM_SPAN</td>
	<td>//div[contains(@class,'card-horizontal')]//div[contains(@class,'card-body')][contains(.,'${key_nodeName}')] | //li[contains(@class,'treeview-item')]//div[contains(@class,'component-text')][normalize-space(text())='${key_nodeName}']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_SELECTED</td>
	<td>//div[contains(@class,'card-type-directory') and contains(@class,'selected')]/div[contains(@class,'card-horizontal')]//span[contains(.,'${key_nodeName}')] | //div[contains(@role,'treeitem') and contains(@class,'active')]//*[contains(@class,'component-text') or contains(@class,'flex-grow')][normalize-space()='${key_nodeName}']</td>
	<td></td>
</tr>
<tr>
	<td>NODE_UNSELECTED</td>
	<td>//div[contains(@class,'card-type-directory') and not(contains(@class,'selected'))]/div[contains(@class,'card-horizontal')]//span[contains(.,'${key_nodeName}')] | //div[contains(@role,'treeitem') and not(contains(@class,'active'))]//*[contains(@class,'component-text') or contains(@class,'flex-grow')][normalize-space(text())='${key_nodeName}'] | //*[contains(@class,'treeview-item') and (not(@aria-selected) or @aria-selected='false')][./*[contains(@class,'treeview-link')]//text()[normalize-space()='${key_nodeName}']]</td>
	<td></td>
</tr>
<tr>
	<td>NODE_UNSELECTED_TREEITEM</td>
	<td>//div[contains(@role,'treeitem') and not(contains(@class,'active'))][.//*[contains(@class,'component-text') or contains(@class,'flex-grow')][normalize-space(text())='${key_nodeName}']]</td>
	<td></td>
</tr>
<tr>
	<td>NODE_LIST</td>
	<td>//*[@role='tree'] | //ul[contains(@class,'tree-pages')] | //div[contains(@class,'navigation-menu-items-tree')]</td>
	<td></td>
</tr>
<tr>
	<td>NODE_LIST_ITEM</td>
	<td>//li[contains(@class,'tree-node')]//a[contains(text(),'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE</td>
	<td>//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')]/div[@role='button']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_INDEX</td>
	<td>xpath=(//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')]/div[@role='button'])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_BUTTON_WITH_ARIA_LABEL_INDEX</td>
	<td>xpath=(//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')][@aria-selected])[${key_index}]//button[@aria-label='${ariaLabel}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_ACTIVE</td>
	<td>//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')][contains(@aria-selected,'true')]/div[@role='button']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_ACTIVE_INDEX</td>
	<td>xpath=(//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')][contains(@aria-selected,'true')]/div[@role='button'])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_COLLAPSED</td>
	<td>//div[contains(@role,'treeitem') and contains(.,'${key_nodeName}')]//button[contains(@class,'component-expander') and @aria-expanded='false']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_HIDE_INDEX</td>
	<td>xpath=(//div[contains(@class,'page-structure__clay-tree-node') and contains(.,'${key_nodeName}')]//button[contains(@class,'tree-node')][*[name()='svg'][contains(@class,'lexicon-icon-view') or contains(@class,'lexicon-icon-hidden')]])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_MASTER_INDEX</td>
	<td>xpath=(//div[contains(@class,'page-structure__clay-tree-node') and contains(.,'${key_nodeName}') and contains(@class,'page-editor__page-structure__clay-tree-node--master-item')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_NAME</td>
	<td>//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')]//div[contains(@class,'node__name')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_NAME_INFO</td>
	<td>//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_nodeName}')]//span[contains(@class,'node__name-info')][normalize-space(text())='${key_info}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_NODE_POSITION</td>
	<td>xpath=(//div[contains(@role,'treeitem')])[${key_position}][contains(.,'${key_nodeName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_STRUCTURE_TREE_VERTICAL_ELLIPSIS</td>
	<td>xpath=(//div[contains(@class,'page-structure__clay-tree-node') and contains(.,'${key_nodeName}')]//button[*[name()='svg'][contains(@class,'icon-ellipsis')]])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>SUBNODE_ITEM</td>
	<td>//div[contains(@class,'collapse show')]//li[contains(@class,'treeview-item')]//*[contains(@class,'component-text')][normalize-space(text())='${key_nodeName}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>