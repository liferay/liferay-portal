	@summary = "Default summary"
	macro editSavePG(checkedOut = null, dmDocumentTagName = null, dmDocumentTitle = null, dmDocumentTitleEdit = null, changeLog = null, dmDocumentFileEdit = null, userName = null, dmDocumentDescriptionEdit = null, revision = null) {
		DMDocument.editCmdPG(
			changeLog = ${changeLog},
			checkedOut = ${checkedOut},
