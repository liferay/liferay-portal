	@summary = "Default summary"
	macro updateCheckInterval(fieldValue = null) {
		DMNavigator.openToConfigInSystemSettings(portlet = "Service");

		Type(
			key_text = "Check Interval",
			locator1 = "TextInput#ANY",
			value1 = ${fieldValue});

		SystemSettings.saveConfiguration();
	}

	@summary = "Default summary"
	macro updateFileExtensions(indexNumber = null, fieldValue = null) {
		DMNavigator.openToConfigInSystemSettings(portlet = "Service");

		ScrollWebElementIntoView(
			key_text = "fileExtensions",
			locator1 = "TextArea#ANY");

		if (${indexNumber} == 2) {
			Click(
				key_label = "Add Duplicate Field File Extensions",
				locator1 = "Button#DUPLICATE_SPECIFIC");

			Type(
				key_indexNumber = ${indexNumber},
				key_label = "File Extensions",
				locator1 = "TextArea#ANY_LABELED_N",
				value1 = ${fieldValue});
		}
		else {
			Type(
				key_text = "fileExtensions",
				locator1 = "TextArea#ANY",
				value1 = ${fieldValue});
		}

		SystemSettings.saveConfiguration();
	}

	@summary = "Default summary"
	macro updateFileOrder(sortDirection = null, siteURLKey = null, orderBy = null) {
		if (isSet(instanceSettings)) {
			DMNavigator.openToConfigInInstanceSettings(portlet = "File Order");
		}
		else if (isSet(siteSettings)) {
			DMNavigator.openToConfigInSiteSettings(
				portlet = "File Order",
				siteURLKey = ${siteURLKey});
		}
		else {
			DMNavigator.openToConfigInSystemSettings(portlet = "File Order");
		}

		Click(locator1 = "Dropdown#TRIGGER");

		DropdownMenuItem.click(menuItem = ${orderBy});

		if (isSet(sortDirection)) {
			Click(locator1 = "Dropdown#TRIGGER_2");

			DropdownMenuItem.click(menuItem = ${sortDirection});
		}

		SystemSettings.saveConfiguration();
	}

	@summary = "Default summary"
	macro updateMaximumFileSize(siteURLKey = null, fieldValue = null) {
		if (isSet(instanceSettings)) {
			DMNavigator.openToConfigInInstanceSettings(portlet = "Documents and Media Size Limits");
		}
		else if (isSet(siteSettings)) {
			DMNavigator.openToConfigInSiteSettings(
				portlet = "Documents and Media Size Limits",
				siteURLKey = ${siteURLKey});
		}
		else {
			DMNavigator.openToConfigInSystemSettings(portlet = "Documents and Media Size Limits");
		}

		Type(
			key_fieldLabel = "Maximum File Upload Size",
			locator1 = "TextInput#GENERIC_NUMBER_INPUT",
			value1 = ${fieldValue});

		SystemSettings.saveConfiguration();
	}

	@summary = "Default summary"
	macro updateMaximumVersions(fieldValue = null) {
		DMNavigator.openToConfigInSystemSettings(portlet = "Service");

		Type(
			key_fieldLabel = "Maximum Number Of Versions",
			locator1 = "TextInput#GENERIC_TEXT_INPUT",
			value1 = ${fieldValue});

		SystemSettings.saveConfiguration();
	}

	@summary = "Default summary"
	macro updateMimeTypeSizeLimit(depotName = null, siteURLKey = null, maximumFileSizeValue = null, indexNumber = null, mimeTypeValue = null) {
		if (isSet(instanceSettings)) {
			DMNavigator.openToConfigInInstanceSettings(portlet = "Documents and Media Size Limits");
		}
		else if (isSet(siteSettings)) {
			DMNavigator.openToConfigInSiteSettings(
				portlet = "Documents and Media Size Limits",
				siteURLKey = ${siteURLKey});
		}
		else if (isSet(depotName)) {
			DepotNavigator.openDepotSettingsGeneral(depotName = ${depotName});
		}
		else {
			DMNavigator.openToConfigInSystemSettings(portlet = "Documents and Media Size Limits");
		}

		if (isSet(checkPortletTitle)) {
			AssertTextEquals(
				key_portletTitle = "File Size Limits",
				locator1 = "DocumentsAndMedia#PORTLET_TITLE",
				value1 = "File Size Limits");
		}

		if (${indexNumber} == 2) {
			Click(locator1 = "Button#DUPLICATE");

			Type(
				key_fieldLabel = "Mime Type",
				key_indexNumber = ${indexNumber},
				locator1 = "TextInput#GENERIC_TEXT_INPUT_N",
				value1 = ${mimeTypeValue});

			Type(
				key_fieldLabel = "Maximum File Size",
				key_indexNumber = ${indexNumber},
				locator1 = "TextInput#GENERIC_NUMBER_INPUT_N",
				value1 = ${maximumFileSizeValue});
		}
		else {
			Type(
				key_fieldLabel = "Mime Type",
				locator1 = "TextInput#GENERIC_TEXT_INPUT",
				value1 = ${mimeTypeValue});

			Type(
				key_fieldLabel = "Maximum File Size",
				locator1 = "TextInput#GENERIC_NUMBER_INPUT",
				value1 = ${maximumFileSizeValue});

			if (isSet(validateInvalidsize)) {
				FormPortlet.viewValidationErrorMessage(validationErrorMessage = "Error: Please enter a valid number.");
			}
		}

		if (isSet(validateInvalidValue)) {
			Button.clickSave();

			AssertTextEquals.assertPartialText(
				key_alertMessage = "Your request failed to complete.",
				locator1 = "Message#ERROR_ENTER_A_VALID_VALUE",
				value1 = "Your request failed to complete.");

			if (isSet(viewErrorAlert)) {
				AssertTextEquals.assertPartialText(
					key_alertMessage = "Error:Mime type or size limit is not valid.",
					locator1 = "Message#ERROR_ENTER_A_VALID_VALUE",
					value1 = "Error:Mime type or size limit is not valid.");
			}
		}
		else {
			SystemSettings.saveConfiguration();
		}
	}

	@summary = "Default summary"
	macro validateGuestUserViewPermission(dmDocumentTitle = null, groupName = null) {
		var latestVersionURL = JSONDocument.getLatestVersionURL(
			dmDocumentTitle = ${dmDocumentTitle},
			groupName = ${groupName});

		var curl = '''${latestVersionURL} -I''';

		var responseHeader = JSONCurlUtil.post(${curl});

		if (isSet(guestWithViewPermission)) {
			if (contains(${responseHeader}, 200)) {
				echo("A guest user can access this file..");
			}
			else {
				fail("FAIL!");
			}
		}

		if (isSet(guestWithoutViewPermission)) {
			if (contains(${responseHeader}, 302)) {
				echo("The guest user will be redirected to the login page when the user doesn't have view permissions.");
			}
			else {
				fail("FAIL!");
			}
		}
	}

