	@summary = "Default summary"
	macro downloadMultipleCP(dmDocumentTitleList = null) {
		LexiconEntry.changeDisplayStyle(displayStyle = "list");

		for (var dmDocumentTitle : list ${dmDocumentTitleList}) {
			Check(
