		PortletEntry.publish();
	}

	@summary = "Default summary"
	macro editPGViaAP(dmDocumentTitleEdit = null, assetTitle = null, portletName = null) {
		var key_assetTitle = ${assetTitle};
		var key_portletName = ${portletName};

		WaitForElementPresent(locator1 = "AP#ASSET_ABSTRACT_EDIT");

		Click(locator1 = "AP#ASSET_ABSTRACT_EDIT");

		ScrollWebElementIntoView(locator1 = "Portlet#TITLE");

		MouseOver.mouseOverNotVisible(locator1 = "Icon#EDIT_PENCIL");

		Click.mouseOverClick(locator1 = "Icon#EDIT_PENCIL");

		if (IsElementPresent.isElementPresentAfterWait(locator1 = "Icon#EDIT_PENCIL")) {
			Click.mouseOverClick(locator1 = "Icon#EDIT_PENCIL");
		}

		WaitForElementPresent(locator1 = "TextInput#TITLE");

		if (isSet(dmDocumentTitleEdit)) {
			Type(
				locator1 = "TextInput#TITLE",
				value1 = ${dmDocumentTitleEdit});
		}

		AssertClick(
			locator1 = "Button#PUBLISH",
			value1 = "Publish");

		SelectFrame(locator1 = "relative=top");
	}

	@summary = "Default summary"
	macro editPGViaMG(mgDocumentTitleEdit = null, mgDocumentDescriptionEdit = null, mgDocumentTitle = null) {
		Click.waitForMenuToggleJSClick(
			key_card = ${mgDocumentTitle},
