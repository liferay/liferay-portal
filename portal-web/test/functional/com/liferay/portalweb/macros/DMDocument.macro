				value1 = "Approved");
		}
		else if (${status} == "Draft") {
			AssertTextEquals(
				locator1 = "DocumentsAndMedia#ICON_DOCUMENT_WORKFLOW_STATUS_DRAFT",
				value1 = "Draft");
		}
		else {
			AssertTextEquals(
				locator1 = "DocumentsAndMedia#ICON_DOCUMENT_WORKFLOW_STATUS",
				value1 = ${status});
		}

		AssertClick(
			locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE",
			value1 = ${dmDocumentTitle});

		AssertElementPresent(locator1 = "Message#CHECKOUT_SUCCESS");

		DMNavigator.gotoVerticalEllipsisMenuItem(menuItem = "Edit");

		VerifyElementPresent(locator1 = "Message#SUCCESS");
	}

	@summary = "Default summary"
	macro viewCP(dmDocumentTitle = null, dmDocumentSize = null, dmDocumentDescription = null, dmDocumentType = null, relatedAssetsTitle = null, dmFolderName = null, customFieldValue = null, dmDocumentFileName = null, customFieldName = null, user = null, previewImage = null) {
