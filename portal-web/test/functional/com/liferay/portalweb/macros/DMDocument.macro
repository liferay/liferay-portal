	@summary = "Default summary"
	macro editPG(dmDocumentTitle = null, dmDocumentFileNameEdit = null, groupName = null, dmDocumentTitleEdit = null, siteURLKey = null, dmDocumentFileEdit = null, folderName = null, dmDocumentDescriptionEdit = null) {
		var key_dmDocumentTitle = ${dmDocumentTitle};

