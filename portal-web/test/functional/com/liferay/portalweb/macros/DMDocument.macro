	@summary = "Default summary"
	macro assertDownloadedFileContent(fileName = null, downloadedContent = null) {
		var fileContent = TestCase.getTempFileContent(fileName = ${fileName});

		if (contains(${fileContent}, ${downloadedContent})) {
			echo("The downloaded file content matches the expected file content.");
		}
		else {
			fail("The downloaded file content does not match the expected file content.");
		}
	}

	@summary = "Default summary"
	macro assertDownloadedFileContentNotExist(fileName = null, downloadedContent = null) {
		var fileContent = TestCase.getTempFileContent(fileName = ${fileName});

		if (!(contains(${fileContent}, ${downloadedContent}))) {
			echo("The downloaded file content doesn't contain the specific file content.");
		}
		else {
			fail("The downloaded file content matches the specific file content.");
		}
	}

	@summary = "Default summary"
	macro assertFileExtensionFromTempFolder(fileExtension = null) {
		var downloadedFile = TestCase.getDownloadedTempFileName(fileNamePattern = ${downloadedFile});

		echo("## downloadedFile: ${downloadedFile}");

		if (contains(${downloadedFile}, ${fileExtension})) {
			echo("This is an expected file extension.");
		}
		else {
			fail("FAIL!");
		}
	}

	@summary = "Default summary"
	macro assertFileNameFromTempFolder(fileName = null) {
		var tempDir = PropsUtil.get("output.dir.name");

		var downloadedFileCrdownload = FileUtil.exists("${tempDir}/${fileName}.crdownload");

		if (${downloadedFileCrdownload} == "true") {
			FileUtil.move("${tempDir}/${fileName}.crdownload", "${tempDir}/${fileName}");
		}
		else {
			var files = FileUtil.listFiles(${tempDir});

			echo("files: ${files}");
		}

		var downloadedFile = FileUtil.exists("${tempDir}/${fileName}");

		if (${downloadedFile} == "true") {
			echo("There is a file named ${fileName} in temp folder ${tempDir}");
		}
		else {
			fail("There is no file named ${fileName} in temp folder ${tempDir}");
		}
	}

	@summary = "Default summary"
	macro assertNoFileNameFromTempFolder(fileName = null) {
		var tempDir = PropsUtil.get("output.dir.name");

		var exportedFile = FileUtil.exists("${tempDir}/${fileName}");

		if (${exportedFile} == "true") {
			fail("FAIL! There is a file named ${fileName}.");
		}
		else {
			echo("This is no file named ${fileName}.");
		}
	}

	@summary = "Default summary"
	macro assertNoZipFileFromTempFolder(appServer = null, fileNamePattern = null) {
		var liferayHome = PropsUtil.get("liferay.home.dir.name");
		var fileName = StringUtil.split("**/${fileNamePattern}");

		var tempFile = "${liferayHome}/${appServer}/temp/${fileName}";

		var tempFileExists = FileUtil.exists(${tempFile});

		if (${tempFileExists} == "false") {
			echo("There are no temporary zip files");
		}
		else {
			fail("There is a temporary zip file");
		}
	}

	@summary = "Default summary"
	macro cancelCheckoutCP(dmDocumentTitle = null, dmRepositoryName = null) {
		var key_dmDocumentTitle = ${dmDocumentTitle};

		if (${dmRepositoryName} == "true") {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#INFO",
				value1 = "You now have an indefinite lock on this document. No one else can edit this document until you unlock it. This lock will never expire.");

			LexiconEntry.gotoHeaderMenuItem(menuItem = "Cancel Checkout");
		}
		else {
			var key_dmDocumentTitle = ${dmDocumentTitle};

			DMNavigator.gotoDocumentCP(dmDocumentTitle = ${dmDocumentTitle});

			AssertTextEquals.assertPartialText(
				locator1 = "Message#CHECKOUT_SUCCESS",
				value1 = "Info:You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day.");

			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			WaitForPageLoad();

			Click(locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_VERTICAL_ELLIPSIS");

			MenuItem.click(menuItem = "Cancel Checkout");
		}

		Alert.viewSuccessMessage();
	}

