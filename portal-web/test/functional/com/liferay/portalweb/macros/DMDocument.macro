			PortletEntry.inputDescription(description = ${dmDocumentDescription});
		}

		if (isSet(viewableBy)) {
			Panel.expandPanel(panel = "Permissions");

			Select(
				locator1 = "Select#PERMISSIONS",
				value1 = ${viewableBy});
		}
