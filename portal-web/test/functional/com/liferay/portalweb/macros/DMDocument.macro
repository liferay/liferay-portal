			key_menuItem = "Download (${dmDocumentSize})",
			locator1 = "MenuItem#DROPDOWN_MENU_ITEM",
			value1 = "Download (${dmDocumentSize})");

		DMDocument.expandInfo();

		AssertTextEquals(
