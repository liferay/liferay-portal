		if (isSet(previewImage)) {
			AssertElementPresent(
				key_dmDocumentFileName = ${previewImage},
				locator1 = "DocumentsAndMediaDocument#DOCUMENT_DETAILS_IMAGE_PREVIEW");
		}

		DMDocument.expandInfo();

