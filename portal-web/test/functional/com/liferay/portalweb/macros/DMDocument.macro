	@summary = "Default summary"
	macro viewFilterByDetails(noTagNames = null, tagNames = null) {
		IFrame.selectModalFrame();

		if (isSet(tagNames)) {
			for (var tagName : list ${tagNames}) {
				AssertTextEquals.assertPartialText(
					key_tableEntry = ${tagName},
					locator1 = "LexiconTable#TABLE_ENTRY",
					value1 = ${tagName});
			}
		}
		else {
			while (IsElementPresent(locator1 = "Treeview#NODE_COLLAPSED")) {
				Click(locator1 = "Treeview#NODE_COLLAPSED");
			}

			for (var category : list ${category}) {
				AssertTextEquals(
					key_nodeName = ${category},
					locator1 = "Treeview#NODE_ITEM",
					value1 = ${category});
			}
		}

		if (isSet(subcategory)) {
			while (IsElementPresent(locator1 = "Treeview#NODE_COLLAPSED")) {
				Click(locator1 = "Treeview#NODE_COLLAPSED");
			}

			for (var subcategory : list ${subcategory}) {
				AssertTextEquals(
					key_nodeName = ${subcategory},
					locator1 = "Treeview#SUBNODE_ITEM",
					value1 = ${subcategory});
			}
		}

		if (isSet(noTagNames)) {
			for (var noTagName : list ${noTagNames}) {
				AssertElementNotPresent(
					key_tableEntry = ${noTagName},
					locator1 = "LexiconTable#TABLE_ENTRY");
			}
		}

		if (isSet(noCategory)) {
			for (var noCategory : list ${noCategory}) {
				AssertElementNotPresent(
					key_nodeName = ${noCategory},
					locator1 = "Treeview#NODE_ITEM");
			}
		}

		SelectFrame.selectFrameTop();
	}

