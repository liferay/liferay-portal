definition {

	@summary = "Default summary"
	macro _getExportPreview(portletId = null, siteExternalReferenceCode = null, sitePageExternalReferenceCode = null) {
		Variables.assertDefined(parameterList = "${portletId},${siteExternalReferenceCode}");

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/sites/${siteExternalReferenceCode}/export-preview?portletId=${portletId}\&sitePageExternalReferenceCode=${sitePageExternalReferenceCode} \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json
		''';

		var exportPreview = JSONCurlUtil.get(${curl});

		return ${exportPreview};
	}

	@summary = "Default summary"
	macro _getExportProcessContent(exportProcessId = null, filePath = null) {
		Variables.assertDefined(parameterList = "${exportProcessId},${filePath}");

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/export-processes/${exportProcessId}/content \
				-u ${userEmailAddress}:${userPassword} \
				--create-dirs \
				-o ${filePath}
		''';

		JSONCurlUtil.get(${curl});
	}

	@summary = "Default summary"
	macro _getExportProcessId(exportProcessName = null, siteExternalReferenceCode = null) {
		Variables.assertDefined(parameterList = "${exportProcessName},${siteExternalReferenceCode}");

		var portalURL = JSONCompany.getPortalURL();
		var search = URLUtil.encodeUTF8(${exportProcessName});
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/sites/${siteExternalReferenceCode}/export-processes?search=${search} \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json
		''';

		var exportProcessId = JSONCurlUtil.get(${curl}, "$.items[?(@['name'] == '${exportProcessName}')]['id']");

		if (${exportProcessId} == "") {
			fail("FAIL. Unable to find the export process ${exportProcessName}.");
		}

		return ${exportProcessId};
	}

	@summary = "Default summary"
	macro _getProcessStatusCode(processId = null, processType = null) {
		Variables.assertDefined(parameterList = "${processId},${processType}");

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/${processType}-processes/${processId} \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json
		''';

		var statusCode = JSONCurlUtil.get(${curl}, "$.status.code");

		return ${statusCode};
	}

	@summary = "Default summary"
	macro _postExportProcess(exportProcessName = null, portletDataHandlers = null, portletId = null, siteExternalReferenceCode = null, sitePageExternalReferenceCode = null) {
		Variables.assertDefined(parameterList = "${exportProcessName},${portletDataHandlers},${portletId},${siteExternalReferenceCode}");

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/sites/${siteExternalReferenceCode}/export-processes?portletId=${portletId}\&sitePageExternalReferenceCode=${sitePageExternalReferenceCode} \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json \
				-H Content-Type: application/json \
				-d {
					"comments": true,
					"name": "${exportProcessName}",
					"portletDataHandlers": ${portletDataHandlers},
					"ratings": true
				}
		''';

		var exportProcessId = JSONCurlUtil.post(${curl}, "$.id");

		return ${exportProcessId};
	}

	@summary = "Default summary"
	macro _postExportProcessRelaunch(exportProcessId = null) {
		Variables.assertDefined(parameterList = ${exportProcessId});

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/export-processes/${exportProcessId}/relaunch \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json \
				-H Content-Type: application/json
		''';

		var relaunchedExportProcessId = JSONCurlUtil.post(${curl}, "$.id");

		return ${relaunchedExportProcessId};
	}

	@summary = "Default summary"
	macro _postImportPreview(filePath = null, portletId = null, siteExternalReferenceCode = null, sitePageExternalReferenceCode = null) {
		Variables.assertDefined(parameterList = "${filePath},${portletId},${siteExternalReferenceCode}");

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/sites/${siteExternalReferenceCode}/import-preview?portletId=${portletId}\&sitePageExternalReferenceCode=${sitePageExternalReferenceCode} \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json \
				-F file=@${filePath}
		''';

		var importPreview = JSONCurlUtil.post(${curl});

		return ${importPreview};
	}

	@summary = "Default summary"
	macro _postImportProcess(dataStrategy = null, importProcessName = null, portletDataHandlers = null, portletId = null, siteExternalReferenceCode = null, sitePageExternalReferenceCode = null) {
		Variables.assertDefined(parameterList = "${dataStrategy},${importProcessName},${portletDataHandlers},${portletId},${siteExternalReferenceCode}");

		var portalURL = JSONCompany.getPortalURL();
		var userEmailAddress = JSONUtil2.getDefaultUserEmail();
		var userPassword = JSONUtil2.getDefaultUserPassword();

		var curl = '''
			${portalURL}/o/export-import/v1.0/sites/${siteExternalReferenceCode}/import-processes?portletId=${portletId}\&sitePageExternalReferenceCode=${sitePageExternalReferenceCode} \
				-u ${userEmailAddress}:${userPassword} \
				-H accept: application/json \
				-H Content-Type: application/json \
				-d {
					"comments": true,
					"dataStrategy": "${dataStrategy}",
					"name": "${importProcessName}",
					"portletDataHandlers": ${portletDataHandlers},
					"ratings": true
				}
		''';

		var importProcessId = JSONCurlUtil.post(${curl}, "$.id");

		return ${importProcessId};
	}

}