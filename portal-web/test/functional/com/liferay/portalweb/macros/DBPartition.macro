definition {

	@summary = "Exports an integrated DB Partition into a standalone partition"
	macro exportDBPartition(expectedCompanyId = null, portalInstanceId = null) {
		var sourceCompanyId = HeadlessPortalInstanceAPI.exportPortalInstance(portalInstanceId = ${portalInstanceId});

		if (isSet(expectedCompanyId)) {
			TestUtils.assertEquals(
				actual = ${sourceCompanyId},
				expected = ${expectedCompanyId});
		}

		return ${sourceCompanyId};
	}

	@summary = "Imports a standalone DB Partition as a new company"
	macro importDBPartition(partitionCompanyId = null) {
		Variables.assertDefined(parameterList = ${partitionCompanyId});

		HeadlessPortalInstanceAPI.importPortalInstance(schemaName = "lexported_${partitionCompanyId}");
	}

	@summary = "Validates that the records are correctly tied to their partitions using the portal-tools-db-partition-schema-validator tool"
	macro validateSchemas(schemaNamePrefix = null) {
		var liferayHome = PropsUtil.get("liferay.home.dir.name");

		AntCommands.runCommand("build-test.xml", "validate-db-partition-schemas -Dschema.name.prefix=${schemaNamePrefix}");

		var result = FileUtil.read("${liferayHome}/validateoutput.txt");

		if (contains(${result}, "invalid company ID") || !(contains(${result}, "Validation passed"))) {
			fail("Failed to validate DB Partition schemas.");
		}
	}

}