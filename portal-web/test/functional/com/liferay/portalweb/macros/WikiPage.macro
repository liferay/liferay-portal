				value1 = "Edit");
		}

		Panel.expandPanel(panel = "Attachments");

		AssertTextEquals(
			locator1 = "Wiki#ATTACHMENT_TABLE_FILE_NAME",
			value1 = ${attachmentFileName});

		if (isSet(attachmentFileSize)) {
