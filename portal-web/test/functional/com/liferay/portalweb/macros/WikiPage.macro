	@summary = "Default summary"
	macro tearDownCP() {
		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Wiki");

		WikiNavigator.gotoNode(wikiNodeName = "Main");

		ManagementBar.clickSelectAllCheckbox();

		Click(
			key_text = "trash",
			locator1 = "ManagementBar#ANY_ICON");

		VerifyElementPresent(locator1 = "Message#SUCCESS");

		JSONRecycleBin.emptyRecycleBin();
	}

	@summary = "Default summary"
	macro viewAttachmentPGViaEdit(wikiNodeName = null, layoutURLKey = null, groupName = null, attachmentFileName = null, wikiPageTitle = null, siteURLKey = null, attachmentFileSize = null) {
