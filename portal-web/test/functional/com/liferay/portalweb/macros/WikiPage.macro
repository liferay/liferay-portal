	@summary = "Default summary"
	macro revertEditPG(wikiPageRevisionOld = null, wikiPageTitle = null, wikiVersionSummary = null, wikiPageRevisionNew = null, wikiPageRevision = null) {
		var key_wikiPageTitle = ${wikiPageTitle};

		AssertTextEquals(
			locator1 = "Portlet#H3_HEADER",
			value1 = ${wikiPageTitle});

		AssertClick(
			locator1 = "Link#DETAILS",
			value1 = "Details");

