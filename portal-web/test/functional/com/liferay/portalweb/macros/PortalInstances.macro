definition {

	@summary = "Default summary"
	macro addCP(maxUserNumber = null, instanceAdminLastName = null, maxUsers = null, portalInstanceActive = null, instanceAdminFirstName = null, webId = null, mailDomain = null, instanceScreenName = null, instancePassword = null, virtualHost = null, instanceAdminEmail = null, synchronousCreation = null) {
		WaitForElementPresent(locator1 = "Button#PLUS");

		var virtualInstancesAdminURL = Navigator.getCurrentURL();

		Notifications.deleteAllNotifications();

		Navigator.openSpecificURL(url = ${virtualInstancesAdminURL});

		LexiconEntry.gotoAdd();

		if (IsElementPresent(key_menuItem = "Add", locator1 = "MenuItem#ANY_MENU_ITEM")) {
			MenuItem.click(menuItem = "Add");
		}

		SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Type(
			locator1 = "TextInput#WEB_ID",
			value1 = ${webId});

		Type(
			locator1 = "TextInput#VIRTUAL_HOST",
			value1 = ${virtualHost});

		Type(
			locator1 = "TextInput#MAIL_DOMAIN",
			value1 = ${mailDomain});

		if (${maxUsers} == "true") {
			Type(
				locator1 = "TextInput#MAX_USERS",
				value1 = ${maxUserNumber});
		}

		if (${portalInstanceActive} == "false") {
			Uncheck(locator1 = "Checkbox#ACTIVE");
		}

		if (isSet(instanceScreenName)) {
			Type(
				locator1 = "TextInput#VIRTUAL_INSTANCE_SCREEN_NAME",
				value1 = ${instanceScreenName});

			Type(
				locator1 = "TextInput#VIRTUAL_INSTANCE_EMAIL",
				value1 = ${instanceAdminEmail});

			Type(
				locator1 = "TextInput#VIRTUAL_INSTANCE_PASSWORD",
				value1 = ${instancePassword});
		}

		if (isSet(instanceAdminFirstName)) {
			Type(
				locator1 = "TextInput#VIRTUAL_INSTANCE_FIRST_NAME",
				value1 = ${instanceAdminFirstName});
		}

		if (isSet(instanceAdminLastName)) {
			Type(
				locator1 = "TextInput#VIRTUAL_INSTANCE_LAST_NAME",
				value1 = ${instanceAdminLastName});
		}

		SelectFrameTop();

		Button.clickAdd();

		if (${synchronousCreation} == "true") {

			// Bundles that predate LPD-93373 create the instance before the modal closes and show no creation alert. Remove once the upgrade source bundle includes LPD-93373. Needed for LPD-110381.

			WaitForElementNotPresent(locator1 = "IFrame#MODAL_BODY");
		}
		else {
			Alert.viewInfoMessageSpecific(infoMessage = "The instance ${webId} is being created. You will be notified when it finishes.");

			WaitForElementNotPresent(locator1 = "IFrame#MODAL_BODY");

			var key_contentBody = "The instance ${webId} is ready to use.";

			Navigator.gotoNotifications();

			while ((!(IsElementPresent(locator1 = "Notifications#NOTIFICATIONS_CONTENT"))) && (maxIterations = "60")) {

				// Wait for the asynchronous creation to finish. The instance is listed as soon as its company row commits, so the notification is the only signal that the initialization is done. Needed for LPD-93373.

				Pause(value1 = 5000);

				Refresh();
			}

			AssertElementPresent(locator1 = "Notifications#NOTIFICATIONS_CONTENT");
		}

		var companyId = JSONCompany.getCompanyId(portalInstanceName = ${virtualHost});

		if (!(isSet(port))) {
			var port = 8080;
		}

		var javaScript = '''
		if (typeof Liferay === "undefined") {
			return "";
		}

		return Liferay.ThemeDisplay.getCompanyId();
		''';

		Navigator.openSpecificURL(url = "http://${virtualHost}:${port}/web/guest");

		var instanceCompanyId = selenium.getEval(${javaScript});

		while ((${instanceCompanyId} != ${companyId}) && (maxIterations = "60")) {

			// Wait until the new instance serves its own guest site. The notification is sent before the instance initializes its sites. Needed for LPD-112057.

			Pause(value1 = 5000);

			Navigator.openSpecificURL(url = "http://${virtualHost}:${port}/web/guest");

			var instanceCompanyId = selenium.getEval(${javaScript});
		}

		if (${instanceCompanyId} != ${companyId}) {
			fail("The instance ${webId} did not serve its guest site at ${virtualHost}.");
		}

		Navigator.openSpecificURL(url = ${virtualInstancesAdminURL});

		var key_virtualHost = ${virtualHost};

		AssertElementPresent(locator1 = "PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST");
	}

	@summary = "Default summary"
	macro deactivatePortalInstance(virtualHost = null) {
		var key_virtualHost = ${virtualHost};

		LexiconEntry.openEntryMenu(rowEntry = ${virtualHost});

		MenuItem.click(menuItem = "Edit");

		Uncheck.uncheckToggleSwitch(locator1 = "Checkbox#ACTIVE");

		Button.clickSave();

		AssertTextEquals(
			key_columnName = "active",
			key_tableEntry = ${virtualHost},
			locator1 = "LexiconTable#TABLE_ENTRY_COLUMN_LINK",
			value1 = "No");
	}

	@summary = "Default summary"
	macro deleteCP(virtualHost = null, webId = null) {
		if (!(isSet(webId))) {
			var webId = ${virtualHost};
		}

		var key_virtualHost = ${virtualHost};

		LexiconTable.clickEllipsisItem(
			item = "Delete",
			tableEntry = ${virtualHost});

		AssertTextEquals(
			locator1 = "Modal#BODY",
			value1 = "Deleting an instance is an action impossible to revert.");

		Click(
			key_text = "Delete",
			locator1 = "Modal#MODAL_FOOTER_BUTTON");

		Alert.viewInfoMessageSpecific(infoMessage = "The instance ${webId} is being deleted. You will be notified when it finishes.");

		while ((IsElementPresent(locator1 = "PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST")) && (maxIterations = "60")) {
			Refresh();

			// Wait for the page to settle before checking again, or a mid load page reads as a deleted instance. Needed for LPD-93374.

			Pause(value1 = 5000);
		}

		AssertTextNotPresent(
			locator1 = "PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST",
			value1 = ${virtualHost});
	}

	@summary = "Default summary"
	macro editCP(mailDomain = null, virtualHost = null) {
		var key_virtualHost = ${virtualHost};

		AssertTextEquals(
			locator1 = "PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST",
			value1 = ${virtualHost});

		LexiconEntry.gotoEllipsisMenuItem(menuItem = "Edit");

		Type(
			locator1 = "TextInput#MAIL_DOMAIN",
			value1 = ${mailDomain});

		AssertClick(
			locator1 = "Button#SAVE",
			value1 = "Save");

		Alert.viewSuccessMessage();
	}

	@summary = "Default summary"
	macro openOnDemandAdminPortlet() {
		if (isSet(baseURL)) {
			var baseURL = ${baseURL};

			Navigator.openWithAppendToBaseURL(
				baseURL = ${baseURL},
				urlAppend = "group/control_panel/manage?p_p_id=com_liferay_on_demand_admin_web_internal_portlet_OnDemandAdminPortlet");
		}
		else {
			var baseURL = JSONCompany.getPortalURL();

			Navigator.openWithAppendToBaseURL(urlAppend = "group/control_panel/manage?p_p_id=com_liferay_on_demand_admin_web_internal_portlet_OnDemandAdminPortlet");
		}
	}

	@summary = "Default summary"
	macro openVirtualInstancesAdmin() {
		if (isSet(baseURL)) {
			var baseURL = ${baseURL};

			Navigator.openWithAppendToBaseURL(
				baseURL = ${baseURL},
				urlAppend = "group/control_panel/manage?p_p_id=com_liferay_portal_instances_web_portlet_PortalInstancesPortlet");
		}
		else {
			Navigator.openWithAppendToBaseURL(urlAppend = "group/control_panel/manage?p_p_id=com_liferay_portal_instances_web_portlet_PortalInstancesPortlet");
		}
	}

	@summary = "Default summary"
	macro requestOnDemandAdminOnInstance(virtualHost = null) {
		WaitForElementPresent(
			locator1 = "PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST",
			value1 = ${virtualHost});

		LexiconEntry.gotoEllipsisMenuItem(menuItem = "Request Administrator Access");

		SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Button.clickSubmitButton();

		SelectWindow(value1 = "Home - ${virtualHost}");

		WaitForElementPresent(locator1 = "Button#I_AGREE");

		SignIn.agreeToTermsOfUse();

		User.answerPasswordReminder();
	}

	@summary = "Default summary"
	macro tearDownCP(authenticationMethod = null) {
		JSONUser.tearDownNonAdminUsers(authenticationMethod = ${authenticationMethod});

		HeadlessPortalInstanceAPI.cleanAllPortalInstances(authenticationMethod = ${authenticationMethod});
	}

	@summary = "Default summary"
	macro tearDownCPNoSelenium(authenticationMethod = null) {
		JSONUser.tearDownNonAdminUsersNoSelenium(authenticationMethod = ${authenticationMethod});

		HeadlessPortalInstanceAPI.cleanAllPortalInstances(authenticationMethod = ${authenticationMethod});
	}

	@summary = "Default summary"
	macro tearDownCustomPortal(authenticationMethod = null) {
		JSONUser.tearDownNonAdminUsers(authenticationMethod = ${authenticationMethod});

		var portalURL = JSONCompany.getPortalURL();

		var portalURL = StringUtil.replace(${portalURL}, "http://", "");

		var portalInstanceId = StringUtil.replace(${portalURL}, ":8080", "");

		HeadlessPortalInstanceAPI.deletePortalInstance(portalInstanceId = ${portalInstanceId});
	}

	@summary = "Default summary"
	macro viewCP(virtualHost = null) {
		var key_virtualHost = ${virtualHost};

		AssertTextEquals.assertText(
			locator1 = "PortalInstances#INSTANCE_TABLE_WEB_ID",
			value1 = ${virtualHost});

		AssertTextEquals.assertText(
			locator1 = "PortalInstances#INSTANCE_TABLE_VIRTUAL_HOST",
			value1 = ${virtualHost});

		AssertTextEquals.assertText(
			locator1 = "PortalInstances#INSTANCE_TABLE_MAIL_DOMAIN",
			value1 = ${virtualHost});
	}

}