@component-name = "portal-content-management"
definition {

	property browser.chrome.version = "139.0";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents and Media";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			DMFolder.tearDownCP();

			Site.tearDownCP();

			User.logoutPG();
		}
	}

	@description = "This test ensures that Users can copy multiple folders with documents at the same time."
	@priority = 5
	test CanBulkCopyFoldersWithFiles {
		HeadlessSite.addSite(siteName = "Site Name");

		for (var entryCount : list "1,2,3") {
			JSONFolder.addFolder(
				dmFolderDescription = "DM Folder Description",
				dmFolderName = "DM Folder Name ${entryCount}",
				groupName = "Guest");
		}

		for (var entryCount : list "1,2,3") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document Title",
				folderName = "DM Folder Name ${entryCount}",
				groupName = "Guest",
				mimeType = "application/msword",
				sourceFileName = "Document_1.doc");
		}

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMFolder.deleteCP(dmFolderName = "Provided by Liferay");

		PortletEntry.selectAll();

		DMNavigator.gotoItemViaManagementBar(
			item = "dropdownMenu",
			menuItem = "Copy To");

		DMFolder.copy(
			bulkCopy = "true",
			homeFolder = "true",
			siteName = "Site Name");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name");

		for (var entryCount : list "1,2,3") {
			DMNavigator.gotoFolder(dmFolderName = "DM Folder Name ${entryCount}");

			LexiconEntry.viewEntryName(rowEntry = "DM Document Title");

			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name");
		}
	}

	@priority = 3
	test CanChangeRatingTypeForFolder {
		var responseFromFolder = DocumentFolderAPI.addDocumentFolder(
			groupName = "Guest",
			name = "DM Folder Name");

		Ratings.configureRatingType(
			applications = "document",
			portlet = "Ratings",
			ratingType = "Like",
			siteURLKey = "guest");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoFolder(dmFolderName = "DM Folder Name");

		DMDocument.expandInfo();

		Ratings.rateLike();

		Ratings.viewRateLike(ratingLikeCount = 1);
	}

	@description = "This test ensures that a folder can be copied to the global site folder."
	@priority = 5
	test CanCopyFolderToGlobalSite {
		JSONFolder.addFolder(
			dmFolderDescription = "DM Folder Description",
			dmFolderName = "DM Folder Name",
			groupName = "Guest");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "DM Document Title",
			folderName = "DM Folder Name",
			groupName = "Guest",
			mimeType = "application/msword",
			sourceFileName = "Document_1.doc");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMFolder.copy(
			dmFolderName = "DM Folder Name",
			homeFolder = "true",
			siteName = "Global");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		LexiconEntry.viewEntryName(rowEntry = "DM Folder Name");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "global");

		DMNavigator.gotoFolder(dmFolderName = "DM Folder Name");

		LexiconEntry.viewEntryName(rowEntry = "DM Document Title");
	}

	@priority = 3
	test CanDeleteRatingForFolder {
		var responseFromFolder = DocumentFolderAPI.addDocumentFolder(
			groupName = "Guest",
			name = "DM Folder Name");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoFolder(dmFolderName = "DM Folder Name");

		DMDocument.expandInfo();

		Ratings.rateStar(ratingStarCount = 5);

		Ratings.revokeStarsRating();
	}

	@priority = 3
	test CanEditRatingForFolder {
		var responseFromFolder = DocumentFolderAPI.addDocumentFolder(
			groupName = "Guest",
			name = "DM Folder Name");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoFolder(dmFolderName = "DM Folder Name");

		DMDocument.expandInfo();

		Ratings.rateStar(ratingStarCount = 5);

		Ratings.viewRateStar(
			averageRatingStarCount = "5.0",
			ratingStarCount = 5);

		Ratings.rateStar(ratingStarCount = 3);

		Ratings.viewRateStar(
			averageRatingStarCount = "3.0",
			ratingStarCount = 3);
	}

	@description = "This ensures that a folder can be moved to another folder via drag and drop."
	@priority = 4
	test CanMoveFolderToFolderViaDragAndDrop {
		JSONFolder.addFolder(
			dmFolderDescription = "DM Folder Description1",
			dmFolderName = "DM Folder Name1",
			groupName = "Guest");

		JSONFolder.addFolder(
			dmFolderDescription = "DM Folder Description2",
			dmFolderName = "DM Folder Name2",
			groupName = "Guest");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		LexiconEntry.changeDisplayStyle(displayStyle = "list");

		DragAndDrop.dragAndDropToObject(
			key_listEntry = "DM Folder Name1",
			key_rowEntry = "DM Folder Name2",
			locator1 = "LexiconList#ANY_LIST",
			locator2 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME",
			value1 = "DM Folder Name1");

		Alert.viewSuccessMessage();

		DMNavigator.openToFolderInAdmin(
			dmFolderName = "DM Folder Name2",
			groupName = "Guest",
			siteURLKey = "guest");

		DMFolder.viewCP(dmFolderName = "DM Folder Name1");
	}

	@description = "This test ensures that an error is displayed when copying a duplicated folder."
	@priority = 4
	test CannotCopyDuplicatedDocument {
		HeadlessSite.addSite(siteName = "Site Name");

		JSONFolder.addFolder(
			dmFolderDescription = "DM Folder Description",
			dmFolderName = "DM Folder Name",
			groupName = "Guest");

		JSONFolder.addFolder(
			dmFolderDescription = "DM Folder Description",
			dmFolderName = "DM Folder Name",
			groupName = "Site Name");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMFolder.copy(
			copyDuplicatedDocument = "true",
			dmFolderName = "DM Folder Name",
			homeFolder = "true",
			siteName = "Site Name");
	}

	@priority = 3
	test ViewRatingForFolderAfterPostByAPI {
		var responseFromFolder = DocumentFolderAPI.addDocumentFolder(
			groupName = "Guest",
			name = "DM Folder Name");

		var documentFolderId = JSONPathUtil.getIdValue(response = ${responseFromFolder});

		var response = DocumentFolderAPI.postRatingWithFolderID(
			folderId = ${documentFolderId},
			ratingValue = 1);

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoFolder(dmFolderName = "DM Folder Name");

		DMDocument.expandInfo();

		Ratings.viewRateStar(
			averageRatingStarCount = "5.0",
			ratingStarCount = 5);
	}

}