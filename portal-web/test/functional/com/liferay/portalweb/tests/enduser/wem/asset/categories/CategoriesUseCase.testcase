@component-name = "portal-content-management"
definition {

	property ci.retries.disabled = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Categories";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		HeadlessSite.addSite(siteName = "Test Site Name");
	}

	@description = "This is a test for LPS-143509. The sites creator can add a site with required vocabulary."
	@priority = 4
	test AddSiteWithRequiredVocabulary {
		property portal.upstream = "quarantine";

		task ("Given a site creator has a required vocabulary on Global site") {
			task ("Add a vocabulary with site as associated asset type") {
				Category.openCategoriesAdmin(siteURLKey = "global");

				Vocabulary.addWithAssociatedAssetTypeCP(
					assetType = "Site",
					required = "true",
					vocabularyName = "Vocabulary Name");
			}

			task ("Add category to vocabulary") {
				JSONCategory.addCategory(
					groupName = "Global",
					title = "Category Name",
					vocabularyName = "Vocabulary Name");
			}
		}

		task ("When the site creator tries to add a new site without select required category") {
			Site.openSitesAdmin();

			LexiconEntry.gotoAdd();

			LexiconCard.clickCard(card = "Blank Site");

			SelectFrame(locator1 = "IFrame#MODAL_BODY");

			PortletEntry.inputName(name = "Second Site Name");

			Button.click(button = "Add");
		}

		task ("Then the site creator should see an error message") {
			Alert.viewErrorMessage(errorMessage = "Error:Please select at least one category for Vocabulary Name.");
		}

		task ("When the site creator selects a category on vocabulary field") {
			Button.clickSelect();

			AssetCategorization.selectCategories(
				categoryNameList = "Category Name",
				modalTitle = "Add Site");
		}

		task ("Then the site creator can successfully create the site") {
			task ("View site is successfully created") {
				SelectFrameTop();

				SelectFrame(locator1 = "IFrame#MODAL_BODY");

				Button.clickAdd();

				Alert.viewSuccessMessage();

				ControlMenu.viewHeaderTitle(headerTitle = "Site Settings");
			}

			task ("Delete global category") {
				JSONCategory.deleteVocabulary(
					groupName = "Global",
					vocabularyName = "Vocabulary Name");
			}
		}
	}

}