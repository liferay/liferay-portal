@component-name = "portal-content-management"
definition {

	property portal.acceptance = "false";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page");

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Guest",
			layoutName = "Blogs Page",
			widgetName = "Blogs");
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();
		}
	}

	@description = "This is a test for LPS-136774, LPS-136775, LPS-136776, and LPS-136777. It checks that a blog can be properly displayed in Arabic and Japanese in both the Blogs widget and the Blogs Aggregator."
	@priority = 3
	test CanViewBlogsEntryInArabicAndJapanese {
		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Guest",
			layoutName = "Blogs Page",
			widgetName = "Blogs Aggregator");

		JSONBlog.addEntry(
			entryContent = "محتوى دخول المدونات",
			entryTitle = "عنوان إدخال المدونات");

		JSONBlog.addEntry(
			entryContent = "ブログエントリコンテンツ",
			entryTitle = "ブログエントリタイトル");

		Navigator.gotoPage(pageName = "Blogs Page");

		BlogsEntry.viewPG(
			entryContent = "محتوى دخول المدونات",
			entryTitle = "عنوان إدخال المدونات");

		BlogsEntry.viewPG(
			entryContent = "ブログエントリコンテンツ",
			entryTitle = "ブログエントリタイトル");

		BlogsAggregatorPortlet.viewBlogsEntryViaBAPortletPG(
			entryContent = "محتوى دخول المدونات",
			entryTitle = "عنوان إدخال المدونات");

		BlogsAggregatorPortlet.viewBlogsEntryViaBAPortletPG(
			entryContent = "ブログエントリコンテンツ",
			entryTitle = "ブログエントリタイトル");
	}

	@description = "This is a test for LPS-136778. It checks that social bookmarks for a Blog can be viewed in Japanese."
	@priority = 3
	test CanViewSocialBookmarksInJapanese {
		JSONBlog.addEntry(
			entryContent = "Blogs Entry Content",
			entryTitle = "Blogs Entry Title");

		Navigator.openWithAppendToBaseURL(urlAppend = "ja/web/guest/blogs-page");

		SocialBookmarks.viewDefaultSharableBookmarks();
	}

}