@component-name = "portal-content-management"
definition {

	property browser.chrome.version = "139.0";
	property custom.properties = "default.layout.template.id=1_column${line.separator}dl.actions.visible=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents and Media";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		task ("Enable dynamic and manual selection") {
			AssetPublisherPortlet.enableDynamicAndManualSelection();
		}

		HeadlessSite.addSite(siteName = "Site Name");

		JSONLayout.addPublicLayout(
			groupName = "Site Name",
			layoutName = "Staging DM Page");

		JSONStaging.enableLocalStaging(groupName = "Site Name");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name-staging");
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONGroup.deleteGroupByName(groupName = "Site Name");

			JSONDepot.deleteDepot(depotName = "Test Depot Name");
		}
	}

	@description = "This test covers LPS-126751. It ensures that a user cannot create a metadata set without a field."
	@priority = 4
	@refactordone
	test CannotAddMetadataSetWithEmptyField {
		DMNavigator.openMetadataSetsAdmin(siteURLKey = "site-name-staging");

		DMMetadataSet.addTitle(metadataSetName = "Document Metadata Set Name");

		Button.clickSave();

		AssertTextEquals.assertPartialText(
			locator1 = "Message#ERROR",
			value1 = "Error:At least one field must be added.");
	}

	@description = "This is a test for LPS-91043. It asserts that user can not publish from old versions to live."
	@priority = 4
	test CanNotPublishFromOldVersions {
		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "DM Document Title",
			groupName = "Site Name-staging",
			mimeType = "image/jpeg",
			sourceFileName = "Document_1.jpg");

		DMNavigator.openToEditEntryInSite(
			dmDocumentTitle = "DM Document Title",
			groupName = "Site Name (Staging)",
			site = "false",
			siteURLKey = "site-name-staging");

		DMDocument.editCmd(dmDocumentTitleEdit = "DM Document Title Edit");

		Button.clickPublish();

		DMNavigator.openToEntryInAdmin(
			dmDocumentTitle = "DM Document Title Edit",
			groupName = "Site Name (Staging)",
			site = "false",
			siteURLKey = "site-name-staging");

		for (var n : list "0,1") {
			DMDocument.viewNoItemInVersionMenu(
				dmDocumentVersionNumber = "1.${n}",
				menuItem = "Publish to Live");
		}
	}

	@description = "This is a use case for LPS-74621."
	@priority = 3
	@refactordone
	test CanOnlyCommentOnLiveSite {
		property portal.acceptance = "false";

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Site Name (Staging)",
			layoutName = "Staging DM Page",
			site = "false",
			widgetName = "Documents and Media");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "DM Document Title",
			groupName = "Site Name-staging",
			mimeType = "application/msword",
			sourceFileName = "Document_1.doc");

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		LexiconEntry.changeDisplayStyle(displayStyle = "cards");

		DMDocument.gotoEntry(dmDocumentTitle = "DM Document Title");

		Comments.addPG(entryComment = "DM Document Comment");

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		DMDocument.gotoEntry(dmDocumentTitle = "DM Document Title");

		Comments.viewPG(
			commentCount = 1,
			entryComment = "DM Document Comment",
			userFullName = "Test Test (You)");

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		DMDocument.gotoEntry(dmDocumentTitle = "DM Document Title");

		Comments.viewCommentReadOnly();
	}

	@description = "This test covers LPS-154415. It checks that an external video displays properly in the Media Gallery widget after the friendlyURL has been edited and published on a site."
	@priority = 4
	test CanViewExternalVideoInMGAfterFriendlyURLIsUpdated {
		PortalSettings.openToConfigInInstanceSettings(portletId = "com.liferay.portal.security.iframe.sanitizer.configuration.IFrameConfiguration");

		SystemSettings.configureSystemSetting(
			enableSetting = "false",
			settingFieldName = "Enabled");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name-staging");

		JSONDepot.addDepot(
			depotDescription = "This is the description of a depot",
			depotName = "Test Depot Name");

		JSONStaging.enableLocalStaging(
			groupName = "Test Depot Name",
			site = "false");

		JSONDepot.connectSite(
			depotName = "Test Depot Name (Staging)",
			groupName = "Site Name (Staging)",
			site = "false");

		DepotNavigator.openDepotDocumentsAndMediaAdminStaging(depotName = "Test Depot Name");

		VideoShortcut.addCP(
			videoShortcutTitle = "Test YouTube Video",
			videoURL = "https://www.youtube.com/watch?v=HOdbzGCI5ME");

		DepotNavigator.openToEditDMEntryInDepot(
			depotName = "Test Depot Name",
			dmDocumentTitle = "Test YouTube Video",
			staging = "true");

		DMDocument.editFriendlyURL(
			dmDocumentTitle = "Test YouTube Video",
			friendlyURLEdit = "custom-url");

		JSONLayout.addWidgetToPublicLayout(
			groupName = "Site Name (Staging)",
			layoutName = "Staging DM Page",
			site = "false",
			widgetName = "Media Gallery");

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		MGPortlet.setRootFolder(
			depotName = "Test Depot Name",
			selectRootFolder = "true");

		DepotNavigator.openDepotAssetListsAdminStaging(depotName = "Test Depot Name");

		DepotNavigator.switchStagingStatus(stagingItem = "Publish to Live");

		Staging.publishToLive();

		Refresh();

		DepotNavigator.openToEditDMEntryInDepot(
			depotName = "Test Depot Name",
			dmDocumentTitle = "Test YouTube Video",
			staging = "true");

		DMDocument.editFriendlyURL(
			dmDocumentTitle = "Test YouTube Video",
			friendlyURLEdit = "new-custom-url");

		DepotNavigator.openDepotAssetListsAdminStaging(depotName = "Test Depot Name");

		DepotNavigator.switchStagingStatus(stagingItem = "Publish to Live");

		Staging.publishToLive();

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		DMDocument.viewPGViaMG(
			mgDocumentTitle = "HOdbzGCI5ME",
			staging = "true");

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		DMDocument.viewPGViaMG(
			mgDocumentTitle = "HOdbzGCI5ME",
			staging = "true");
	}

