			dmDocumentSize = "6 KB",
			dmDocumentTitle = "DM Document Title Edit",
			dmDocumentType = "Basic Document",
			dmDocumentUploader = "Test Test",
			dmDocumentVersionNumber = "2.0",
			dmFolderName = "Home",
			locationFieldName = "true",
			tagNameList = "tag1");

		DMDocument.viewLatestVersionURL(
			dmDocumentFileName = "document_1",
			siteName = "site-name");

		DMDocument.viewWebDAVURL(
			dmDocumentFileName = "Document_3Edit.png",
			siteName = "site-name");
	}

	@description = "This test covers LPS-155794. It ensures that an image that was published on a site can still be accessed after local staging is disabled."
	@priority = 4
	test ImageIsStillAccessibleAfterDisablingStaging {
		var portalURL = PropsUtil.get("portal.url");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "Document_2",
			groupName = "Site Name-staging",
			mimeType = "image/jpeg",
			sourceFileName = "Document_2.jpg");

		DMNavigator.openToEditEntryInSite(
			dmDocumentTitle = "Document_2",
			groupName = "Site Name (Staging)",
			site = "false",
			siteURLKey = "site-name-staging");

		DMDocument.editFriendlyURL(
			dmDocumentTitle = "Document_2",
			friendlyURLEdit = "document_2_edit");

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		DMNavigator.openToEntryInAdmin(
			dmDocumentTitle = "Document_2",
			groupName = "Site Name",
			siteURLKey = "site-name");

		var latestVersionURL = DMDocument.getLatestVersionURL();

		Staging.openStagingAdmin(siteURLKey = "site-name-staging");

		Staging.deactivateStagingCP(siteName = "Site Name");

		Navigator.openSpecificURL(url = ${latestVersionURL});

		AssertVisible(
			key_imageSourceURL = "${portalURL}/documents/d/site-name/document_2_edit",
			locator1 = "DocumentsAndMediaDocument#DOCUMENT_VIEWPORT_PREVIEW");
	}

	@description = "This test covers LPS-90557. It ensures that a basic document and a shortcut pointing to it can be removed and republished when enabling local staging."
	@priority = 4
	test ShortcutDisppearsAfterTargetDeletionIsPublished {
		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "DM Document Title",
			groupName = "Site Name-staging",
			mimeType = "image/jpeg",
			sourceFileName = "Document_1.jpg");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name-staging");

		DMDocument.addDMShortcutCP(
			dmDocumentTitle = "DM Document Title",
			stagingSiteName = "true");

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		JSONDocument.deleteFile(
			dmDocumentTitle = "DM Document Title",
			groupName = "Site Name (Staging)",
			site = "false");

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name");

		DMDocument.viewDefault();

		AssertConsoleTextNotPresent(value1 = "PortletDataException");
	}

	@description = "This ensures that the image can be deleted and republished in web content."
	@priority = 4
	@refactordone
	test ViewWebContentWithDeletedImage {
		property portal.acceptance = "true";

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Site Name (Staging)",
			layoutName = "Staging DM Page",
			site = "false",
			widgetName = "Web Content Display");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "Document_2.jpg",
			groupName = "Site Name-staging",
			mimeType = "image/jpeg",
			sourceFileName = "Document_2.jpg");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name-staging");

		Staging.publishViaSAP(
			confirmMessage = "Are you sure you want to publish the selected document?",
			entry = "Document_2.jpg");

		task ("Add a web content structure with image field") {
			WebContentNavigator.openWebContentAdmin(siteURLKey = "site-name-staging");

			NavItem.gotoStructures();

			WebContentStructures.addCP(structureName = "WC Structure Name");

			DataEngine.addField(
				fieldFieldLabel = "Image",
				fieldName = "Image");

			Button.clickSave();
		}

		task ("Add a web content with custom structure") {
			NavItem.click(navItem = "Web Content");

			WebContentNavigator.gotoAddWithStructureCP(structureName = "WC Structure Name");

			WebContent.addWithStructureCP(
				imageFileName = "Document_2.jpg",
				navTab = "Documents and Media",
				structureName = "WC Structure Name",
				webContentImage = "Document_2.jpg",
				webContentTitle = "Web Content Title");

			WebContent.publishWithPermissions();
		}

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		WebContentDisplayPortlet.selectWebContent(webContentTitle = "Web Content Title");

		Navigator.openSiteURL(siteName = "Site Name");

		Navigator.gotoStagedView();

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		WebContentDisplayPortlet.viewContent(
			imageFileName = "Document_2.jpg",
			webContentTitle = "Web Content Title");

		JSONDocument.deleteFile(
			dmDocumentTitle = "Document_2.jpg",
			groupName = "Site Name (Staging)",
			site = "false");

		Navigator.openSiteURL(siteName = "Site Name");

		Navigator.gotoStagedView();

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		AssertElementNotPresent(
			key_imageFileName = "Document_2.jpg",
			key_webContentTitle = "Web Content Title",
			locator1 = "WCD#WEB_CONTENT_IMAGE");
	}

	@description = "This ensures that the image can be edited and republished in web content."
	@priority = 4
	@refactordone
	test ViewWebContentWithRepublishedImage {
		property portal.acceptance = "true";

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Site Name (Staging)",
			layoutName = "Staging DM Page",
			site = "false",
			widgetName = "Web Content Display");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "Document_2.jpg",
			groupName = "Site Name-staging",
			mimeType = "image/jpeg",
			sourceFileName = "Document_2.jpg");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name-staging");

		Staging.publishViaSAP(
			confirmMessage = "Are you sure you want to publish the selected document?",
			entry = "Document_2.jpg");

		task ("Add a web content structure with image field") {
			WebContentNavigator.openWebContentAdmin(siteURLKey = "site-name-staging");

			NavItem.gotoStructures();

			WebContentStructures.addCP(structureName = "WC Structure Name");

			DataEngine.addField(
				fieldFieldLabel = "Image",
				fieldName = "Image");

			Button.clickSave();
		}

		task ("Add a web content with custom structure") {
			NavItem.click(navItem = "Web Content");

			WebContentNavigator.gotoAddWithStructureCP(structureName = "WC Structure Name");

			WebContent.addWithStructureCP(
				imageFileName = "Document_2.jpg",
				navTab = "Documents and Media",
				structureName = "WC Structure Name",
				webContentImage = "Document_2.jpg",
				webContentTitle = "Web Content Title");

			WebContent.publishWithPermissions();
		}

		Navigator.gotoStagedSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		WebContentDisplayPortlet.selectWebContent(webContentTitle = "Web Content Title");

		Navigator.openSiteURL(siteName = "Site Name");

		Navigator.gotoStagedView();

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		WebContentDisplayPortlet.viewContent(
			imageFileName = "Document_2.jpg",
			webContentTitle = "Web Content Title");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "site-name-staging");

		DMDocument.editCP(
			dmDocumentFileEdit = "Document_3.jpg",
			dmDocumentFileNameEdit = "Document_3.jpg",
			dmDocumentTitle = "Document_2.jpg",
			dmDocumentTitleEdit = "Document_3.jpg");

		Navigator.openSiteURL(siteName = "Site Name");

		Navigator.gotoStagedView();

		Staging.gotoPublishToLive();

		Staging.publishToLive();

		Navigator.gotoSitePage(
			pageName = "Staging DM Page",
			siteName = "Site Name");

		WebContentDisplayPortlet.viewContent(
			imageFileName = "Document_3.jpg",
			webContentTitle = "Web Content Title");
	}

}