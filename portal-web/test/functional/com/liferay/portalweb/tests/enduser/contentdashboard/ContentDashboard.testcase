		task ("Go to Content Dashboard and click on the title") {
			ContentDashboard.goToContentDashboard();

			LexiconTable.clickTableEntryColumnLink(
				columnName = "title",
				tableEntry = "");
		}

		task ("Assert the web content is opened in the web content editor") {
