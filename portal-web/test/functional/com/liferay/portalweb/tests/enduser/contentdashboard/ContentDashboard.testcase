		}
	}

	@description = "LPS-133354 Given The Extension filter modal When the text input matches to one or more extensions from a MIME type and the user clicks on the MIME type parent Then all the children that appear filtered will be selected"
	@priority = 3
	test SelectedParentAndChildExtensions {
		task ("Add a text file") {
