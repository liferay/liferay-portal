@component-name = "portal-content-management"
definition {

	property ci.retries.disabled = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Content Dashboard";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		HeadlessSite.addSite(siteName = "Test Site Name");

		JSONLayout.addPublicLayout(
			groupName = "Test Site Name",
			layoutName = "Test Page");

		Category.openCategoriesAdmin(siteURLKey = "test-site-name");
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONUser.tearDownNonAdminUsers();

			JSONGroup.deleteGroupByName(groupName = "Test Site Name");
		}
	}

	@description = "LPS-122873 When there are some categories created for vocabulary1 (X axis), they will always have the same order during the user session"
	@priority = 3
	test CategoriesWithSameOrderDuringASession {
		task ("Create a list of Audiences") {
			var categoryId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "C_Subaudience_1",
				vocabularyName = "Audience");
			var categoryId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "B_Subaudience_2",
				vocabularyName = "Audience");
			var categoryId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "A_Subaudience_3",
				vocabularyName = "Audience");
		}

		task ("Create a Web Content") {
			JSONWebcontent.addWebContent(
				assetCategoryIds = "${categoryId1},${categoryId2},${categoryId3}",
				content = "test content",
				groupName = "Test Site Name",
				title = "Web Content Title 1");

			JSONWebcontent.addWebContent(
				assetCategoryIds = "${categoryId1},${categoryId2},${categoryId3}",
				content = "test content",
				groupName = "Test Site Name",
				title = "Web Content Title 2");
		}

		task ("Validade if the categories are shown in order of creation") {
			SetWindowSize.maximizeWindow();

			ContentDashboard.goToContentDashboard();

			AssertTextEquals.assertPartialText(
				categoryIndex = 1,
				locator1 = "ContentDashboard#X_AXIS_CATEGORIES_NAME",
				value1 = "C_Subaudien");

			AssertTextEquals.assertPartialText(
				categoryIndex = 2,
				locator1 = "ContentDashboard#X_AXIS_CATEGORIES_NAME",
				value1 = "B_Subaudien");

			AssertTextEquals.assertPartialText(
				categoryIndex = 3,
				locator1 = "ContentDashboard#X_AXIS_CATEGORIES_NAME",
				value1 = "A_Subaudien");
		}
	}

	@description = "LPS-131793 Given the categorization section in Documents and Media Then the OOTB Internal (Topic) and Public (Audience & Stage) vocabularies are shown, together with newly created Global and Site internal vocabularies"
	@priority = 3
	test CategorizationInOOTBTable {
		task ("Add a Global internal vocabulary and a Site internal vocabulary") {
			JSONCategory.addVocabulary(
				groupName = "Global",
				title = "Global Vocabulary",
				visibility = "internal");

			JSONCategory.addVocabulary(
				groupName = "Test Site Name",
				title = "Site Vocabulary",
				visibility = "internal");
		}

		task ("Go to Documents and Media and clik on Add Button and File Upload") {
			DMNavigator.openToAddEntry(
				groupName = "Test Site Name",
				siteURLKey = "test-site-name");
		}

		task ("Go to categorization and check if Topic, Audience and Stage are present") {
			Panel.expandPanel(panel = "Categorization");
		}

		task ("Check if the words Topic, Audience and Stage are shown") {
			AssertElementPresent(
				key_fieldLabel = "Topic",
				locator1 = "AssetCategorization#VOCABULARY_LIST_ITEM");

			AssertElementPresent(
				key_fieldLabel = "Audience",
				locator1 = "AssetCategorization#VOCABULARY_LIST_ITEM");

			AssertElementPresent(
				key_fieldLabel = "Stage",
				locator1 = "AssetCategorization#VOCABULARY_LIST_ITEM");
		}

		task ("Check if the new Global and Site internal vocabularies are shown") {
			AssertElementPresent(
				key_fieldLabel = "Global Vocabulary",
				locator1 = "AssetCategorization#VOCABULARY_LIST_ITEM");

			AssertElementPresent(
				key_fieldLabel = "Site Vocabulary",
				locator1 = "AssetCategorization#VOCABULARY_LIST_ITEM");
		}
	}

	@description = "This is a test for LPS-164348. The kebab menu next to a segment must have icons next to the menu items."
	@priority = 4
	test CheckCollapseSection {
		task ("Given web content with categories and tags") {
			var audienceId = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_1",
				vocabularyName = "Audience");
			var stageId = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_1",
				vocabularyName = "Stage");
			var topicId = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subtopic_1",
				vocabularyName = "Topic");

			JSONWebcontent.addWebContent(
				assetCategoryIds = "${audienceId},${stageId},${topicId}",
				assetTagNames = "tagname",
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "Webcontent Title");
		}

		task ("When open the Info Panel in the Content Dashboard") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.openInfoPanel(assetName = "Webcontent Title");
		}

		task ("Then it should be possible to view the collapsed panels of Categories and Tags in the Categorization tab.") {
			Navigator.gotoNavTab(navTab = "Categorization");

			for (var categorie : list "Public Categories,Internal Categories,Tags") {
				AssertElementPresent(
					key_panel = ${categorie},
					locator1 = "Panel#PANEL_EXPANDED");
			}
		}
	}

	@description = "LPS-122873 When any web content is unassigned to a Vocab1's category, the relative ordering of categories remain the same"
	@priority = 3
	test CheckOrderEvenWithSomeUnassignedCategories {
		task ("Create a list of Audience Categories") {
			var audienceId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_1",
				vocabularyName = "Audience");
			var audienceId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_2",
				vocabularyName = "Audience");
			var audienceId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_3",
				vocabularyName = "Audience");
		}

		task ("Create a list of Stage Categories") {
			var stageId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_1",
				vocabularyName = "Stage");
			var stageId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_2",
				vocabularyName = "Stage");
			var stageId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_3",
				vocabularyName = "Stage");
		}

		task ("Create 1st Web Content with all categories but the 2nd category of Audience") {
			JSONWebcontent.addWebContent(
				assetCategoryIds = "${audienceId1},${audienceId3},${stageId1},${stageId2},${stageId3}",
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "Webcontent Title 1");
		}

		task ("Create 2nd and 3rd Web Contents with all categories from Audience and Stage") {
			for (var count : list "2,3") {
				JSONWebcontent.addWebContent(
					assetCategoryIds = "${audienceId1},${audienceId2},${audienceId3},${stageId1},${stageId2},${stageId3}",
					content = "Webcontent Content",
					groupName = "Test Site Name",
					title = "Webcontent Title ${count}");
			}
		}

		task ("Navigate to content Dashboard and View the order of categories") {
			ContentDashboard.goToContentDashboard();

			task ("blue - first position") {
				AssertElementPresent(
					fillColor = "4B9FFF",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("orange - second position") {
				AssertElementPresent(
					fillColor = "FFB46E",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("red - third position") {
				AssertElementPresent(
					fillColor = "FF5F5F",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}
		}
	}

	@description = "LPS-122873 When a new category is created and assigned to a web content, the relative ordering of categories remain the same and the new category gets a new color, positionated in the last position"
	@priority = 3
	test CheckTheOrderWithANewCategory {
		task ("Create a list of Audience Categories") {
			var audienceId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_1",
				vocabularyName = "Audience");
			var audienceId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_2",
				vocabularyName = "Audience");
			var audienceId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_3",
				vocabularyName = "Audience");
		}

		task ("Create a list of Stage Categories") {
			var stageId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_1",
				vocabularyName = "Stage");
			var stageId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_2",
				vocabularyName = "Stage");
			var stageId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_3",
				vocabularyName = "Stage");
		}

		task ("Create a Web Content with the categories") {
			JSONWebcontent.addWebContent(
				assetCategoryIds = "${audienceId1},${audienceId2},${audienceId3},${stageId1},${stageId2},${stageId3}",
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "Webcontent Title");
		}

		task ("Create a new category and assign one of the contents") {
			JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_4",
				vocabularyName = "Stage");

			WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

			WebContentNavigator.gotoEditCP(webContentTitle = "Webcontent Title");

			WebContent.selectCategory(
				categoryNameList = "Substage_4",
				vocabularyName = "Stage");

			WebContent.publishExistingWCArticleWithPermissions();
		}

		task ("Navigate to the content panel and see if, in the new category order, the new category receives a new color, placed in the last position") {
			ContentDashboard.goToContentDashboard();

			task ("blue - first position") {
				AssertElementPresent(
					fillColor = "4B9FFF",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("orange - second position") {
				AssertElementPresent(
					fillColor = "FFB46E",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("red - third position") {
				AssertElementPresent(
					fillColor = "FF5F5F",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("green - last position") {
				AssertElementPresent(
					fillColor = "50D2A0",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}
		}
	}

	@description = "LPS-164334 Add a Version History Page to Documents and Media"
	@priority = 4
	test DocumentsVersionHistoryDeleteVersion {
		property portal.acceptance = "true";

		task ("Given the Version History page for documents") {
			task ("Create a Document") {
				JSONDocument.addFileWithUploadedFile(
					dmDocumentDescription = "DM Document Description",
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					mimeType = "text/plain",
					sourceFileName = "Document_1.txt");
			}

			task ("Add versions for the document") {
				ContentDashboard.createVersionsForDocument(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					versionsCreated = 2);
			}

			task ("Navigate to Version History Page") {
				ContentDashboard.navigateToDocumentVersionHistoryPage(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					siteURLKey = "test-site-name");
			}
		}

		task ("When the user clicks on Delete option the kebab menu") {
			PortletEntry.deleteViaMenuItem(rowEntry = "1.2");

			Alert.viewSuccessMessage();
		}

		task ("Then the document's version is deleted") {
			AssertElementNotPresent(
				key_tableEntry = "1.2",
				locator1 = "LexiconTable#TABLE_ENTRY");

			AssertVisible(
				key_tableEntry = "1.1",
				locator1 = "LexiconTable#TABLE_ENTRY");
		}
	}

	@description = "LPS-164334 Add a Version History Page to Documents and Media"
	@priority = 3
	@uitest
	test DocumentsVersionHistoryInformation {
		var groupId = JSONGroupSetter.setGroupId(groupName = "Test Site Name");

		task ("Given the Version History page for documents") {
			task ("Create a Document") {
				JSONDocument.addFileWithUploadedFile(
					dmDocumentDescription = "DM Document Description",
					dmDocumentTitle = "DM Document Title",
					mimeType = "text/plain",
					repositoryId = ${groupId},
					sourceFileName = "Document_1.txt");
			}

			task ("Add versions for the document") {
				ContentDashboard.createVersionsForDocument(
					dmDocumentTitle = "DM Document Title",
					groupId = ${groupId},
					versionsCreated = 10);
			}

			task ("Navigate to Content Dashboard") {
				ContentDashboard.goToContentDashboard();
			}

			task ("Open info panel sidebar") {
				LexiconTable.clickEllipsisItem(
					item = "Info",
					tableEntry = "DM Document Title");
			}

			task ("Open versions tab") {
				ContentDashboard.openVersionsTab(assetName = "DM Document Title");
			}
		}

		task ("When the user access to the page") {
			ContentDashboard.clickViewMore();
		}

		task ("Then the table includes the ID of the Document, Title, Version Number, Status, Modified Date, and Author") {
			AssertVisible(
				key_tableHeader = "ID",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Title",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Version",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Status",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Modified Date",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Author",
				locator1 = "LexiconTable#TABLE_HEADER");
		}
	}

	@description = "LPS-164334 Add a Version History Page to Documents and Media"
	@priority = 3
	@uitest
	test DocumentsVersionHistoryOrdered {
		var groupId = JSONGroupSetter.setGroupId(groupName = "Test Site Name");

		task ("Given the Version History page for documents") {
			task ("Create a Document") {
				JSONDocument.addFileWithUploadedFile(
					dmDocumentDescription = "DM Document Description",
					dmDocumentTitle = "DM Document Title",
					mimeType = "text/plain",
					repositoryId = ${groupId},
					sourceFileName = "Document_1.txt");
			}

			task ("Add versions for the document") {
				ContentDashboard.createVersionsForDocument(
					dmDocumentTitle = "DM Document Title",
					groupId = ${groupId},
					versionsCreated = 10);
			}

			task ("Navigate to Content Dashboard") {
				ContentDashboard.goToContentDashboard();
			}

			task ("Open info panel sidebar") {
				LexiconTable.clickEllipsisItem(
					item = "Info",
					tableEntry = "DM Document Title");
			}

			task ("Open versions tab") {
				ContentDashboard.openVersionsTab(assetName = "DM Document Title");
			}
		}

		task ("When the user access to the page") {
			ContentDashboard.clickViewMore();
		}

		task ("Then the table lists all the Version entries ordered by Version with the latest entries at the top") {
			ContentDashboard.viewHistoryVersionOrder(assetVersionList = "1.11,1.10,1.9,1.8,1.7,1.6,1.5,1.4,1.3,1.2,1.1,1.0");
		}
	}

	@description = "LPS-164334 Add a Version History Page to Documents and Media"
	@priority = 3
	test DocumentVersionHistoryKebabOptions {
		task ("Given the Version History page for documents") {
			task ("Create a Document") {
				JSONDocument.addFileWithUploadedFile(
					dmDocumentDescription = "DM Document Description",
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					mimeType = "text/plain",
					sourceFileName = "Document_1.txt");
			}

			task ("Add one version for the document") {
				JSONDocument.checkOutFile(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name");

				JSONDocument.checkInFile(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name");
			}

			task ("Navigate to Version History Page") {
				ContentDashboard.navigateToDocumentVersionHistoryPage(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					siteURLKey = "test-site-name");
			}
		}

		task ("When the user clicks on the kebab menu of the first entry Then the actions will be Download, View and Delete") {
			Click.waitForMenuToggleJSClick(
				key_tableEntry = "1.1",
				locator1 = "LexiconTable#TABLE_ENTRY_ELLIPSIS");

			AssertVisible(
				key_text = "download",
				locator1 = "MenuItem#ANY_ICON");

			AssertVisible(
				key_menuItem = "View",
				locator1 = "MenuItem#ANY_MENU_ITEM");

			AssertVisible(
				key_menuItem = "Delete",
				locator1 = "MenuItem#ANY_MENU_ITEM");
		}

		task ("When the user clicks on the kebab menu of any entry different than the first one Then the actions will be Download, View, Revert and Delete") {
			ContentDashboard.navigateToDocumentVersionHistoryPage(
				dmDocumentTitle = "DM Document Title",
				groupName = "Test Site Name",
				siteURLKey = "test-site-name");

			Click.waitForMenuToggleJSClick(
				key_tableEntry = "1.0",
				locator1 = "LexiconTable#TABLE_ENTRY_ELLIPSIS");

			AssertVisible(
				key_text = "download",
				locator1 = "MenuItem#ANY_ICON");

			AssertVisible(
				key_menuItem = "View",
				locator1 = "MenuItem#ANY_MENU_ITEM");

			AssertVisible(
				key_menuItem = "Revert",
				locator1 = "MenuItem#ANY_MENU_ITEM");

			AssertVisible(
				key_menuItem = "Delete",
				locator1 = "MenuItem#ANY_MENU_ITEM");
		}

		task ("When there is only one version entry And the user clicks on its kebab menu Then the actions will be Download and View") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document Title 2",
				groupName = "Test Site Name",
				mimeType = "text/plain",
				sourceFileName = "Document_2.txt");

			ContentDashboard.navigateToDocumentVersionHistoryPage(
				dmDocumentTitle = "DM Document Title 2",
				groupName = "Test Site Name",
				siteURLKey = "test-site-name");

			Click.waitForMenuToggleJSClick(
				key_tableEntry = "DM Document Title 2",
				locator1 = "LexiconTable#TABLE_ENTRY_ELLIPSIS");

			AssertVisible(
				key_text = "download",
				locator1 = "MenuItem#ANY_ICON");

			AssertVisible(
				key_menuItem = "View",
				locator1 = "MenuItem#ANY_MENU_ITEM");
		}
	}

	@description = "LPS-146550 Bug: Filter by extension does not shown any result after duplicate a MIME type"
	@priority = 4
	test FilterByDuplicatedMimeType {
		property portal.acceptance = "true";
		property test.liferay.virtual.instance = "false";
		property test.run.type = "single";

		task ("Add documents with different mime types") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "Document_Audio",
				groupName = "Test Site Name",
				mimeType = "audio/mp3",
				sourceFileName = "Document_1.mp3");

			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "Document_Code",
				groupName = "Test Site Name",
				mimeType = "code/html",
				sourceFileName = "fragment_freemarker_basic.html");

			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "Document_Presentation",
				groupName = "Test Site Name",
				mimeType = "application/powerpoint",
				sourceFileName = "Document_1.pptx");

			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "Document_Text",
				groupName = "Test Site Name",
				mimeType = "text/txt",
				sourceFileName = "Document_1.txt");
		}

		task ("Check, in Content Dashboard, that types are correctly displayed in filter") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.openFilterModal(filterOption = "Extension");

			ContentDashboard.checkMimeExtensionDisplayed(typeNameList = "Audio,Code,Presentation,Text");
		}

		task ("Add new duplicated extention") {
			SystemSettings.openSystemSettingsAdmin();

			SystemSettings.gotoConfiguration(
				configurationCategory = "Documents and Media",
				configurationName = "Service",
				configurationScope = "System Scope");

			ContentDashboard.addMimeType(typeName = "text/html");
		}

		task ("Check that types are still displayed correctly") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.openFilterModal(filterOption = "Extension");

			AssertVisible(
				key_nodeName = "Audio",
				locator1 = "Treeview#NODE_ITEM_2");

			AssertVisible(
				key_nodeName = "Code",
				locator1 = "Treeview#NODE_ITEM_2");

			AssertVisible(
				key_nodeName = "Presentation",
				locator1 = "Treeview#NODE_ITEM_2");

			AssertVisible(
				key_nodeName = "Text",
				locator1 = "Treeview#NODE_ITEM_2");
		}
	}

	@description = "LPS-134692 Given the info panel of an asset When the user clicks on arrow next to the title of a section collapsed Then the section will be displayed"
	@priority = 3
	test InfoPanelExpandSection {
		task ("Adding vocabulary and category") {
			JSONCategory.addVocabulary(
				groupName = "Test Site Name",
				title = "Vocabulary Name");

			var categoryId = JSONCategory.addCategory(
				groupName = "Test Site Name",
				title = "Category Name",
				vocabularyName = "Vocabulary Name");
		}

		task ("Adding Web Content") {
			JSONWebcontent.addWebContent(
				assetCategoryIds = ${categoryId},
				content = "WC WebContent Content",
				groupName = "Test Site Name",
				title = "WC WebContent Title");
		}

		task ("Go to the Content Dashboard") {
			ContentDashboard.goToContentDashboard();
		}

		task ("Open the info panel and expand the Public Categories section") {
			LexiconTable.clickEllipsisItem(
				item = "Info",
				tableEntry = "WC WebContent Title");

			Navigator.gotoNavTab(navTab = "Categorization");

			AssertVisible(
				categoryName = "Category Name",
				locator1 = "ContentDashboard#CATEGORY_LABEL_INFO_PANEL");

			Panel.collapsePanel(panel = "Public Categories");

			AssertNotVisible(
				categoryName = "Category Name",
				locator1 = "ContentDashboard#CATEGORY_LABEL_INFO_PANEL");

			Panel.expandPanel(panel = "Public Categories");

			AssertVisible(
				categoryName = "Category Name",
				locator1 = "ContentDashboard#CATEGORY_LABEL_INFO_PANEL");
		}
	}

	@description = "LPS-122873 When the user add filters need to have only one vocabulary, the relative ordering of the categories remain the same"
	@priority = 3
	test JustAddingAVocabularyThroughTheFilters {
		task ("Create a list of Audience Categories") {
			var audienceId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_1",
				vocabularyName = "Audience");
			var audienceId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_2",
				vocabularyName = "Audience");
			var audienceId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_3",
				vocabularyName = "Audience");
		}

		task ("Create a list of Stage Categories") {
			var stageId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_1",
				vocabularyName = "Stage");
			var stageId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_2",
				vocabularyName = "Stage");
			var stageId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_3",
				vocabularyName = "Stage");
		}

		task ("Create Web Contents with Stage categories only") {
			for (var count : list "1,2,3") {
				JSONWebcontent.addWebContent(
					assetCategoryIds = "${stageId1},${stageId2},${stageId3}",
					content = "Webcontent Content",
					groupName = "Test Site Name",
					title = "Webcontent Title ${count}");
			}
		}

		task ("Go to content Dashboard and View the relative ordering of the categories remain the same") {
			ContentDashboard.goToContentDashboard();

			AssertElementPresent(
				locator1 = "ContentDashboard#X_AXIS_VOCABULARY_NAME",
				xAxisCategoryName = "Substage_1");

			AssertElementPresent(
				locator1 = "ContentDashboard#X_AXIS_VOCABULARY_NAME",
				xAxisCategoryName = "Substage_2");

			AssertElementPresent(
				locator1 = "ContentDashboard#X_AXIS_VOCABULARY_NAME",
				xAxisCategoryName = "Substage_3");
		}
	}

	@description = "LPS-133354 Given The Extension filter modal When there are NOT file extensions for any MIME type Then the MIME type does NOT appear listed in the Extension modal"
	@priority = 3
	test NoMimeType {
		task ("Navigate to the content Dashboard and filter by file extension") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.openFilterModal(filterOption = "Extension");
		}

		task ("Check if message of No results were found is present") {
			if (IsElementNotPresent(locator1 = "Message#EMPTY_STATE_TEXT", value1 = "No results were found.")) {
				DMDocument.tearDownCP();

				ContentDashboard.goToContentDashboard();

				ContentDashboard.openFilterModal(filterOption = "Extension");
			}

			AssertTextEquals(
				locator1 = "Message#EMPTY_STATE_TEXT",
				value1 = "No results were found.");
		}
	}

	@description = "LPS-122873 When the user configure the audit graph to have just one vocabulary, the relative ordering of the categories remain the same"
	@priority = 3
	test NumberOfVocabulariesAccordingToTheAuditGraph {
		task ("Create a list of Audiences") {
			var categoryId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "C_Subaudience_1",
				vocabularyName = "Audience");
			var categoryId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "B_Subaudience_2",
				vocabularyName = "Audience");
			var categoryId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "A_Subaudience_3",
				vocabularyName = "Audience");
		}

		task ("Create a list of Stage Categories") {
			var stageId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_1",
				vocabularyName = "Stage");
			var stageId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_2",
				vocabularyName = "Stage");
			var stageId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_3",
				vocabularyName = "Stage");
		}

		task ("Create a Web Content with the categories") {
			JSONWebcontent.addWebContent(
				assetCategoryIds = "${categoryId1},${categoryId2},${categoryId3},${stageId1},${stageId2},${stageId3}",
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "Webcontent Title");
		}

		task ("Go to Content Dashboard and set graph to only one vocabulary") {
			SetWindowSize.maximizeWindow();

			ContentDashboard.goToContentDashboard();

			ContentDashboard.moveVocabularyDisplayConfiguration(vocabularyName = "Stage");
		}

		task ("Assert the categories of the vocabulary removed is not present") {
			AssertElementNotPresent(
				locator1 = "ContentDashboard#X_AXIS_VOCABULARY_NAME",
				xAxisCategoryName = "Substage_1");

			AssertElementNotPresent(
				locator1 = "ContentDashboard#X_AXIS_VOCABULARY_NAME",
				xAxisCategoryName = "Substage_2");

			AssertElementNotPresent(
				locator1 = "ContentDashboard#X_AXIS_VOCABULARY_NAME",
				xAxisCategoryName = "Substage_3");
		}

		task ("Validate if the remaining categories are shown in order of creating") {
			AssertTextEquals.assertPartialText(
				categoryIndex = 1,
				locator1 = "ContentDashboard#X_AXIS_CATEGORIES_NAME",
				value1 = "C_Subaudien");

			AssertTextEquals.assertPartialText(
				categoryIndex = 2,
				locator1 = "ContentDashboard#X_AXIS_CATEGORIES_NAME",
				value1 = "B_Subaudien");

			AssertTextEquals.assertPartialText(
				categoryIndex = 3,
				locator1 = "ContentDashboard#X_AXIS_CATEGORIES_NAME",
				value1 = "A_Subaudien");
		}
	}

	@description = "LPS-122873 When the user uncheck any checkbox from the vocab2, the relative ordering of the categories remain the same"
	@priority = 3
	test UncheckACategoryInTheContentPanel {
		task ("Create a list of Audience Categories") {
			var audienceId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_1",
				vocabularyName = "Audience");
			var audienceId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_2",
				vocabularyName = "Audience");
			var audienceId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Subaudience_3",
				vocabularyName = "Audience");
		}

		task ("Create a list of Stage Categories") {
			var stageId1 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_1",
				vocabularyName = "Stage");
			var stageId2 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_2",
				vocabularyName = "Stage");
			var stageId3 = JSONCategory.addCategory(
				groupName = "Global",
				title = "Substage_3",
				vocabularyName = "Stage");
		}

		task ("Create a Web Content with the categories") {
			JSONWebcontent.addWebContent(
				assetCategoryIds = "${audienceId1},${audienceId2},${audienceId3},${stageId1},${stageId2},${stageId3}",
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "Webcontent Title");
		}

		task ("Navigate to content Dashboard, uncheck a vocabulary category 2 and see the order of categories") {
			ContentDashboard.goToContentDashboard();

			Click.javaScriptClick(
				checkboxName = "Substage_2",
				locator1 = "Checkbox#ANY_CHECKBOX");

			task ("blue - first position") {
				AssertVisible(
					fillColor = "4B9FFF",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("orange - second position") {
				AssertElementNotPresent(
					fillColor = "FFB46E",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}

			task ("red - third position") {
				AssertVisible(
					fillColor = "FF5F5F",
					locator1 = "ContentDashboard#BAR_FROM_NO_VOCABULARY_SPECIFIED");
			}
		}
	}

	@description = "LPS-151911 Bug: Content Dashboard shows error when displaying details of article whose authors has been deleted"
	@priority = 4
	test ViewInfoPanelDeletedUser {
		property portal.acceptance = "true";

		task ("Create a new User") {
			JSONUser.addUser(
				userEmailAddress = "userea@liferay.com",
				userFirstName = "userfn",
				userLastName = "userln",
				userScreenName = "usersn");

			JSONUser.setFirstPassword(
				agreeToTermsAndAnswerReminderQuery = "true",
				newPassword = PropsUtil.get("default.admin.password"),
				requireReset = "false",
				userEmailAddress = "userea@liferay.com");
		}

		task ("Assign the new user to a site") {
			JSONUser.addUserToSite(
				groupName = "Test Site Name",
				userEmailAddress = "userea@liferay.com");
		}

		task ("Assign the Site Administrator to new user") {
			JSONRole.assignSiteRoleToUser(
				groupName = "Test Site Name",
				roleTitle = "Site Administrator",
				userEmailAddress = "userea@liferay.com");
		}

		task ("Create a web content with created user via JSONWS") {
			User.logoutAndLoginPG(
				userLoginEmailAddress = "userea@liferay.com",
				userLoginFullName = "userfn userln");

			WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

			WebContentNavigator.gotoAddCP();

			WebContent.addCP(
				webContentContent = "WC Content Content",
				webContentTitle = "Web Content Title");

			WebContent.publishWithPermissions();
		}

		task ("Login with Test user once more") {
			User.logoutAndLoginPG(
				userLoginEmailAddress = "test@liferay.com",
				userLoginFullName = "Test Test");
		}

		task ("Delete the user created") {
			JSONUser.deleteUserByEmailAddress(userEmailAddress = "userea@liferay.com");
		}

		task ("Navigate to Content Dashboard") {
			ContentDashboard.goToContentDashboard();
		}

		task ("Check the info panel of the asset") {
			LexiconTable.clickEllipsisItem(
				item = "Info",
				tableEntry = "Web Content Title");

			AssertTextEquals(
				locator1 = "ContentDashboard#INFO_PANEL_TITLE",
				value1 = "Web Content Title");
		}
	}
}