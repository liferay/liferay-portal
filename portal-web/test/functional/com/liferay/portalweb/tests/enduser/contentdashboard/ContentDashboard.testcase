	@description = "LPS-132597 A web content's display page icon in the Content Dashboard table reflects both its association with a Display Page and its status"
	@priority = 5
	test DisplayPageIconVisibility {
		property portal.acceptance = "true";

		task ("Create an approved Web Content without a Display Page") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Not Associated");
		}

		task ("Assert the display page icon is not present for a not associated Web Content") {
			ContentDashboard.goToContentDashboard();

			LexiconTable.viewTableEntryTitle(tableEntry = "WC Not Associated");

			AssertElementNotPresent(
				key_tableEntry = "WC Not Associated",
				key_text = "page",
				locator1 = "LexiconTable#TABLE_ENTRY_ICON");
		}

		task ("Create a default Display Page Template") {
			JSONLayoutpagetemplate.addDisplayPageTemplateEntry(
				contentType = "Web Content Article",
				displayPageTemplateEntryName = "Display Page Name",
				groupName = "Test Site Name",
				statusKey = "APPROVED",
				subType = "Basic Web Content");

			JSONLayoutpagetemplate.setLayoutPageTemplateEntryAsDefault(
				groupName = "Test Site Name",
				layoutPageTemplateEntryName = "Display Page Name",
				type = "Display Page Template");
		}

		task ("Create an approved Web Content associated with the default Display Page") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Approved");
		}

		task ("Assert the display page icon is present for an approved associated Web Content") {
			ContentDashboard.goToContentDashboard();

			AssertVisible(
				key_tableEntry = "WC Approved",
				key_text = "page",
				locator1 = "LexiconTable#TABLE_ENTRY_ICON");
		}

		task ("Configure Web Content Article workflow to Single Approver") {
			Workflow.openWorkflowAdmin(siteURLKey = "test-site-name");

			Workflow.configureWorkflow(
				workflowDefinition = "Single Approver",
				workflowResourceValue = "Web Content Article");
		}

		task ("Create a pending Web Content associated with the default Display Page") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Pending");
		}

		task ("Assert the display page icon is not present for a pending associated Web Content") {
			ContentDashboard.goToContentDashboard();

			LexiconTable.viewTableEntryTitle(tableEntry = "WC Pending");

			AssertElementNotPresent(
				key_tableEntry = "WC Pending",
				key_text = "page",
				locator1 = "LexiconTable#TABLE_ENTRY_ICON");
		}
	}

	@description = "LPS-119966 Given a document with and associated Display Page Template When the user with permissions clicks on the view button Then the user is lead to the view mode"
	@priority = 4
	test DocumentIconView {
		property osgi.module.configuration.file.names = "com.liferay.content.dashboard.web.internal.configuration.FFContentDashboardDocumentConfiguration.config";
		property osgi.module.configurations = "enabled=B\"true\"";
		property portal.acceptance = "true";

		task ("Create a default Display Page Template") {
			JSONLayoutpagetemplate.addDisplayPageTemplateEntry(
				contentType = "Document",
				displayPageTemplateEntryName = "Display Page Name",
				groupName = "Test Site Name",
				statusKey = "APPROVED",
				subType = "Basic Document");

			JSONLayoutpagetemplate.setLayoutPageTemplateEntryAsDefault(
				groupName = "Test Site Name",
				layoutPageTemplateEntryName = "Display Page Name",
				type = "Display Page Template");
		}

		task ("Add a document") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "DM Document Title",
				groupName = "Test Site Name",
				mimeType = "text/txt",
				sourceFileName = "Document_1.txt");
		}

		task ("Add a Heading fragment to display page template") {
			DisplayPageTemplatesAdmin.openDisplayPagesAdmin(siteURLKey = "test-site-name");

			DisplayPageTemplatesAdmin.gotoDisplayPage(displayPageName = "Display Page Name");

			PageEditor.addFragment(
				collectionName = "Basic Components",
				fragmentName = "Heading");
		}

		task ("Map custom field to editable field of Heading") {
			PageEditorMapping.mapEditableTextToField(
				field = "Title",
				fragmentName = "Heading",
				id = "element-text");

			PageEditor.publish();
		}

		task ("Go to Content Dashboard") {
			ContentDashboard.goToContentDashboard();
		}

		task ("Click on the View icon and check the user is lead to the Display Page") {
			ContentDashboard.clickQuickActionIcon(iconName = "View");
		}

		task ("Assert the View Mode") {
			ContentPages.viewFragmentText(
				fragmentName = "heading",
				id = "element-text",
				text = "DM Document Title");
		}
	}

	@description = "LPS-164334 Add a Version History Page to Documents and Media"
	@priority = 4
	test DocumentsVersionHistoryDeleteVersion {
		property portal.acceptance = "true";

		task ("Given the Version History page for documents") {
			task ("Create a Document") {
				JSONDocument.addFileWithUploadedFile(
					dmDocumentDescription = "DM Document Description",
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					mimeType = "text/plain",
					sourceFileName = "Document_1.txt");
			}

			task ("Add versions for the document") {
				ContentDashboard.createVersionsForDocument(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					versionsCreated = 2);
			}

			task ("Navigate to Version History Page") {
				ContentDashboard.navigateToDocumentVersionHistoryPage(
					dmDocumentTitle = "DM Document Title",
					groupName = "Test Site Name",
					siteURLKey = "test-site-name");
			}
		}

		task ("When the user clicks on Delete option the kebab menu") {
			PortletEntry.deleteViaMenuItem(rowEntry = "1.2");

			Alert.viewSuccessMessage();
		}

		task ("Then the document's version is deleted") {
			AssertElementNotPresent(
				key_tableEntry = "1.2",
				locator1 = "LexiconTable#TABLE_ENTRY");

			AssertVisible(
				key_tableEntry = "1.1",
				locator1 = "LexiconTable#TABLE_ENTRY");
		}
	}

	@description = "LPS-164334 Add a Version History Page to Documents and Media"
	@priority = 3
	@uitest
	test DocumentsVersionHistoryInformation {
		var groupId = JSONGroupSetter.setGroupId(groupName = "Test Site Name");

		task ("Given the Version History page for documents") {
			task ("Create a Document") {
				JSONDocument.addFileWithUploadedFile(
					dmDocumentDescription = "DM Document Description",
					dmDocumentTitle = "DM Document Title",
					mimeType = "text/plain",
					repositoryId = ${groupId},
					sourceFileName = "Document_1.txt");
			}

			task ("Add versions for the document") {
				ContentDashboard.createVersionsForDocument(
					dmDocumentTitle = "DM Document Title",
					groupId = ${groupId},
					versionsCreated = 10);
			}

			task ("Navigate to Content Dashboard") {
				ContentDashboard.goToContentDashboard();
			}

			task ("Open info panel sidebar") {
				LexiconTable.clickEllipsisItem(
					item = "Info",
					tableEntry = "DM Document Title");
			}

			task ("Open versions tab") {
				ContentDashboard.openVersionsTab(assetName = "DM Document Title");
			}
		}

		task ("When the user access to the page") {
			ContentDashboard.clickViewMore();
		}

		task ("Then the table includes the ID of the Document, Title, Version Number, Status, Modified Date, and Author") {
			AssertVisible(
				key_tableHeader = "ID",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Title",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Version",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Status",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Modified Date",
				locator1 = "LexiconTable#TABLE_HEADER");

			AssertVisible(
				key_tableHeader = "Author",
				locator1 = "LexiconTable#TABLE_HEADER");
		}
	}

