	@description = "LPS-146471 Given The Filter and Order dropdown When the user selects the option Filter by Author (All, Me, Author) Then the list of contents displays the matching content, including Blogs"
	@priority = 5
	test FilterBlogByAuthor {
		property portal.acceptance = "true";

		task ("Create a blog") {
			JSONBlog.addEntry(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title",
				groupName = "Test Site Name");
		}

		task ("Filter by Author: All and assert the blog is displayed") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.filterByAuthorAll(filterOption = "All");

			AssertTextEquals(
				locator1 = "ContentDashboard#FIRST_ELEMENT_LISTED",
				value1 = "Blogs Entry Title");
		}

		task ("Filter by Author: Me and assert the blog is displayed") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.filterByAuthorMe(filterOption = "Me");

			AssertTextEquals(
				locator1 = "ContentDashboard#FIRST_ELEMENT_LISTED",
				value1 = "Blogs Entry Title");
		}

		task ("Filter by Author: Author and assert the blog is displayed") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.filterByAuthor();

			AssertTextEquals(
				locator1 = "ContentDashboard#FIRST_ELEMENT_LISTED",
				value1 = "Blogs Entry Title");
		}
	}

	@description = "LPS-146471 Given The Filter by... > Category, Sites and Asset Libraries or Tags When the user selects a filter Then the content list in the Content Dashboard filters accordingly, including Blogs"
	@priority = 5
	test FilterBlogByMetadata {
		property portal.acceptance = "true";

		task ("Add a public vocabulary for Test Site Name") {
			JSONCategory.addVocabulary(
				groupName = "Test Site Name",
				title = "Vocabulary Name");
		}

		task ("Create a category for Vocabulary Name") {
