	@description = "LPS-117489 Validate if the user can filter by Author, using different display types, and that Author: All displays content from all users"
	@priority = 5
	test FilterByAuthor {
		property portal.acceptance = "true";

		task ("Create a Web Content") {
			JSONWebcontent.addWebContent(
				content = "WC Content",
				groupName = "Test Site Name",
				title = "WC Title");
		}

		ContentDashboard.goToContentDashboard();

		task ("Filter author using table") {
			ContentDashboard.filterByAuthor();

			AssertTextEquals(
				locator1 = "ContentDashboard#FIRST_ELEMENT_LISTED",
				value1 = "WC Title");
		}

		task ("Filter author using list") {
			ContentDashboard.clearFilters();

			ContentDashboard.filterByAuthor(viewOption = "List");

			AssertTextEquals(
				locator1 = "ContentDashboard#FIRST_ELEMENT_LISTED",
				value1 = "WC Title");
		}

		task ("Filter author using cards") {
			ContentDashboard.clearFilters();

			ContentDashboard.filterByAuthor(viewOption = "Cards");

			AssertTextEquals(
				locator1 = "ContentDashboard#FIRST_ELEMENT_LISTED",
				value1 = "WC Title");
		}

		task ("Create and configure a second user") {
			JSONUser.addUser(
				userEmailAddress = "userea@liferay.com",
				userFirstName = "userfn",
				userLastName = "userln",
				userScreenName = "usersn");

			JSONUser.setFirstPassword(
				agreeToTermsAndAnswerReminderQuery = "true",
				requireReset = "false",
				userEmailAddress = "userea@liferay.com");

			JSONUser.addUserToSite(
				groupName = "Test Site Name",
				userEmailAddress = "userea@liferay.com");

			JSONRole.assignSiteRoleToUser(
				groupName = "Test Site Name",
				roleTitle = "Site Owner",
				userEmailAddress = "userea@liferay.com");
		}

		task ("Change to the second user and create a second Web Content") {
			User.logoutAndLoginPG(
				userLoginEmailAddress = "userea@liferay.com",
				userLoginFullName = "userfn userln");

			WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

			WebContentNavigator.gotoAddCP();

			WebContent.addCP(
				webContentContent = "WC Content 2",
				webContentTitle = "WC Title 2");

			WebContent.publishWithPermissions();
		}

		task ("Login with the Admin user") {
			User.logoutAndLoginPG(
				userLoginEmailAddress = "test@liferay.com",
				userLoginFullName = "Test Test");
		}

		task ("Filter by Author: All and assert content from all users is displayed") {
			ContentDashboard.goToContentDashboard();

			ContentDashboard.filterByAuthorAll(filterOption = "All");

			AssertTextEquals(
				key_tableEntry = "WC Title",
				locator1 = "LexiconTable#TABLE_ENTRY_TITLE_LINK",
				value1 = "WC Title");

			AssertTextEquals(
				key_tableEntry = "WC Title 2",
				locator1 = "LexiconTable#TABLE_ENTRY_TITLE_LINK",
				value1 = "WC Title 2");
		}
	}

