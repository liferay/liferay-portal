	@description = "LPS-162826 Add the Compare to Action to the Version History for Web Content"
	@priority = 3
	test CompareToLastVersionWebContent {
		task ("Given the compare screen for Web Content") {
			task ("Create a Web Content") {
				JSONWebcontent.addWebContent(
					content = "Web Content Content",
					groupName = "Test Site Name",
					title = "Web Content Title");
			}

			task ("Create a version for that web content") {
				WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

				WebContentNavigator.gotoEditCP(webContentTitle = "Web Content Title");

				WebContent.editCP(
					webContentContentEdit = "Web Content Content Edit",
					webContentTitleEdit = "Web Content Title Edit");
			}

			task ("Navigate to Content Dashboard") {
				ContentDashboard.goToContentDashboard();
			}

			task ("Open info panel sidebar") {
				LexiconTable.clickEllipsisItem(
					item = "Info",
					tableEntry = "Web Content Title Edit");
			}
		}

		task ("When the access to the compare screen from the Compare to action And the most recent version of a Web Content is the one selected") {
			ContentDashboard.openVersionsTab();

			ContentDashboard.clickMenuOfVersion(
				menuItem = "Compare to...",
				versionName = "Version 1.1");
		}

		task ("Then this version should be compared to itself") {
			AssertTextEquals(
				locator1 = "WCViewHistory#COMPARED_VERSION_NEWER",
				value1 = "Version 1.1");

			AssertTextEquals(
				locator1 = "WCViewHistory#COMPARED_VERSION_OLDER",
				value1 = "Version 1.1");
		}
	}

	@description = "LPS-162826 Add the Compare to Action to the Version History for Web Content"
	@priority = 3
	test CompareToVersionWebContent {
		task ("Given the Versions tab in the Info panel of a Web Content") {
			task ("Create a Web Content") {
				JSONWebcontent.addWebContent(
					content = "Web Content Content",
					groupName = "Test Site Name",
					title = "Web Content Title");
			}

			task ("Create a version for that web content") {
				WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

				WebContentNavigator.gotoEditCP(webContentTitle = "Web Content Title");

				WebContent.editCP(
					webContentContentEdit = "Web Content Content Edit",
					webContentTitleEdit = "Web Content Title Edit");
			}

			task ("Navigate to Content Dashboard") {
				ContentDashboard.goToContentDashboard();
			}

			task ("Open info panel sidebar") {
				LexiconTable.clickEllipsisItem(
					item = "Info",
					tableEntry = "Web Content Title Edit");
			}
		}

		task ("When the user opens the kebab menu of a version And the user clicks on the Compare to action") {
			ContentDashboard.openVersionsTab();

			ContentDashboard.clickMenuOfVersion(
				menuItem = "Compare to...",
				versionName = "Version 1.0");
		}

		task ("Then the user is redirected to the compare screen for Web Content") {
			AssertTextEquals(
				locator1 = "WCViewHistory#VIEW_COMPARE_VERSIONS_CONTENT",
				value1 = "Web Content Content Edit");
		}
	}

	@description = "LPS-138908 Type filter in Content Dashboard does work when deselecting previously selected types"
	@priority = 4
	test DeselectTypeFilter {
		task ("Given a user has a Content Dashboard filtered by a type") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Content");

			ContentDashboard.goToContentDashboard();

			ContentDashboard.filterByType(typeName = "Web Content Article");

			LexiconTable.viewTableEntryTitle(tableEntry = "WC Content");

			LexiconTable.viewTableEntryNotPresent(tableEntry = "tree.png");
		}

		task ("When the user deselects the type filter") {
			ContentDashboard.openFilterModal(filterOption = "Type");

			Uncheck.uncheckNotVisible(
				key_nodeName = "Web Content Article",
				locator1 = "Treeview#NODE_CHECKBOX_2");

			ContentDashboard.applySelectedFilter();
		}

		task ("Then the user sees all assets") {
			LexiconTable.viewTableEntryTitle(tableEntry = "WC Content");

			LexiconTable.viewTableEntryTitle(tableEntry = "tree.png");
		}
	}

	@description = "LPS-132597 A web content's display page icon in the Content Dashboard table reflects both its association with a Display Page and its status"
	@priority = 5
	test DisplayPageIconVisibility {
		property portal.acceptance = "true";

		task ("Create an approved Web Content without a Display Page") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Not Associated");
		}

		task ("Assert the display page icon is not present for a not associated Web Content") {
			ContentDashboard.goToContentDashboard();

			LexiconTable.viewTableEntryTitle(tableEntry = "WC Not Associated");

			AssertElementNotPresent(
				key_tableEntry = "WC Not Associated",
				key_text = "page",
				locator1 = "LexiconTable#TABLE_ENTRY_ICON");
		}

		task ("Create a default Display Page Template") {
			JSONLayoutpagetemplate.addDisplayPageTemplateEntry(
				contentType = "Web Content Article",
				displayPageTemplateEntryName = "Display Page Name",
				groupName = "Test Site Name",
				statusKey = "APPROVED",
				subType = "Basic Web Content");

			JSONLayoutpagetemplate.setLayoutPageTemplateEntryAsDefault(
				groupName = "Test Site Name",
				layoutPageTemplateEntryName = "Display Page Name",
				type = "Display Page Template");
		}

		task ("Create an approved Web Content associated with the default Display Page") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Approved");
		}

		task ("Assert the display page icon is present for an approved associated Web Content") {
			ContentDashboard.goToContentDashboard();

			AssertVisible(
				key_tableEntry = "WC Approved",
				key_text = "page",
				locator1 = "LexiconTable#TABLE_ENTRY_ICON");
		}

		task ("Configure Web Content Article workflow to Single Approver") {
			Workflow.openWorkflowAdmin(siteURLKey = "test-site-name");

			Workflow.configureWorkflow(
				workflowDefinition = "Single Approver",
				workflowResourceValue = "Web Content Article");
		}

		task ("Create a pending Web Content associated with the default Display Page") {
			JSONWebcontent.addWebContent(
				content = "Webcontent Content",
				groupName = "Test Site Name",
				title = "WC Pending");
		}

		task ("Assert the display page icon is not present for a pending associated Web Content") {
			ContentDashboard.goToContentDashboard();

			LexiconTable.viewTableEntryTitle(tableEntry = "WC Pending");

			AssertElementNotPresent(
				key_tableEntry = "WC Pending",
				key_text = "page",
				locator1 = "LexiconTable#TABLE_ENTRY_ICON");
		}
	}

	@description = "LPS-119966 Given a document created in an Asset Library When the user goes to the content dashboard Then the user can see the document listed"
