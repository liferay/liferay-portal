@component-name = "portal-core-infra"
definition {

	property liferay.faces = "true";
	property liferay.faces.war.file.names = "com.liferay.faces.demo.alloy.showcase.portlet";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Liferay Faces";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		task ("Enable widget pages") {
			PagesAdmin.enableWidgetPages();
		}

		HeadlessSite.addSite(siteName = "Alloy Showcase");

		PagesAdmin.openPagesAdmin(siteURLKey = "Alloy Showcase");

		JSONLayout.addPublicLayout(
			groupName = "Alloy Showcase",
			layoutName = "Alloy Showcase");

		JSONLayout.updateLayoutTemplateOfPublicLayout(
			groupName = "Alloy Showcase",
			layoutName = "Alloy Showcase",
			layoutTemplate = "1 Column");

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase");

		Portlet.addPG(portletName = "Alloy Showcase");

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase");
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			User.logoutPG();
		}
	}

	@priority = 5
	test ButtonSmoke {

		// ButtonGeneral

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/button/general");

		AlloyShowcase.clickButton(buttonNum = "1,2,3");

		// ButtonMenu

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/button/menu");

		AlloyShowcase.testMenu();

		// CommandButtonMenu

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/commandbutton/menu");

		AlloyShowcase.testMenu(command = "true");

		// CommandButtonGeneral

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/commandbutton/general");

		AlloyShowcase.clickButton(buttonNum = "1,2,3");

		// ButtonRowGeneral

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/buttonrow/general");

		AlloyShowcase.clickButton(buttonRow = "true");
	}

	@priority = 5
	test DataListSmoke {
		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datalist/general");

		AlloyShowcase.viewDataList();

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datalist/data-model");

		AlloyShowcase.viewDataTable();

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datalist/selection");

		AlloyShowcase.viewDataSelection();
	}

	@priority = 5
	test DataTableSmoke {
		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datatable/lazy");

		AlloyShowcase.viewPaginator(
			screenName1 = "John",
			screenName2 = "Philip",
			screenName3 = "George",
			screenName4 = "William");

		AlloyShowcase.selectRowsPerPage();

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datatable/selection");

		AlloyShowcase.viewPaginator(
			screenName1 = "John",
			screenName2 = "Philip",
			screenName3 = "George",
			screenName4 = "William",
			useCase = "selection");

		AlloyShowcase.selectDataTable();

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datatable/server-events");

		AlloyShowcase.viewServerEvents(
			screenName1 = "John",
			screenName2 = "Philip",
			screenName3 = "George",
			screenName4 = "William",
			useCase = "serverEvents");

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datatable/sort-multiple-columns");

		AlloyShowcase.viewMultipleColumnSort(
			screenName1 = "John",
			screenName2 = "Philip",
			screenName3 = "George",
			screenName4 = "William");

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/datatable/sort-single-column");

		AlloyShowcase.viewSingleColumnSort(
			screenName1 = "John",
			screenName2 = "Philip",
			screenName3 = "George",
			screenName4 = "William");
	}

	@priority = 5
	test InputFileSmoke {
		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/inputfile/multiple");

		JSFShowcase.uploadAndDeleteFile(fileName = "Document_2.jpeg");
	}

	@priority = 5
	test LinkSmoke {

		// LinkGeneral

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/link/general");

		JSFShowcase.clickButton(link = "true");

		// CommandLinkGeneral

		Navigator.openWithAppendToBaseURL(urlAppend = "web/alloy-showcase/alloy-showcase/-/alloy-tag/alloy/commandlink/general");

		JSFShowcase.clickButton(link = "true");
	}

}