load("ext://restart_process", "docker_build_with_restart")
load("ext://uibutton", "cmd_button", "text_input")

context = k8s_context()

if not context.startswith("k3d-"):
	fail(
	    (
	        "This Tiltfile targets a local k3d cluster, but the current " +
	        "kube context is '{}'. Switch with: " +
	        "kubectl config use-context k3d-<name>"
	    ).format(context)
	)

allow_k8s_contexts(context)

environments = [
    ("non-production", "Non-Production"),
    ("production", "Production"),
    ("uat", "UAT"),
]

def environment_yaml(name, display_name):
	namespace = "liferay-" + name

	return "\n".join(
	    [
	        "apiVersion: v1",
	        "kind: Namespace",
	        "metadata:",
	        "  name: " + namespace,
	        "---",
	        "apiVersion: licensing.liferay.com/v1alpha1",
	        "kind: LiferayEnvironment",
	        "metadata:",
	        "    name: " + name,
	        "    namespace: " + namespace,
	        "spec:",
	        "    activationCodeSecretRef:",
	        "        name: " + name + "-activation",
	        "        key: activationCode",
	        "    dxpVersion: 2026.q3.0",
	        "    environmentName: \"" + display_name + "\"",
	        "    workloadRef:",
	        "        name: liferay-default",
	    ]
	)


docker_build_with_restart(
    "liferay/liferay-dxp-operator",
    context="resources/build",
    dockerfile="Dockerfile",
    entrypoint="/home/nonroot/manager",
    live_update=[
        sync("resources/build/manager", "/home/nonroot/manager"),
    ],
    target="dev",
)

for name, display_name in environments:
	namespace = "liferay-" + name

	k8s_yaml(blob(environment_yaml(name, display_name)))

	k8s_resource(
	    labels=["environments"],
	    new_name=namespace,
	    objects=[
	        name + ":liferayenvironment",
	        namespace + ":namespace",
	    ],
	    resource_deps=[
	        "liferay-dxp-operator",
	        "operator-infra",
	    ],
	)

	cmd_button(
	    namespace + ":activate",
	    argv=[
	        "sh",
	        "-c",
	        "kubectl create secret generic " + name + "-activation" +
	        " --dry-run=client" +
	        " --from-literal=activationCode=\"$ACTIVATION_CODE\"" +
	        " --namespace " + namespace + " -o yaml | kubectl apply -f - && " +
	        "kubectl annotate --namespace " + namespace +
	        " --overwrite liferayenvironment " + name +
	        " tilt.dev/activate-requested=\"$(date +%s)\"",
	    ],
	    icon_name="key",
	    inputs=[
	        text_input("ACTIVATION_CODE", label="Activation code"),
	    ],
	    resource=namespace,
	    text="Activate with a new code",
	)

local_resource(
    "operator-build",
    cmd="./go_build.sh fast",
    deps=["resources"],
    ignore=[
        "resources/api/licensing/v1alpha1/zz_generated.deepcopy.go",
        "resources/build",
    ],
    labels=["operator"],
)

k8s_resource(
    labels=["operator"],
    port_forwards=["8080:8080", "8081:8081"],
    resource_deps=["operator-build"],
    workload="liferay-dxp-operator",
)

k8s_resource(
    labels=["operator"],
    new_name="operator-infra",
    objects=[
        "liferayenvironments.licensing.liferay.com:customresourcedefinition",
        "liferay-dxp-operator:serviceaccount",
        "liferay-dxp-operator:clusterrole",
        "liferay-dxp-operator:clusterrolebinding",
        "liferay-system:namespace",
    ],
)

k8s_yaml(
    blob(
        "\n".join(
            [
                "apiVersion: v1",
                "kind: Namespace",
                "metadata:",
                "    name: liferay-system",
            ]
        )
    )
)

k8s_yaml(
    helm(
        "../helm/dxp-operator",
        name="liferay-dxp-operator",
        namespace="liferay-system",
        set=[
            "debug=true",
            "heartbeatInterval=30s",
            "image.repository=liferay/liferay-dxp-operator",
            "provisioning.baseURL=https://webserver-lrprovisioning-uat.lfr.cloud",
            "securityContext.readOnlyRootFilesystem=false",
        ],
    )
)