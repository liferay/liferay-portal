					"title": "Database Status",
					"transparent": true,
					"vizConfig": {
						"group": "state-timeline",
						"kind": "VizConfig",
						"spec": {
							"fieldConfig": {
								"defaults": {
									"color": {
										"fixedColor": "#334155",
										"mode": "fixed"
									},
									"custom": {
										"axisPlacement": "auto",
										"fillOpacity": 70,
										"hideFrom": {
											"legend": false,
											"tooltip": false,
											"viz": false
										},
										"insertNulls": false,
										"lineWidth": 0,
										"spanNulls": false
									},
									"thresholds": {
										"mode": "absolute",
										"steps": [
											{
												"color": "green",
												"value": 0
											},
											{
												"color": "red",
												"value": 80
											}
										]
									}
								},
								"overrides": [
									{
										"matcher": {
											"id": "byRegexp",
											"options": "/.*RUNNING/i"
										},
										"properties": [
											{
												"id": "color",
												"value": {
													"fixedColor": "blue",
													"mode": "fixed"
												}
											}
										]
									},
									{
										"matcher": {
											"id": "byRegexp",
											"options": "/.*FAILED/i"
										},
										"properties": [
											{
												"id": "color",
												"value": {
													"fixedColor": "red",
													"mode": "fixed"
												}
											}
										]
									},
									{
										"matcher": {
											"id": "byRegexp",
											"options": "/.*MAINTENANCE/i"
										},
										"properties": [
											{
												"id": "color",
												"value": {
													"fixedColor": "purple",
													"mode": "fixed"
												}
											}
										]
									},
									{
										"matcher": {
											"id": "byRegexp",
											"options": "/.*PENDING_CREATE/i"
										},
										"properties": [
											{
												"id": "color",
												"value": {
													"fixedColor": "#f57b00",
													"mode": "fixed"
												}
											}
										]
									},
									{
										"matcher": {
											"id": "byRegexp",
											"options": "/.*RUNNABLE/i"
										},
										"properties": [
											{
												"id": "color",
												"value": {
													"fixedColor": "yellow",
													"mode": "fixed"
												}
											}
										]
									},
									{
										"matcher": {
											"id": "byRegexp",
											"options": "/.*SUSPENDED/i"
										},
										"properties": [
											{
												"id": "color",
												"value": {
													"fixedColor": "#64748b",
													"mode": "fixed"
												}
											}
										]
									},
									{
										"matcher": {
											"id": "byName",
											"options": "Value"
										},
										"properties": [
											{
												"id": "mappings",
												"value": [
													{
														"options": {
															"1": {
																"index": 0,
																"text": "⠀"
															}
														},
														"type": "value"
													}
												]
											}
										]
									}
								]
							},
							"options": {
