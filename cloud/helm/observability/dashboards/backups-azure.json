{
	"annotations": {
		"list": [
			{
				"builtIn": 1,
				"datasource": {
					"type": "grafana",
					"uid": "-- Grafana --"
				},
				"enable": true,
				"hide": true,
				"iconColor": "rgba(0, 211, 255, 1)",
				"name": "Annotations & Alerts",
				"type": "dashboard"
			}
		]
	},
	"editable": true,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 0,
	"links": [
	],
	"panels": [
		{
			"fieldConfig": {
				"defaults": {
				},
				"overrides": [
				]
			},
			"gridPos": {
				"h": 5,
				"w": 24,
				"x": 0,
				"y": 0
			},
			"id": 1,
			"options": {
				"code": {
					"language": "plaintext",
					"showLineNumbers": false,
					"showMiniMap": false
				},
				"content": "${HEADER_HTML}",
				"mode": "html"
			},
			"pluginVersion": "12.4.2",
			"title": "",
			"transparent": true,
			"type": "text"
		},
		{
			"datasource": {
				"type": "grafana-azure-monitor-datasource",
				"uid": "${DS_AZURE_MONITOR}"
			},
			"description": "Azure Resource Graph only keeps the last 14 days of backup jobs, so older backups are not listed even if their recovery points have not expired.",
			"fieldConfig": {
				"defaults": {
					"color": {
						"mode": "thresholds"
					},
					"custom": {
						"align": "auto",
						"cellOptions": {
							"type": "auto"
						},
						"filterable": true,
						"footer": {
							"reducers": [
							]
						},
						"inspect": false
					},
					"mappings": [
					],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "red",
								"value": 0
							},
							{
								"color": "green",
								"value": 1
							}
						]
					}
				},
				"overrides": [
					{
						"matcher": {
							"id": "byRegexp",
							"options": ".*"
						},
						"properties": [
							{
								"id": "links",
								"value": [
								]
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Recovery Point ID"
						},
						"properties": [
							{
								"id": "custom.inspect",
								"value": true
							},
							{
								"id": "custom.minWidth",
								"value": 280
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Status"
						},
						"properties": [
							{
								"id": "mappings",
								"value": [
									{
										"options": {
											"FAILED": {
												"index": 2,
												"text": "🔴 FAILED"
											},
											"IN PROGRESS": {
												"index": 1,
												"text": "🟡 IN PROGRESS"
											},
											"SUCCEEDED": {
												"index": 0,
												"text": "🟢 SUCCEEDED"
											}
										},
										"type": "value"
									}
								]
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Storage Account"
						},
						"properties": [
							{
								"id": "links",
								"value": [
									{
										"targetBlank": true,
										"title": "Open the storage account in the Azure Portal",
										"url": "https://portal.azure.com/#resource/subscriptions/${AZURE_SUBSCRIPTION_ID}/resourceGroups/${AZURE_RESOURCE_GROUP}/providers/Microsoft.Storage/storageAccounts/${__value.raw}/overview"
									}
								]
							}
						]
					},
					{
						"matcher": {
							"id": "byType",
							"options": "time"
						},
						"properties": [
							{
								"id": "custom.filterable"
							}
						]
					}
				]
			},
			"gridPos": {
				"h": 16,
				"w": 24,
				"x": 0,
				"y": 5
			},
			"id": 2,
			"options": {
				"cellHeight": "sm",
				"showHeader": true,
				"sortBy": [
					{
						"desc": true,
						"displayName": "Backup Triggered"
					}
				]
			},
			"pluginVersion": "12.4.2",
			"targets": [
				{
					"azureResourceGraph": {
						"query": "recoveryservicesresources\n| where type == 'microsoft.dataprotection/backupvaults/backupjobs'\n| where resourceGroup =~ '${AZURE_RESOURCE_GROUP}'\n| where properties.operation == 'Backup'\n| extend dataSourceId = tolower(tostring(properties.dataSourceId))\n| join kind=inner (\n\tresources\n\t| where type == 'microsoft.storage/storageaccounts'\n\t| where resourceGroup =~ '${AZURE_RESOURCE_GROUP}'\n\t| project dataSourceId = tolower(id), namespace = strcat('liferay-', tostring(tags['project-id']), '-', tostring(tags['environment-id']))\n) on dataSourceId\n| where namespace == '$environment'\n| extend completed = todatetime(properties.endTime), status = tostring(properties.status), triggered = todatetime(properties.startTime)\n| extend finished = status != 'InProgress' and isnotnull(completed)\n| extend minutes = iff(finished, max_of(toint(round((completed - triggered) / 1m)), 1), int(null))\n| order by triggered desc\n| project ['Recovery Point ID'] = iff(status in ('Completed', 'CompletedWithWarnings'), tostring(properties.extendedInfo.targetRecoverPoint.recoveryPointID), ''), ['Data Plane'] = extract(@'-(blue|green)$', 1, tostring(properties.backupInstanceFriendlyName)), ['Storage Account'] = tostring(properties.dataSourceName), ['Backup Triggered'] = triggered, ['Backup Completed'] = iff(finished, completed, datetime(null)), Duration = case(not(finished), '', minutes >= 60, strcat(minutes / 60, 'h', iff(minutes % 60 < 10, '0', ''), minutes % 60, 'm'), strcat(minutes, 'm')), Status = case(status in ('Completed', 'CompletedWithWarnings'), 'SUCCEEDED', status == 'InProgress', 'IN PROGRESS', status == 'Failed', 'FAILED', toupper(status))",
						"resultFormat": "table"
					},
					"datasource": {
						"type": "grafana-azure-monitor-datasource",
						"uid": "${DS_AZURE_MONITOR}"
					},
					"queryType": "Azure Resource Graph",
					"refId": "A",
					"subscriptions": [
						"${AZURE_SUBSCRIPTION_ID}"
					]
				}
			],
			"title": "Backups (Last 14 Days)",
			"transformations": [
				{
					"id": "convertFieldType",
					"options": {
						"conversions": [
							{
								"destinationType": "time",
								"targetField": "Backup Completed"
							},
							{
								"destinationType": "time",
								"targetField": "Backup Triggered"
							}
						],
						"fields": {
						}
					}
				}
			],
			"type": "table"
		}
	],
	"preload": false,
	"schemaVersion": 42,
	"tags": [
		"Backups",
		"Liferay"
	],
	"templating": {
		"list": [
			{
				"allowCustomValue": false,
				"current": {
					"text": "",
					"value": ""
				},
				"datasource": {
					"type": "prometheus",
					"uid": "${DS_PROMETHEUS}"
				},
				"definition": "label_values(kube_namespace_labels{label_liferay_com_observable=\"true\"},${NS_LABEL})",
				"label": "Environment",
				"name": "environment",
				"options": [
				],
				"query": {
					"qryType": 1,
					"query": "label_values(kube_namespace_labels{label_liferay_com_observable=\"true\"},${NS_LABEL})",
					"refId": "PrometheusVariableQueryEditor-VariableQuery"
				},
				"refresh": 1,
				"regex": "/(?<value>.*-(?<text>.*))/",
				"regexApplyTo": "value",
				"sort": 1,
				"type": "query"
			}
		]
	},
	"time": {
		"from": "now-7d",
		"to": "now"
	},
	"timepicker": {
	},
	"timezone": "browser",
	"title": "Backups",
	"uid": "backups",
	"version": 1,
	"weekStart": ""
}