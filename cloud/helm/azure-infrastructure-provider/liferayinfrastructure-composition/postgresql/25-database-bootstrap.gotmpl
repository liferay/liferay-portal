{{- $databaseAppRole := "liferay" -}}
{{- $entraAdministratorReady := false -}}

{{- range $condition := dig (printf "database-entra-administrator-%s" $activeDataPlane) "resource" "status" "conditions" list $observedResources -}}
    {{- if and (eq $condition.type "Ready") (eq $condition.status "True") -}}
        {{- $entraAdministratorReady = true -}}
    {{- end -}}
{{- end }}

{{- if and $activeDatabaseFqdn $entraAdministratorReady }}
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: database-bootstrap-service-account
    name: {{ $baseName }}-database-bootstrap-service-account
spec:
    forProvider:
        manifest:
            apiVersion: v1
            kind: ServiceAccount
            metadata:
                annotations:
                    azure.workload.identity/client-id: {{ dig "database-bootstrap-identity" "resource" "status" "atProvider" "clientId" "" $observedResources }}
                name: database-bootstrap
                namespace: {{ $namespace }}
    managementPolicies: {{ $managementPolicies }}
---
{{ include "database-bootstrap-job" (dict
    "baseName" $baseName
    "env" (list
        (dict "name" "DATABASE_NAME" "value" $databaseName)
        (dict "name" "LIFERAY_DATABASE_USERNAME" "value" $databaseAppRole)
        (dict "name" "LIFERAY_PASSWORD" "valueFrom" (dict "secretKeyRef" (dict "key" "DATABASE_PASSWORD" "name" "database-app-password")))
        (dict "name" "PGHOST" "value" $activeDatabaseFqdn)
        (dict "name" "PGPORT" "value" "5432")
        (dict "name" "PGSSLMODE" "value" "require")
        (dict "name" "PGUSER" "value" $bootstrapIdentityName))
    "image" "postgres:18-alpine"
    "isEntraTokenRequired" true
    "namespace" $namespace) }}
{{- end }}