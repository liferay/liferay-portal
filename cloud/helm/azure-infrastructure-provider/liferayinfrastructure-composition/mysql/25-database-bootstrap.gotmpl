{{- $databaseAppUser := "liferay" -}}

{{- if $activeDatabaseFqdn }}
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: database-bootstrap-job
    name: {{ $baseName }}-database-bootstrap-job
spec:
    forProvider:
        manifest:
            apiVersion: batch/v1
            kind: Job
            metadata:
                name: {{ $baseName }}-database-bootstrap
                namespace: {{ $namespace }}
            spec:
                template:
                    spec:
                        automountServiceAccountToken: false
                        containers:
                            -   args:
                                    -   |
                                            set -o errexit
                                            set -o nounset

                                            function main {
                                                _wait_for_server

                                                local liferay_password=$(printf '%s' "${LIFERAY_PASSWORD}" | sed -e 's/\\/\\\\/g' -e "s/'/''/g")

                                                MYSQL_PWD="${ADMIN_PASSWORD}" mysql \
                                                    --host "${MYSQL_HOST}" \
                                                    --ssl-mode REQUIRED \
                                                    --user "{{ $databaseAdminLogin }}" <<EOF
                                            CREATE USER IF NOT EXISTS '{{ $databaseAppUser }}'@'%' IDENTIFIED BY '${liferay_password}';

                                            ALTER USER '{{ $databaseAppUser }}'@'%' IDENTIFIED BY '${liferay_password}';

                                            GRANT ALL PRIVILEGES ON {{ $databaseName }}.* TO '{{ $databaseAppUser }}'@'%';
                                            EOF

                                                _verify_login
                                            }

                                            function _verify_login {
                                                local timeout=$(($(date +%s) + 600))

                                                until MYSQL_PWD="${LIFERAY_PASSWORD}" mysql \
                                                    --connect-timeout 10 \
                                                    --execute "SELECT 1" \
                                                    --host "${MYSQL_HOST}" \
                                                    --ssl-mode REQUIRED \
                                                    --user "{{ $databaseAppUser }}" \
                                                    "{{ $databaseName }}" >/dev/null 2>&1
                                                do
                                                    if [ $(date +%s) -ge ${timeout} ]
                                                    then
                                                        echo "{{ $databaseAppUser }} could not be authenticated" >&2

                                                        exit 1
                                                    fi

                                                    sleep 2
                                                done

                                                echo "{{ $databaseAppUser }} authenticated successfully"
                                            }

                                            function _wait_for_server {
                                                local timeout=$(($(date +%s) + 600))

                                                until MYSQL_PWD="${ADMIN_PASSWORD}" mysqladmin \
                                                    --connect-timeout 10 \
                                                    --host "${MYSQL_HOST}" \
                                                    --ssl-mode REQUIRED \
                                                    --user "{{ $databaseAdminLogin }}" \
                                                    ping
                                                do
                                                    if [ $(date +%s) -ge ${timeout} ]
                                                    then
                                                        echo "${MYSQL_HOST} did not become ready" >&2

                                                        exit 1
                                                    fi

                                                    sleep 2
                                                done
                                            }

                                            main
                                command:
                                    -   /bin/sh
                                    -   -c
                                env:
                                    -   name: ADMIN_PASSWORD
                                        valueFrom:
                                            secretKeyRef:
                                                key: password
                                                name: database-admin-password
                                    -   name: LIFERAY_PASSWORD
                                        valueFrom:
                                            secretKeyRef:
                                                key: DATABASE_PASSWORD
                                                name: database-app-password
                                    -   name: MYSQL_HOST
                                        value: {{ $activeDatabaseFqdn }}
                                image: mysql:{{ $databaseVersion }}
                                name: sql-runner
                                resources:
                                    limits:
                                        cpu: 200m
                                        memory: 256Mi
                                    requests:
                                        cpu: 100m
                                        memory: 128Mi
                                securityContext:
                                    allowPrivilegeEscalation: false
                                    capabilities:
                                        drop:
                                            -   ALL
                                    readOnlyRootFilesystem: true
                                    runAsNonRoot: true
                                    runAsUser: 1000
                                    seccompProfile:
                                        type: RuntimeDefault
                        restartPolicy: OnFailure
                        securityContext:
                            fsGroup: 1000
                            runAsNonRoot: true
                            seccompProfile:
                                type: RuntimeDefault
    managementPolicies: ["Create", "Observe", "Delete"]
    readiness:
        celQuery: object.status.succeeded == 1
        policy: DeriveFromCelQuery
{{- end }}