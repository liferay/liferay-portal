{{- $databaseAppUser := "liferay" -}}

{{- if $activeDatabaseFqdn }}
{{ include "database-bootstrap-job" (dict
    "baseName" $baseName
    "env" (list
        (dict "name" "ADMIN_PASSWORD" "valueFrom" (dict "secretKeyRef" (dict "key" "password" "name" "database-admin-password")))
        (dict "name" "DATABASE_ADMIN_USERNAME" "value" $databaseAdminLogin)
        (dict "name" "DATABASE_NAME" "value" $databaseName)
        (dict "name" "LIFERAY_DATABASE_USERNAME" "value" $databaseAppUser)
        (dict "name" "LIFERAY_PASSWORD" "valueFrom" (dict "secretKeyRef" (dict "key" "DATABASE_PASSWORD" "name" "database-app-password")))
        (dict "name" "MYSQL_HOST" "value" $activeDatabaseFqdn))
    "image" (printf "mysql:%s" $databaseVersion)
    "isEntraTokenRequired" false
    "namespace" $namespace) }}
{{- end }}