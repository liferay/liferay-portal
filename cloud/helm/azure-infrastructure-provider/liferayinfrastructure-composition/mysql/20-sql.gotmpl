{{- define "database-parameters" -}}
charset: utf8mb4
collation: utf8mb4_unicode_ci
resourceGroupName: {{ .env.resourceGroupName }}
serverNameSelector:
    matchControllerRef: true
    matchLabels:
        dataPlane: {{ .dataPlane }}
{{- end }}

{{- define "database-server-parameters" -}}
storage:
    autoGrowEnabled: true
    sizeGb: {{ .storageGB }}
{{- end }}