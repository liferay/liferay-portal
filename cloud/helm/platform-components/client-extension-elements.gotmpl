{{- $clientExtensionDefaults := get . "clientExtensionDefaults" }}
{{- if not (kindIs "map" $clientExtensionDefaults) }}
    {{- $clientExtensionDefaults = dict }}
{{- end }}
{{- $clientExtensions := get . "clientExtensions" }}
{{- $elements := list }}
{{- if kindIs "map" $clientExtensions }}
    {{- range $name, $clientExtension := $clientExtensions }}
        {{- if not (kindIs "map" $clientExtension) }}
            {{- continue }}
        {{- end }}
        {{- $merged := merge (deepCopy $clientExtension) (deepCopy $clientExtensionDefaults) }}
        {{- range $key, $value := $clientExtension }}
            {{- if not (kindIs "map" $value) }}
                {{- $_ := set $merged $key $value }}
            {{- end }}
        {{- end }}
        {{- $clientExtension = $merged }}
        {{- if eq (toString (get $clientExtension "enabled")) "false" }}
            {{- continue }}
        {{- end }}
        {{- if not (and (get $clientExtension "descriptor") (get $clientExtension "version")) }}
            {{- continue }}
        {{- end }}
        {{- $elements = append $elements (merge (dict "name" $name) $clientExtension) }}
    {{- end }}
{{- end }}
{{- toJson $elements }}