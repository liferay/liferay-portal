{{- $storage := $xr.spec.storage -}}

{{- range $i, $dataPlane := list "blue" "green" }}
{{- if $i }}
---
{{- end }}
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: Bucket
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: storage-{{ $dataPlane }}
    labels:
        app: liferay
        component: storage
        dataPlane: {{ $dataPlane }}
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $storageName }}-{{ $dataPlane }}
    namespace: {{ $namespace }}
spec:
    forProvider:
        forceDestroy: {{ $forceDestroy }}
        region: {{ $env.region }}
        tags:
            {{- with $storage.tags }}
            {{- . | toYaml | nindent 12 }}
            {{- end }}
            Active: {{ printf "%t" (eq $dataPlane $activeDataPlane) | quote }}
            Backup: "true"
            Name: {{ $storageName }}-{{ $dataPlane }}
    managementPolicies: {{ $managementPolicies }}
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketLifecycleConfiguration
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: storage-lifecycle-{{ $dataPlane }}
    labels:
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $storageName }}-lifecycle-{{ $dataPlane }}
spec:
    forProvider:
        bucketSelector:
            matchLabels:
                app: liferay
                component: storage
                dataPlane: {{ $dataPlane }}
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
        region: {{ $env.region }}
        rule:
            -   abortIncompleteMultipartUpload:
                    -   daysAfterInitiation: 7
                expiration:
                    -   expiredObjectDeleteMarker: true
                id: bucket-scoped-rule
                noncurrentVersionExpiration:
                    -   noncurrentDays: 7
                status: Enabled
    managementPolicies: {{ $managementPolicies }}
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketOwnershipControls
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: storage-ownership-controls-{{ $dataPlane }}
    labels:
        app: liferay
        component: storage
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $storageName }}-ownership-controls-{{ $dataPlane }}
    namespace: {{ $namespace }}
spec:
    forProvider:
        bucketSelector:
            matchLabels:
                app: liferay
                component: storage
                dataPlane: {{ $dataPlane }}
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
        region: {{ $env.region }}
        rule:
            objectOwnership: BucketOwnerPreferred
    managementPolicies: {{ $managementPolicies }}
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketPublicAccessBlock
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: storage-public-access-block-{{ $dataPlane }}
    labels:
        app: liferay
        component: storage
        dataPlane: {{ $dataPlane }}
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $storageName }}-public-access-block-{{ $dataPlane }}
spec:
    forProvider:
        blockPublicAcls: true
        blockPublicPolicy: true
        bucketSelector:
            matchLabels:
                app: liferay
                component: storage
                dataPlane: {{ $dataPlane }}
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
        ignorePublicAcls: true
        region: {{ $env.region }}
        restrictPublicBuckets: true
    managementPolicies: {{ $managementPolicies }}
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketVersioning
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: storage-versioning-{{ $dataPlane }}
    labels:
        app: liferay
        component: storage
        dataPlane: {{ $dataPlane }}
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $storageName }}-versioning-{{ $dataPlane }}
    namespace: {{ $namespace }}
spec:
    forProvider:
        bucketSelector:
            matchLabels:
                app: liferay
                component: storage
                dataPlane: {{ $dataPlane }}
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
            namespace: {{ $namespace }}
        region: {{ $env.region }}
        versioningConfiguration:
            status: Enabled
    managementPolicies: {{ $managementPolicies }}
{{- end }}