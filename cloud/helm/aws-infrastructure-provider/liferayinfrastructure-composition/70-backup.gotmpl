{{- if $backup.enabled }}
{{- $daysOfWeek := dict "Friday" "FRI" "Monday" "MON" "Saturday" "SAT" "Sunday" "SUN" "Thursday" "THU" "Tuesday" "TUE" "Wednesday" "WED" -}}
{{- $timeOfDay := splitList ":" $backup.timeOfDay -}}

{{- $backupSchedule := printf "cron(%s %s * * ? *)" (index $timeOfDay 1) (index $timeOfDay 0) -}}

{{- if eq $backup.frequency "Weekly" -}}
    {{- $backupSchedule = printf "cron(%s %s ? * %s *)" (index $timeOfDay 1) (index $timeOfDay 0) (index $daysOfWeek $backup.dayOfWeek) -}}
{{- end }}
apiVersion: backup.aws.m.upbound.io/v1beta1
kind: Plan
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: backup-plan
    labels:
        app: liferay
        component: backup-plan
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $baseName }}-backup-plan
spec:
    forProvider:
        name: {{ $baseName }}-backup-plan
        region: {{ $env.region }}
        rule:
            -   lifecycle:
                    deleteAfter: {{ $backup.retentionDays }}
                ruleName: scheduled-backups
                schedule: {{ $backupSchedule | quote }}
                scheduleExpressionTimezone: {{ $backup.timeZone | quote }}
                startWindow: 60
                targetVaultName: {{ $baseName }}-backup-vault
    managementPolicies: {{ $managementPolicies }}
---
apiVersion: backup.aws.m.upbound.io/v1beta1
kind: Selection
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: by-tags-selection
    labels:
        app: liferay
        component: backup-selection
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $baseName }}-by-tags-selection
spec:
    forProvider:
        condition:
            -   stringEquals:
                -   key: aws:ResourceTag/Active
                    value: "true"
                -   key: aws:ResourceTag/Backup
                    value: "true"
                -   key: aws:ResourceTag/DeploymentName
                    value: {{ $env.deploymentName }}
                -   key: aws:ResourceTag/EnvironmentId
                    value: {{ $environmentId }}
                -   key: aws:ResourceTag/ProjectId
                    value: {{ $projectId }}
        iamRoleArnSelector:
            matchLabels:
                app: liferay
                component: backup-service-role
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
        name: {{ $baseName }}-by-tags-selection
        planIdSelector:
            matchLabels:
                app: liferay
                component: backup-plan
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
        region: {{ $env.region }}
        resources: ["*"]
    managementPolicies: {{ $managementPolicies }}
---
apiVersion: backup.aws.m.upbound.io/v1beta1
kind: Vault
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: backup-vault
    labels:
        app: liferay
        component: backup-vault
        environmentId: {{ $environmentId }}
        projectId: {{ $projectId }}
    name: {{ $baseName }}-backup-vault
spec:
    forProvider:
        forceDestroy: {{ $forceDestroy }}
        {{- if $cmkEnabled }}
        kmsKeyArnSelector:
            matchLabels:
                app: liferay
                component: backup-vault
                environmentId: {{ $environmentId }}
                projectId: {{ $projectId }}
        {{- end }}
        region: {{ $env.region }}
        {{- with $backup.vaultTags }}
        tags:
            {{- . | toYaml | nindent 12 }}
        {{- end }}
    managementPolicies: {{ $managementPolicies }}
{{- end }}