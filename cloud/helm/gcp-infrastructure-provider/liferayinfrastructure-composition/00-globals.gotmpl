{{- $databaseName := "lportal" -}}
{{- $env := index .context "apiextensions.crossplane.io/environment" -}}
{{- $observedResources := .observed.resources | default dict -}}
{{- $xr := .observed.composite.resource -}}

{{- if eq $xr.spec.search.engine "opensearch" -}}
{{- fail "GCP has no managed OpenSearch, so \"search.engine\" must be \"elasticsearch\"" -}}
{{- end -}}

{{- $cmkEnabled := $xr.spec.cmk.enabled -}}
{{- $environmentId := $xr.spec.environmentId -}}
{{- $forceDestroy := $xr.spec.forceDestroy -}}
{{- $gsaName := printf "%s-sa" $xr.metadata.name -}}
{{- $managementPolicies := $xr.spec.orphanOnDelete | ternary (list "Create" "Observe" "Update") (list "*") | toJson -}}
{{- $namespace := $xr.metadata.namespace -}}
{{- $overlayAccess := $xr.spec.overlayAccess -}}
{{- $projectId := $xr.spec.projectId -}}
{{- $region := $env.region -}}
{{- $restorePhase := $xr.spec.restorePhase -}}
{{- $targetActiveDataPlane := $xr.spec.targetActiveDataPlane -}}

{{- $activeDataPlane := $targetActiveDataPlane -}}
{{- $databaseIamUser := printf "%s@%s.iam" $gsaName $env.projectId -}}
{{- $dataPlanes := list $targetActiveDataPlane -}}
{{- $gsaEmail := printf "%s@%s.iam.gserviceaccount.com" $gsaName $env.projectId -}}
{{- $labels := merge (dict "app" "liferay" "deployment-name" $env.deploymentName "environment-id" $environmentId "project-id" $projectId) $xr.spec.commonTags -}}
{{- $overlayBucketName := printf "%s-overlay-%s" $env.deploymentName (printf "%.18s-%s" $projectId (printf "%s-%s-%s" $env.projectId $env.deploymentName $projectId | sha256sum | trunc 6)) -}}
{{- $projectIdFull := printf "%s-%s" $projectId $environmentId -}}

{{- if (eq $restorePhase "promoting") -}}
    {{- $dataPlanes = list "blue" "green" -}}
{{- else if or (eq $restorePhase "provisioning") (eq $restorePhase "provisioning-database-user") -}}
    {{- $activeDataPlane = (eq $targetActiveDataPlane "blue") | ternary "green" "blue" -}}
    {{- $dataPlanes = list "blue" "green" -}}
{{- end }}

{{- $backupTargetLabels := merge (dict "should-back-up" "true") $labels -}}
{{- $baseName := printf "%.18s-%s" $projectIdFull (printf "%s-%s" $env.projectNumber $projectIdFull | sha256sum | trunc 6) -}}

{{- $cmkKeyName := printf "projects/%s/locations/%s/keyRings/%s-keyring/cryptoKeys/%s-key" $env.projectId $region $baseName $baseName -}}