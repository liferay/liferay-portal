{{- $databaseName := "lportal" -}}
{{- $env := index .context "apiextensions.crossplane.io/environment" -}}
{{- $observedResources := .observed.resources | default dict -}}
{{- $xr := .observed.composite.resource -}}

{{- if eq $xr.spec.search.engine "opensearch" -}}
{{- fail "GCP has no managed OpenSearch, so \"search.engine\" must be \"elasticsearch\"" -}}
{{- end -}}

{{- if $xr.spec.database.restore -}}
{{- fail "GCP restores through the backup-restore workflow, so \"database.restore\" must be unset" -}}
{{- end -}}

{{- $cmkEnabled := $xr.spec.cmk.enabled -}}
{{- $cmkKeyId := dig "liferay-cryptokey" "resource" "status" "atProvider" "id" "" $observedResources -}}
{{- $databaseBootstrapEmail := dig "database-bootstrap-gsa" "resource" "status" "atProvider" "email" "" $observedResources -}}
{{- $databaseBootstrapMember := dig "database-bootstrap-gsa" "resource" "status" "atProvider" "member" "" $observedResources -}}
{{- $databaseInstanceNamePrefix := printf "%s-db-instance-" $xr.metadata.name -}}
{{- $environmentId := $xr.spec.environmentId -}}
{{- $forceDestroy := $xr.spec.forceDestroy -}}
{{- $gsaEmail := dig "liferay-gsa" "resource" "status" "atProvider" "email" "" $observedResources -}}
{{- $gsaMember := dig "liferay-gsa" "resource" "status" "atProvider" "member" "" $observedResources -}}
{{- $managementPolicies := $xr.spec.orphanOnDelete | ternary (list "Create" "Observe" "Update") (list "*") | toJson -}}
{{- $namespace := $xr.metadata.namespace -}}
{{- $overlayAccess := $xr.spec.overlayAccess -}}
{{- $projectId := $xr.spec.projectId -}}
{{- $region := $env.region -}}
{{- $restorePhase := $xr.spec.restorePhase -}}
{{- $targetActiveDataPlane := $xr.spec.targetActiveDataPlane -}}

{{- $activeDataPlane := $targetActiveDataPlane -}}
{{- $databaseBootstrapIamUser := get (dict "mysql" (splitList "@" $databaseBootstrapEmail | first) "postgresql" (trimSuffix ".gserviceaccount.com" $databaseBootstrapEmail)) $env.databaseEngine -}}
{{- $databaseCharset := get (dict "mysql" "utf8mb4" "postgresql" "UTF8") $env.databaseEngine -}}
{{- $databaseClientEnv := get (dict "mysql" (list) "postgresql" (list (dict "name" "PGPASSWORD" "value" "iam"))) $env.databaseEngine -}}
{{- $databaseClientImage := get (dict "mysql" "mysql:8.4" "postgresql" "postgres:18-alpine") $env.databaseEngine -}}
{{- $databaseCollation := get (dict "mysql" "utf8mb4_unicode_ci" "postgresql" "en_US.UTF8") $env.databaseEngine -}}
{{- $databaseIamAuthenticationFlagName := get (dict "mysql" "cloudsql_iam_authentication" "postgresql" "cloudsql.iam_authentication") $env.databaseEngine -}}
{{- $databaseIamUser := get (dict "mysql" (splitList "@" $gsaEmail | first) "postgresql" (trimSuffix ".gserviceaccount.com" $gsaEmail)) $env.databaseEngine -}}
{{- $databasePointInTimeRecoveryFieldName := get (dict "mysql" "binaryLogEnabled" "postgresql" "pointInTimeRecoveryEnabled") $env.databaseEngine -}}
{{- $databasePort := get (dict "mysql" "3306" "postgresql" "5432") $env.databaseEngine -}}
{{- $databaseVersion := get (dict "mysql" (printf "MYSQL_%s" ($xr.spec.database.version | default "8.4" | replace "." "_")) "postgresql" (printf "POSTGRES_%s" ($xr.spec.database.version | default "18"))) $env.databaseEngine -}}
{{- $dataPlanes := list $targetActiveDataPlane -}}
{{- $isCMKKeyReady := or (not $cmkEnabled) $cmkKeyId -}}
{{- $labels := merge (dict "app" "liferay" "deployment-name" $env.deploymentName "environment-id" $environmentId "project-id" $projectId) $xr.spec.commonTags -}}
{{- $overlayBucketName := printf "%s-overlay-%s" $env.deploymentName (printf "%.18s-%s" $projectId (printf "%s-%s-%s" $env.projectId $env.deploymentName $projectId | sha256sum | trunc 6)) -}}
{{- $projectIdFull := printf "%s-%s" $projectId $environmentId -}}

{{- if (eq $restorePhase "promoting") -}}
    {{- $dataPlanes = list "blue" "green" -}}
{{- else if or (eq $restorePhase "provisioning") (eq $restorePhase "provisioning-database-user") -}}
    {{- $activeDataPlane = (eq $targetActiveDataPlane "blue") | ternary "green" "blue" -}}
    {{- $dataPlanes = list "blue" "green" -}}
{{- end }}

{{- $backupTargetLabels := merge (dict "should-back-up" "true") $labels -}}
{{- $baseName := printf "%.18s-%s" $projectIdFull (printf "%s-%s" $env.projectNumber $projectIdFull | sha256sum | trunc 6) -}}
{{- $databaseBootstrapIamUserExternalName := get (dict "mysql" $databaseBootstrapEmail "postgresql" $databaseBootstrapIamUser) $env.databaseEngine -}}
{{- $databaseIamUserExternalName := get (dict "mysql" $gsaEmail "postgresql" $databaseIamUser) $env.databaseEngine -}}