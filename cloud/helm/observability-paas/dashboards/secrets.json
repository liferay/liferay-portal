					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "avg by (secret, label_sme_user_create, label_sme_created_at, label_sme_updated_at, label_sme_user_update) (last_over_time(kube_secret_labels{label_sme_managed=\"true\", namespace=\"$environment\", cluster=~\"${CLUSTER}\"}[$__range]))",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "A"
				}
			],
			"title": "Secrets",
			"transformations": [
				{
					"id": "convertFieldType",
					"options": {
						"conversions": [
							{
								"destinationType": "number",
								"targetField": "label_sme_created_at"
							},
							{
								"destinationType": "number",
								"targetField": "label_sme_updated_at"
							}
						],
						"fields": {
						}
					}
				},
				{
					"id": "calculateField",
					"options": {
						"alias": "Created At",
						"binary": {
							"left": {
								"matcher": {
									"id": "byName",
									"options": "label_sme_created_at"
								}
							},
							"operator": "*",
							"right": {
								"fixed": "1000"
							}
						},
						"mode": "binary",
						"reduce": {
							"reducer": "sum"
						},
						"replaceFields": false
					}
				},
				{
					"id": "calculateField",
					"options": {
						"alias": "Updated At",
						"binary": {
							"left": {
								"matcher": {
									"id": "byName",
									"options": "label_sme_updated_at"
								}
							},
							"operator": "*",
							"right": {
								"fixed": "1000"
							}
						},
						"mode": "binary",
						"reduce": {
							"reducer": "sum"
						}
					}
				},
				{
					"id": "organize",
					"options": {
						"excludeByName": {
							"Time": true,
							"Time 1": true,
							"Time 2": true,
							"Value": true,
							"label_sme_created_at": true,
							"label_sme_updated_at": true
						},
						"includeByName": {
						},
						"indexByName": {
							"Created At": 2,
							"Time": 8,
							"Updated At": 4,
							"Value": 7,
							"label_sme_created_at": 5,
							"label_sme_updated_at": 6,
							"label_sme_user_create": 1,
							"label_sme_user_update": 3,
							"secret": 0
						},
						"renameByName": {
							"Value #A": "Created",
							"Value #B": "Updated",
							"label_sme_created_at": "Created At",
							"label_sme_updated_at": "Updated At",
							"label_sme_user_create": "Created By",
							"label_sme_user_update": "Updated By",
							"secret": "Name"
						}
					}
				}
			],
			"transparent": true,
			"type": "table"
		}
