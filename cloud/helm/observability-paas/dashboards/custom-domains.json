			"pluginVersion": "12.4.2",
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "sum by (hostname) (\n  last_over_time(kube_customresource_httproute_info{cluster=~\"${CLUSTER}\"}[1h])\n  and on (namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\", cluster=~\"${CLUSTER}\"}[1h])\n)",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "A"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "group by (hostname, condition) (\n  (\n    last_over_time(kube_customresource_certificate_dnsname_info{cluster=~\"${CLUSTER}\"}[1h])\n    and on (namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\", cluster=~\"${CLUSTER}\"}[1h])\n  )\n  * on (name, namespace) group_left(condition)\n  (label_replace(last_over_time(certmanager_certificate_ready_status{cluster=~\"${CLUSTER}\"}[1h]), \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\") > 0)\n)",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "B"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "sum by (hostname) (\n  (\n    last_over_time(kube_customresource_certificate_dnsname_info{cluster=~\"${CLUSTER}\"}[1h])\n    and on (namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\", cluster=~\"${CLUSTER}\"}[1h])\n  )\n  * on (name, namespace) group_left\n  label_replace(last_over_time(certmanager_certificate_expiration_timestamp_seconds{cluster=~\"${CLUSTER}\"}[1h]), \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\")\n) * 1000",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "C"
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${DS_PROMETHEUS}"
					},
					"editorMode": "code",
					"exemplar": false,
					"expr": "group by (hostname, reason) (\n  label_replace(\n    label_replace(last_over_time(certmanager_certificate_challenge_status{cluster=~\"${CLUSTER}\"}[1h]) == 1, \"namespace\", \"$1\", \"exported_namespace\", \"(.+)\"),\n    \"hostname\", \"$1\", \"domain\", \"(.+)\"\n  )\n  and on (namespace, hostname) (\n    last_over_time(kube_customresource_certificate_dnsname_info{cluster=~\"${CLUSTER}\", hostname!~\".+\\\\.${dns_zone}\"}[1h])\n    and on (namespace) last_over_time(kube_namespace_labels{label_environment_id=\"$environment\", cluster=~\"${CLUSTER}\"}[1h])\n  )\n)",
					"format": "table",
					"instant": true,
					"legendFormat": "__auto",
					"range": false,
					"refId": "D"
				}
			],
			"title": "Custom Domains",
			"transformations": [
