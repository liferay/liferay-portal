              >
                <use
                  href="#times"
                />
              </svg>
            </button>
          </div>
          <form
            class="form-root"
          >
            <div
              class="modal-body"
            >
              <p
                class="text-secondary"
              >
                New requests will be added to the queue and you will be notified once the job has completed running.
              </p>
              <div
                class="form-group"
              >
                <div
                  class="h4"
                >
                  Job Type
                </div>
                <div
                  class="form-group-item ml-2"
                >
                  <span
                    hidden=""
                  />
                  <div
                    class="custom-control custom-checkbox"
                  >
                    <label>
                      <input
                        class="custom-control-input"
                        form="[object Object]"
                        name="accessRequest"
                        type="checkbox"
                        value="false"
                      />
                      <span
                        class="custom-control-label"
                      >
                        <span
                          class="custom-control-label-text"
                        >
                          <span>
                            Access
                            <span
                              class="font-weight-normal text-secondary"
