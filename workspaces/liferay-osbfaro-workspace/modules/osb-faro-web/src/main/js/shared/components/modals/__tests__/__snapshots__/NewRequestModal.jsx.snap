exports[`NewRequestModal renders 1`] = `
<body
  class="dxp modal-open"
>
  <div
    aria-hidden="true"
    data-suppressed="true"
  />
  <div>
    <div
      aria-hidden="true"
      class="modal-backdrop fade show"
      data-suppressed="true"
    />
    <div
      class="fade modal d-block show"
    >
      <div
        class="modal-dialog"
      >
        <div
          aria-labelledby="clay-modal-label-1"
