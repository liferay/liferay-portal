                               - Creates downloadable file of all the data collected related to a user.
                            </span>
                          </span>
                        </span>
                      </span>
                    </label>
                  </div>
                </div>
                <div
                  class="form-group-item ml-2"
                >
                  <div
                    class="custom-control custom-checkbox"
                  >
                    <label>
                      <input
                        class="custom-control-input"
                        form="[object Object]"
                        name="deleteRequest"
                        type="checkbox"
                        value="false"
                      />
                      <span
                        class="custom-control-label"
                      >
                        <span
                          class="custom-control-label-text"
                        >
                          <span>
                            Delete
                            <span
                              class="font-weight-normal text-secondary"
                            >
                               - Delete user's PII and add them to the suppression list.
                            </span>
                          </span>
                        </span>
                      </span>
                    </label>
                  </div>
                </div>
                <div
                  class="form-group-item ml-2"
                >
                  <div
                    class="custom-control custom-checkbox"
                  >
                    <label>
                      <input
                        class="custom-control-input"
                        form="[object Object]"
                        name="suppressRequest"
                        type="checkbox"
                        value="false"
                      />
                      <span
                        class="custom-control-label"
                      >
                        <span
                          class="custom-control-label-text"
                        >
                          <span>
                            Suppress
                            <span
                              class="font-weight-normal text-secondary"
                            >
                               - Suppress identity resolution of users based on their email.
                            </span>
                          </span>
                        </span>
                      </span>
                    </label>
                  </div>
                </div>
              </div>
              <div
                class="form-group"
              >
                <div
