              <div
                class="panel-body p-4"
              >
                <div>
                  <div
                    class="mb-2"
                  >
                    <span
                      class="text-4 text-secondary"
                    >
                      To configure your Marketo data source, go to your Marketo environment to update this app connection.
                    </span>
