                          <p
                            class="list-group-text"
                          >
                            Represents fields from the Leads and Companies table within Marketo.
                          </p>
                          <p
                            class="list-group-text"
                          >
                            20 Items Synced
                          </p>
                        </div>
                        <div
                          class="justify-content-center autofit-col"
                        >
                          <span
                            class="label label-success"
                          >
