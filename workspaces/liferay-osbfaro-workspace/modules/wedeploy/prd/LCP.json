{
	"cpu": 8,
	"dependencies": [
		"database",
		"search"
	],
	"env": {
		"FARO_URL": "https://ldp.liferay.com",
		"ISSUES_EMAIL_ADDRESS": "ac-issues-trial@liferay.com",
		"LCP_PROJECT_LIFERAY_CLUSTER_ENABLED": "true",
		"OSB_API_PORT": 443,
		"OSB_API_PROTOCOL": "https",
		"OSB_API_URL": "koroneiki.liferay.com",
		"OSB_ASAH_BACKEND_URL": "https://osbasahbackend-{weDeployKey}",
		"OSB_ASAH_PUBLISHER_URL": "https://osbasahpublisher-{weDeployKey}"
	},
	"environments": {
		"infra": {
			"deploy": false
		}
	},
	"id": "liferay",
	"image": "liferaycloud/liferay-dxp:7.4-5.2.1",
	"kind": "Deployment",
	"livenessProbe": {
		"failureThreshold": 3,
		"initialDelaySeconds": 300,
		"periodSeconds": 60,
		"successThreshold": 1,
		"tcpSocket": {
			"port": 8080
		}
	},
	"memory": 8192,
	"ports": [
		{
			"external": false,
			"port": 8080
		}
	],
	"readinessProbe": {
		"failureThreshold": 3,
		"httpGet": {
			"path": "/c/portal/layout",
			"port": 8080
		},
		"initialDelaySeconds": 120,
		"periodSeconds": 15,
		"successThreshold": 3
	},
	"volumes": {
		"data": "/opt/liferay/data"
	}
}