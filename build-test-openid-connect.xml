<?xml version="1.0"?>

<project basedir="." name="portal-test-openid-connect" xmlns:antelope="antlib:ise.antelope.tasks">
	<import file="build-test.xml" />

	<target name="deploy-openid-connect-osgi-configuration">
		<fail message="Please set osgi.config.file.name." unless="osgi.config.file.name" />

		<condition else="" property="discovery.endpoint" value="${discovery.endpoint}">
			<isset property="discovery.endpoint" />
		</condition>

		<condition else="" property="open.id.connect.client.id" value="${open.id.connect.client.id}">
			<isset property="open.id.connect.client.id" />
		</condition>

		<condition else="" property="open.id.connect.client.secret" value="${open.id.connect.client.secret}">
			<isset property="open.id.connect.client.secret" />
		</condition>

		<condition else="" property="provider.name" value="${provider.name}">
			<isset property="provider.name" />
		</condition>

		<echo file="${liferay.home}/osgi/configs/${osgi.config.file.name}">authorizationEndpoint=""
discoveryEndpoint="${discovery.endpoint}"
discoveryEndpointCacheInMillis=L"360000"
idTokenSigningAlgValues=["RS256"]
issuerURL=""
jwksURI=""
openIdConnectClientId="${open.id.connect.client.id}"
openIdConnectClientSecret="${open.id.connect.client.secret}"
providerName="${provider.name}"
registeredIdTokenSigningAlg=""
scopes="openid email profile"
subjectTypes=[""]
tokenConnectionTimeout=I"1000"
tokenEndpoint=""
userInfoEndpoint=""</echo>
	</target>

	<target name="prepare-openid-connect-json-configuration">
		<property name="osgi.dependency.dir" value="${project.dir}/portal-web/test/functional/com/liferay/portalweb/tests/coreinfrastructure/security/openidconnect/dependencies" />

		<copy
			file="${osgi.dependency.dir}/${osgi.config.file.name}"
			todir="${liferay.home}"
		/>

		<replace
			file="${liferay.home}/${osgi.config.file.name}"
			token="&quot;client_secret&quot;: &quot;&quot;"
			value="&quot;client_secret&quot;: &quot;${openIdConnectClientSecret}&quot;"
		/>

		<move
			file="${liferay.home}/${osgi.config.file.name}"
			todir="${osgi.dependency.dir}"
		/>
	</target>

	<target name="prepare-openid-connect-osgi-configuration">
		<property name="osgi.dependency.dir" value="${project.dir}/portal-web/test/functional/com/liferay/portalweb/tests/coreinfrastructure/security/openidconnect/dependencies" />

		<copy
			file="${osgi.dependency.dir}/${osgi.config.file.name}"
			todir="${liferay.home}"
		/>

		<replace
			file="${liferay.home}/${osgi.config.file.name}"
			token="openIdConnectClientId=&quot;&quot;"
			value="openIdConnectClientId=&quot;${openIdConnectClientId}&quot;"
		/>

		<replace
			file="${liferay.home}/${osgi.config.file.name}"
			token="openIdConnectClientSecret=&quot;&quot;"
			value="openIdConnectClientSecret=&quot;${openIdConnectClientSecret}&quot;"
		/>

		<move
			file="${liferay.home}/${osgi.config.file.name}"
			todir="${liferay.home}/osgi/configs"
		/>
	</target>
</project>